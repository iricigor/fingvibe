<Window x:Class="Ex220Inspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="EX220 local client inspector" Width="1280" Height="900"
        MinWidth="960" MinHeight="680" FontFamily="Segoe UI" FontSize="14"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="EX220 client inspector" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Sign in, then Capture all to visit every client table and page. Optional FingVibe comparison opens SQLite read-only; nothing is imported or saved." />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#808080" BorderThickness="1">
            <wv:WebView2 x:Name="Browser" />
        </Border>
        <Border x:Name="LoginPanel" Grid.Row="1" Panel.ZIndex="1" Width="360"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="16"
                MaxHeight="{Binding ActualHeight, ElementName=Browser}"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Sign in to EX220" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="LoginMessage" Margin="0,8,0,8" TextWrapping="Wrap"
                           Text="The router is logged out. Enter its local password." />
                <Label Content="_Password" Target="{Binding ElementName=LoginPassword}" Padding="0,0,0,4" />
                <PasswordBox x:Name="LoginPassword" KeyDown="LoginPassword_KeyDown"
                             AutomationProperties.Name="Router password" Padding="6" />
                <CheckBox x:Name="RememberPassword" Margin="0,10,0,10" IsChecked="True"
                          Checked="RememberPassword_Changed" Unchecked="RememberPassword_Changed"
                          Content="Remember only until this inspector closes" />
                <WrapPanel>
                    <Button x:Name="SignInButton" Content="Sign in" Click="SignIn_Click"
                            Padding="12,5" Margin="0,0,8,0" />
                    <Button Content="Use router page" Click="DismissLogin_Click" Padding="12,5" />
                </WrapPanel>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                           Text="No password is saved to disk or online. HTTP login is not transport-encrypted." />
            </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,8">
            <WrapPanel>
                <ComboBox x:Name="SourcePicker" SelectedIndex="0" Width="440" Margin="0,0,8,8"
                          AutomationProperties.Name="Router table source">
                    <ComboBoxItem Content="Client List (Advanced / Network / LAN Settings)" />
                    <ComboBoxItem Content="Wired Clients (Basic / Network Map / Wired Clients)" />
                    <ComboBoxItem Content="ARP List (Advanced / Security / IP and MAC Binding)" />
                </ComboBox>
                <Button x:Name="CaptureButton" Content="Capture visible table" Click="Capture_Click"
                        IsEnabled="False" Padding="12,5" Margin="0,0,8,8" />
                <Button x:Name="CaptureAllButton" Content="Capture all" Click="CaptureAll_Click"
                        IsEnabled="False" Padding="12,5" Margin="0,0,8,8" />
                <Button x:Name="CancelCaptureButton" Content="Cancel" Click="CancelCapture_Click"
                        IsEnabled="False" Padding="12,5" Margin="0,0,8,8" />
                <Button x:Name="ClearButton" Content="Clear captures" Click="Clear_Click" Padding="12,5" Margin="0,0,8,8" />
                <Button x:Name="LoginEntryButton" Content="Sign in..." Click="ShowLogin_Click" Padding="12,5" Margin="0,0,8,8" />
                <Button Content="Password..." Click="PasswordPanel_Click" Padding="12,5" Margin="0,0,8,8" />
                <Button Content="Forget password" Click="ForgetPassword_Click" Padding="12,5" Margin="0,0,8,8" />
                <Button x:Name="RefreshButton" Content="Forced refresh" Click="ForcedRefresh_Click"
                        Padding="12,5" Margin="0,0,8,8" IsEnabled="False"
                        ToolTip="Stop pending work and reopen the router start page without cached resources. Captures and remembered password are kept." />
            </WrapPanel>
            <CheckBox x:Name="WiredComplete" Content="I have captured every page of the Wired Clients list"
                      Checked="WiredComplete_Changed" Unchecked="WiredComplete_Changed" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Tables are matched by section title. Captures accumulate by MAC. Wireless requires a complete Wired Clients list; ARP-only entries remain Unknown." />
            <TextBlock x:Name="CaptureSummary" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Client List: not captured | Wired Clients: not captured | ARP: not captured" />
            <Expander Header="FingVibe database (read-only)" Margin="0,6,0,0">
                <StackPanel Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DatabasePathInput" AutomationProperties.Name="FingVibe SQLite database"
                                 TextChanged="DatabasePath_Changed" Padding="6" />
                        <Button Grid.Column="1" Content="Browse..." Click="BrowseDatabase_Click" Margin="8,0,0,0" Padding="12,5" />
                        <Button Grid.Column="2" Content="Load DB" Click="LoadDatabase_Click" Margin="8,0,0,0" Padding="12,5" />
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <ComboBox x:Name="DatabaseNetworkPicker" Width="500" DisplayMemberPath="Label"
                                  SelectionChanged="DatabaseNetwork_Changed" AutomationProperties.Name="Saved network and subnet" />
                        <Button Content="Compare" Click="CompareDatabase_Click" Margin="8,0,0,0" Padding="12,5" />
                    </WrapPanel>
                </StackPanel>
            </Expander>
            <TextBlock x:Name="DatabaseStatus" Text="DB not loaded." Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <DataGrid x:Name="ClientsGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  AutomationProperties.Name="Captured router clients">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="160" />
                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="130" />
                <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="110" />
                <DataGridTextColumn Header="DB comparison" Binding="{Binding DbComparison}" Width="150" />
                <DataGridTextColumn Header="DB name" Binding="{Binding DbName}" Width="180" />
                <DataGridTextColumn Header="DB IP" Binding="{Binding DbIp}" Width="130" />
                <DataGridTextColumn Header="DB details" Binding="{Binding DbDetails}" Width="220" />
                <DataGridTextColumn Header="Sources" Binding="{Binding Sources}" Width="180" />
                <DataGridTextColumn Header="ARP comparison" Binding="{Binding ArpComparison}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="Status" Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Text="Starting isolated browser..." />
    </Grid>
</Window>
