<Application
    x:Class="FingVibe.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///CardHeadingResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ScannerNavigationDividerBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F0F2F5" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E5E8ED" />
                    <SolidColorBrush x:Key="ScannerPageBackgroundBrush" Color="#F6F7F9" />
                    <SolidColorBrush x:Key="ScannerHeaderBackgroundBrush" Color="#ECEFF3" />
                    <SolidColorBrush x:Key="ScannerCardBorderBrush" Color="#D5DAE2" />
                    <SolidColorBrush x:Key="ScannerMacOuiBrush" Color="#075985" />
                    <SolidColorBrush x:Key="ScannerMacNicBrush" Color="#6B21A8" />
                    <SolidColorBrush x:Key="ScannerOnlineBackgroundBrush" Color="#DCFCE7" />
                    <SolidColorBrush x:Key="ScannerOnlineForegroundBrush" Color="#166534" />
                    <SolidColorBrush x:Key="ScannerOfflineBackgroundBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="ScannerOfflineForegroundBrush" Color="#475569" />
                    <SolidColorBrush x:Key="ScannerImportedBackgroundBrush" Color="#22D49A28" />
                    <SolidColorBrush x:Key="ScannerImportedForegroundBrush" Color="#785214" />
                    <SolidColorBrush x:Key="ScannerPossibleMatchBrush" Color="#8A5A00" />
                    <SolidColorBrush x:Key="ScannerLinkedDeviceBrush" Color="#0E6B0E" />
                    <SolidColorBrush x:Key="ScannerNoMatchBrush" Color="#6B6B6B" />
                    <SolidColorBrush x:Key="PeopleRoomsBadgeBackgroundBrush" Color="#DEEAFE" />
                    <SolidColorBrush x:Key="PeopleRoomsBadgeForegroundBrush" Color="#1D4ED8" />
                    <Color x:Key="SpeedGaugeSlowColor">#D92D20</Color>
                    <Color x:Key="SpeedGaugeFairColor">#E0A100</Color>
                    <Color x:Key="SpeedGaugeGoodColor">#16A34A</Color>
                    <SolidColorBrush x:Key="SpeedRatingSlowBrush" Color="#B42318" />
                    <SolidColorBrush x:Key="SpeedRatingFairBrush" Color="#8A5300" />
                    <SolidColorBrush x:Key="SpeedRatingGoodBrush" Color="#0E6B0E" />
                    <SolidColorBrush x:Key="PageHeaderTabTrackBackgroundBrush" Color="#ECEEF2" />
                    <SolidColorBrush x:Key="PageHeaderTabTrackBorderBrush" Color="#DDE1E7" />
                    <SolidColorBrush x:Key="PageHeaderTabForegroundBrush" Color="#9E000000" />
                    <SolidColorBrush x:Key="PageHeaderTabForegroundPointerOverBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="PageHeaderTabForegroundPressedBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="PageHeaderTabBackgroundPointerOverBrush" Color="#09000000" />
                    <SolidColorBrush x:Key="PageHeaderTabBackgroundPressedBrush" Color="#06000000" />
                    <SolidColorBrush x:Key="PageHeaderTabBorderPointerOverBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedBackgroundPointerOverBrush" Color="#F9FAFB" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedBackgroundPressedBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedForegroundBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="PageHeaderTabPillBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <!-- The raised surface's soft shadow: Fluent's elevation border, darker along the bottom edge. -->
                    <LinearGradientBrush x:Key="PageHeaderTabSelectedBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
                        <LinearGradientBrush.RelativeTransform>
                            <ScaleTransform ScaleY="-1" CenterY="0.5" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Offset="0.33" Color="#33000000" />
                        <GradientStop Offset="1.0" Color="#14000000" />
                    </LinearGradientBrush>
                    <Style x:Key="PageHeaderColorIconStyle" TargetType="Image">
                        <Setter Property="Visibility" Value="Visible" />
                    </Style>
                    <Style x:Key="PageHeaderMonochromeIconStyle" TargetType="BitmapIcon">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ScannerNavigationDividerBrush" Color="#0EFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1B1E24" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#292D35" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#343944" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#20242B" />
                    <SolidColorBrush x:Key="ScannerPageBackgroundBrush" Color="#111318" />
                    <SolidColorBrush x:Key="ScannerHeaderBackgroundBrush" Color="#20242B" />
                    <SolidColorBrush x:Key="ScannerCardBorderBrush" Color="#3A414B" />
                    <SolidColorBrush x:Key="ScannerMacOuiBrush" Color="#7DD3FC" />
                    <SolidColorBrush x:Key="ScannerMacNicBrush" Color="#D8B4FE" />
                    <SolidColorBrush x:Key="ScannerOnlineBackgroundBrush" Color="#143A2A" />
                    <SolidColorBrush x:Key="ScannerOnlineForegroundBrush" Color="#86EFAC" />
                    <SolidColorBrush x:Key="ScannerOfflineBackgroundBrush" Color="#293241" />
                    <SolidColorBrush x:Key="ScannerOfflineForegroundBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="ScannerImportedBackgroundBrush" Color="#26E7B65A" />
                    <SolidColorBrush x:Key="ScannerImportedForegroundBrush" Color="#F3D28B" />
                    <SolidColorBrush x:Key="ScannerPossibleMatchBrush" Color="#F3D28B" />
                    <SolidColorBrush x:Key="ScannerLinkedDeviceBrush" Color="#8FD88F" />
                    <SolidColorBrush x:Key="ScannerNoMatchBrush" Color="#A6A6A6" />
                    <SolidColorBrush x:Key="PeopleRoomsBadgeBackgroundBrush" Color="#1E3A8A" />
                    <SolidColorBrush x:Key="PeopleRoomsBadgeForegroundBrush" Color="#BFDBFE" />
                    <Color x:Key="SpeedGaugeSlowColor">#F97066</Color>
                    <Color x:Key="SpeedGaugeFairColor">#FACC15</Color>
                    <Color x:Key="SpeedGaugeGoodColor">#4ADE80</Color>
                    <SolidColorBrush x:Key="SpeedRatingSlowBrush" Color="#FDA29B" />
                    <SolidColorBrush x:Key="SpeedRatingFairBrush" Color="#F3D28B" />
                    <SolidColorBrush x:Key="SpeedRatingGoodBrush" Color="#8FD88F" />
                    <SolidColorBrush x:Key="PageHeaderTabTrackBackgroundBrush" Color="#1B1E24" />
                    <SolidColorBrush x:Key="PageHeaderTabTrackBorderBrush" Color="#2E333C" />
                    <SolidColorBrush x:Key="PageHeaderTabForegroundBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="PageHeaderTabForegroundPointerOverBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PageHeaderTabForegroundPressedBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="PageHeaderTabBackgroundPointerOverBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="PageHeaderTabBackgroundPressedBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="PageHeaderTabBorderPointerOverBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedBackgroundBrush" Color="#343944" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedBackgroundPointerOverBrush" Color="#3A404C" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedBackgroundPressedBrush" Color="#2E333C" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PageHeaderTabPillBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <LinearGradientBrush x:Key="PageHeaderTabSelectedBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
                        <LinearGradientBrush.RelativeTransform>
                            <ScaleTransform ScaleY="-1" CenterY="0.5" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Offset="0.33" Color="#24FFFFFF" />
                        <GradientStop Offset="1.0" Color="#14FFFFFF" />
                    </LinearGradientBrush>
                    <Style x:Key="PageHeaderColorIconStyle" TargetType="Image">
                        <Setter Property="Visibility" Value="Visible" />
                    </Style>
                    <Style x:Key="PageHeaderMonochromeIconStyle" TargetType="BitmapIcon">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ScannerNavigationDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ScannerPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ScannerHeaderBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ScannerCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ScannerMacOuiBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ScannerMacNicBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ScannerOnlineBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ScannerOnlineForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ScannerOfflineBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ScannerOfflineForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ScannerImportedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ScannerImportedForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ScannerPossibleMatchBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ScannerLinkedDeviceBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ScannerNoMatchBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PeopleRoomsBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PeopleRoomsBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <StaticResource x:Key="SpeedGaugeSlowColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="SpeedGaugeFairColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="SpeedGaugeGoodColor" ResourceKey="SystemColorWindowTextColor" />
                    <SolidColorBrush x:Key="SpeedRatingSlowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SpeedRatingFairBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SpeedRatingGoodBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <!-- High-contrast page tabs: system colours only; the selected tab is a highlight surface with its pill. -->
                    <SolidColorBrush x:Key="PageHeaderTabTrackBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabTrackBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabForegroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabForegroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabBackgroundPointerOverBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabBackgroundPressedBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabBorderPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedBackgroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabPillBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PageHeaderTabSelectedBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <Style x:Key="PageHeaderColorIconStyle" TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                    <Style x:Key="PageHeaderMonochromeIconStyle" TargetType="BitmapIcon">
                        <Setter Property="Visibility" Value="Visible" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Thickness x:Key="ScannerPageContentMargin">12,0,24,24</Thickness>
            <!-- Speed-quality words keep their meaning in text; color only reinforces it and becomes the system text color in high contrast. -->
            <Style x:Key="SpeedRatingSlowTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SpeedRatingSlowBrush}" />
            </Style>
            <Style x:Key="SpeedRatingFairTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SpeedRatingFairBrush}" />
            </Style>
            <Style x:Key="SpeedRatingGoodTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SpeedRatingGoodBrush}" />
            </Style>
            <!-- Monitoring dots carry state through shape and fill, never a health colour; text always names the state. -->
            <Style x:Key="NetworkMonitorDotOffStyle" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Fill" Value="Transparent" />
            </Style>
            <Style x:Key="NetworkMonitorDotPausedStyle" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="StrokeDashArray" Value="1.5,1" />
                <Setter Property="Fill" Value="Transparent" />
            </Style>
            <Style x:Key="NetworkMonitorDotNoResultStyle" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Fill" Value="Transparent" />
            </Style>
            <Style x:Key="NetworkMonitorDotActiveStyle" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <!-- Verdict dots pair system status brushes with distinct shapes; titles and names always state the verdict. -->
            <Style x:Key="NetworkMonitorDotHealthyStyle" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="NetworkMonitorDotLearningStyle" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                <Setter Property="Fill" Value="Transparent" />
            </Style>
            <Style x:Key="NetworkMonitorDotVerifyingStyle" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource SystemFillColorCautionBrush}" />
                <Setter Property="Fill" Value="Transparent" />
            </Style>
            <Style x:Key="NetworkMonitorDotProblemStyle" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="NetworkIncidentItemStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource ScannerCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="0,10,0,0" />
            </Style>
            <Style x:Key="NetworkMonitorDotUncertainStyle" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource SystemFillColorCautionBrush}" />
                <Setter Property="StrokeDashArray" Value="1.5,1" />
                <Setter Property="Fill" Value="Transparent" />
            </Style>
            <Style x:Key="NetworkMonitorDotStaleStyle" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Fill" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <local:PortIconGlyphConverter x:Key="PortIconGlyphConverter" />
            <local:LatencyColorConverter x:Key="LatencyColorConverter" />
            <local:ResultRowBackgroundConverter x:Key="ResultRowBackgroundConverter" />
            <Style x:Key="ScannerHeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <Style x:Key="ScannerAssignmentTextStyle" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       TextTrimming="CharacterEllipsis" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="local:ColumnResizeGrip">
                <Setter Property="Width" Value="9" />
                <Setter Property="Foreground" Value="{ThemeResource ScannerCardBorderBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:ColumnResizeGrip">
                            <Grid Background="Transparent">
                                <Rectangle Width="1"
                                           Margin="0,6"
                                           HorizontalAlignment="Center"
                                           Visibility="{TemplateBinding SeparatorVisibility}"
                                           Fill="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScannerSummaryCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ScannerCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="ScannerPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <!-- Shared fixed page header: [Back, 16 DIP,] 48-DIP PageHeaderIcon, 12 DIP, title. It is the page's own
                 Auto row above the scrolling body, starts at the content edge and has no background or divider.
                 Defined here, after its BasedOn styles, because merged dictionaries load before App resources. -->
            <!-- The one shared page-header control height (#658, #659): header row, Back and the page-tab track. -->
            <x:Double x:Key="PageHeaderControlHeight">48</x:Double>
            <Style x:Key="PageHeaderRowStyle" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
                <Setter Property="MinHeight" Value="{StaticResource PageHeaderControlHeight}" />
            </Style>
            <!-- B3 Back (#658): borderless and transparent at rest, subtle fill on hover/pressed, system colours in high
                 contrast (all from SubtleButtonStyle), the system focus visual and the shared 48-DIP height, growing with
                 text. The row's 12-DIP spacing plus the 4-DIP margin makes the 16-DIP gap after Back. -->
            <Style TargetType="local:PageBackButton" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="MinHeight" Value="{StaticResource PageHeaderControlHeight}" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="PageHeaderTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ScannerPageTitleStyle}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- A header title sharing its row with page tabs (#659) stays on one line and truncates before the tabs;
                 the full text stays its automation name and becomes its tooltip when trimmed. -->
            <Style x:Key="PageHeaderSingleLineTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageHeaderTitleStyle}">
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <!-- D3 quiet segmented page tabs (#659) at the right end of the header row: a neutral 48-DIP track with a
                 1-DIP border, 8-DIP corners and 4-DIP padding around 38-DIP items, so it matches Back and the icon. Item
                 padding plus border plus track chrome equals Back's padding and border, so both grow alike with text. The selected item is a raised neutral surface with semibold primary text and a 16x3
                 accent pill; unselected items are secondary text without fill. Selection never relies on colour alone,
                 high contrast uses system colours, and the geometry is identical in every theme and state. -->
            <Style x:Key="PageHeaderTabTrackStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="{StaticResource PageHeaderControlHeight}" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource PageHeaderTabTrackBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PageHeaderTabTrackBorderBrush}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="PageHeaderTabsStyle" TargetType="SelectorBar">
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="PageHeaderTabItemStyle" TargetType="SelectorBarItem">
                <Setter Property="Foreground" Value="{ThemeResource PageHeaderTabForegroundBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,3" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="SelectorBarItem">
                            <Grid x:Name="PART_ContainerRoot" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CombinedStates">
                                        <VisualState x:Name="UnselectedNormal" />
                                        <VisualState x:Name="UnselectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Surface.Background" Value="{ThemeResource PageHeaderTabBackgroundPointerOverBrush}" />
                                                <Setter Target="Surface.BorderBrush" Value="{ThemeResource PageHeaderTabBorderPointerOverBrush}" />
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource PageHeaderTabForegroundPointerOverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="UnselectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Surface.Background" Value="{ThemeResource PageHeaderTabBackgroundPressedBrush}" />
                                                <Setter Target="Surface.BorderBrush" Value="{ThemeResource PageHeaderTabBorderPointerOverBrush}" />
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource PageHeaderTabForegroundPressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedNormal">
                                            <VisualState.Setters>
                                                <Setter Target="Surface.Background" Value="{ThemeResource PageHeaderTabSelectedBackgroundBrush}" />
                                                <Setter Target="Surface.BorderBrush" Value="{ThemeResource PageHeaderTabSelectedBorderBrush}" />
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource PageHeaderTabSelectedForegroundBrush}" />
                                                <Setter Target="PART_TextVisual.FontWeight" Value="SemiBold" />
                                                <Setter Target="PART_SelectionVisual.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Surface.Background" Value="{ThemeResource PageHeaderTabSelectedBackgroundPointerOverBrush}" />
                                                <Setter Target="Surface.BorderBrush" Value="{ThemeResource PageHeaderTabSelectedBorderBrush}" />
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource PageHeaderTabSelectedForegroundBrush}" />
                                                <Setter Target="PART_TextVisual.FontWeight" Value="SemiBold" />
                                                <Setter Target="PART_SelectionVisual.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Surface.Background" Value="{ThemeResource PageHeaderTabSelectedBackgroundPressedBrush}" />
                                                <Setter Target="Surface.BorderBrush" Value="{ThemeResource PageHeaderTabSelectedBorderBrush}" />
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource PageHeaderTabSelectedForegroundBrush}" />
                                                <Setter Target="PART_TextVisual.FontWeight" Value="SemiBold" />
                                                <Setter Target="PART_SelectionVisual.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="DisabledStates">
                                        <VisualState x:Name="Enabled" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <StackPanel Margin="{TemplateBinding Padding}" Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="PART_IconVisual" Content="{TemplateBinding Icon}"
                                                      Foreground="{Binding Foreground, ElementName=PART_TextVisual}" />
                                    <Grid>
                                        <!-- The invisible semibold copy reserves the selected width, so selecting never shifts the tabs. -->
                                        <TextBlock Text="{TemplateBinding Text}" FontFamily="{TemplateBinding FontFamily}"
                                                   FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" Opacity="0"
                                                   AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="PART_TextVisual" Text="{TemplateBinding Text}" HorizontalAlignment="Center"
                                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                                   Foreground="{TemplateBinding Foreground}" />
                                    </Grid>
                                </StackPanel>
                                <Rectangle x:Name="PART_SelectionVisual" Width="16" Height="3" RadiusX="1.5" RadiusY="1.5"
                                           Margin="0,0,0,3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                           Fill="{ThemeResource PageHeaderTabPillBrush}" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScannerSummaryButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ScannerCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>
            <Style x:Key="NavigationChevronIconStyle" TargetType="FontIcon">
                <Setter Property="Glyph" Value="&#xE76C;" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Margin" Value="12,0,0,0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsTextScaleFactorEnabled" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ExternalLinkIconStyle" TargetType="FontIcon">
                <Setter Property="Glyph" Value="&#xE8A7;" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsTextScaleFactorEnabled" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Color x:Key="SystemAccentColor">#2563EB</Color>
            <Color x:Key="SystemAccentColorLight1">#4F83F1</Color>
            <Color x:Key="SystemAccentColorLight2">#82A9F7</Color>
            <Color x:Key="SystemAccentColorLight3">#B7CDFB</Color>
            <Color x:Key="SystemAccentColorDark1">#1E50C4</Color>
            <Color x:Key="SystemAccentColorDark2">#193F99</Color>
            <Color x:Key="SystemAccentColorDark3">#142F70</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
