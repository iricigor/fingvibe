<Application
    x:Class="FingVibe.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F0F2F5" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E5E8ED" />
                    <SolidColorBrush x:Key="ScannerPageBackgroundBrush" Color="#F6F7F9" />
                    <SolidColorBrush x:Key="ScannerHeaderBackgroundBrush" Color="#ECEFF3" />
                    <SolidColorBrush x:Key="ScannerCardBorderBrush" Color="#D5DAE2" />
                    <SolidColorBrush x:Key="ScannerMacOuiBrush" Color="#075985" />
                    <SolidColorBrush x:Key="ScannerMacNicBrush" Color="#6B21A8" />
                    <SolidColorBrush x:Key="ScannerOnlineBackgroundBrush" Color="#DCFCE7" />
                    <SolidColorBrush x:Key="ScannerOnlineForegroundBrush" Color="#166534" />
                    <SolidColorBrush x:Key="ScannerOfflineBackgroundBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="ScannerOfflineForegroundBrush" Color="#475569" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1B1E24" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#292D35" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#343944" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#20242B" />
                    <SolidColorBrush x:Key="ScannerPageBackgroundBrush" Color="#111318" />
                    <SolidColorBrush x:Key="ScannerHeaderBackgroundBrush" Color="#20242B" />
                    <SolidColorBrush x:Key="ScannerCardBorderBrush" Color="#3A414B" />
                    <SolidColorBrush x:Key="ScannerMacOuiBrush" Color="#7DD3FC" />
                    <SolidColorBrush x:Key="ScannerMacNicBrush" Color="#D8B4FE" />
                    <SolidColorBrush x:Key="ScannerOnlineBackgroundBrush" Color="#143A2A" />
                    <SolidColorBrush x:Key="ScannerOnlineForegroundBrush" Color="#86EFAC" />
                    <SolidColorBrush x:Key="ScannerOfflineBackgroundBrush" Color="#293241" />
                    <SolidColorBrush x:Key="ScannerOfflineForegroundBrush" Color="#CBD5E1" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ScannerPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ScannerHeaderBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ScannerCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ScannerMacOuiBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ScannerMacNicBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ScannerOnlineBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ScannerOnlineForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ScannerOfflineBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ScannerOfflineForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <local:PortIconGlyphConverter x:Key="PortIconGlyphConverter" />
            <local:LatencyColorConverter x:Key="LatencyColorConverter" />
            <Style x:Key="ScannerHeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <Style x:Key="ScannerAssignmentTextStyle" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       TextTrimming="CharacterEllipsis" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="local:ColumnResizeGrip">
                <Setter Property="Width" Value="9" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:ColumnResizeGrip">
                            <Grid Background="Transparent">
                                <Rectangle Width="1"
                                           Margin="0,6"
                                           HorizontalAlignment="Center"
                                           Fill="{ThemeResource ScannerCardBorderBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScannerSummaryCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ScannerCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="ScannerPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="ScannerSummaryButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ScannerCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>
            <Color x:Key="SystemAccentColor">#2563EB</Color>
            <Color x:Key="SystemAccentColorLight1">#4F83F1</Color>
            <Color x:Key="SystemAccentColorLight2">#82A9F7</Color>
            <Color x:Key="SystemAccentColorLight3">#B7CDFB</Color>
            <Color x:Key="SystemAccentColorDark1">#1E50C4</Color>
            <Color x:Key="SystemAccentColorDark2">#193F99</Color>
            <Color x:Key="SystemAccentColorDark3">#142F70</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
