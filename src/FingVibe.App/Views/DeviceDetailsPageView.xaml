<UserControl
    x:Class="FingVibe.App.Views.DeviceDetailsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:FingVibe.App"
    xmlns:views="using:FingVibe.App.Views"
    xmlns:models="using:FingVibe.Core.Models">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="SelectorBarItemBackgroundSelected" ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource x:Key="SelectorBarItemForegroundSelected" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                    <StaticResource x:Key="SelectorBarItemBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                    <StaticResource x:Key="SelectorBarItemForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                    <StaticResource x:Key="SelectorBarItemBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                    <StaticResource x:Key="SelectorBarItemForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SelectorBarItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SelectorBarItemForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SelectorBarItemBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SelectorBarItemForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SelectorBarItemBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SelectorBarItemForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="DevicePage" AutomationProperties.AutomationId="DeviceDetailsScroll"
                  HorizontalScrollBarVisibility="Disabled">
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="DetailsSectionSelection">
            <VisualState x:Name="OverviewSelected">
                <VisualState.Setters>
                    <Setter Target="OverviewTab.Background" Value="{ThemeResource SelectorBarItemBackgroundSelected}" />
                    <Setter Target="HistoryTab.Background" Value="Transparent" />
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="HistorySelected">
                <VisualState.Setters>
                    <Setter Target="OverviewTab.Background" Value="Transparent" />
                    <Setter Target="HistoryTab.Background" Value="{ThemeResource SelectorBarItemBackgroundSelected}" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <StackPanel Margin="{StaticResource ScannerPageContentMargin}" Spacing="16">
        <StackPanel Spacing="16">
            <Grid x:Name="HeaderGrid" ColumnSpacing="16" RowSpacing="12" SizeChanged="Header_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <Button x:Name="DeviceBackButton" Click="BackToDevicesButton_Click" AutomationProperties.Name="Back to devices"
                    Padding="10,8" VerticalAlignment="Center">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Devices" FontSize="12" />
                </StackPanel>
            </Button>
            <Border x:Name="DetailsTabsHost" Grid.Column="1" Padding="4" CornerRadius="8"
                    VerticalAlignment="Center" HorizontalAlignment="Left"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <SelectorBar x:Name="DetailsTabs" SelectionChanged="DetailsTabs_SelectionChanged"
                             AutomationProperties.AutomationId="DeviceDetailsTabs" AutomationProperties.Name="Device details sections">
                    <SelectorBarItem x:Name="OverviewTab" Text="Overview" IsSelected="True"
                                     Padding="16,12" CornerRadius="6" AutomationProperties.AutomationId="DeviceOverviewTab" AutomationProperties.Name="Overview" />
                    <SelectorBarItem x:Name="HistoryTab" Text="History" Padding="16,12" CornerRadius="6"
                                     AutomationProperties.AutomationId="DeviceHistoryTab" AutomationProperties.Name="History" />
                </SelectorBar>
            </Border>
            <Grid x:Name="DeviceIdentityHeader" Grid.Column="2" ColumnSpacing="12" MaxWidth="720"
                  HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="DeviceTypeIcon" FontFamily="Segoe Fluent Icons" FontSize="32"
                          VerticalAlignment="Top" Margin="0,6,0,0" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <views:DeviceDetailValue x:Name="DeviceNameValue" CopyLabel="Device name" ValueFontSize="26"
                                             RenameRequested="Rename_Click" />
                    <TextBlock x:Name="DeviceStatusText" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            </Grid>
            <Border x:Name="DeviceNameEditor" Visibility="Collapsed" Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="8">
                    <TextBox x:Name="DeviceNameInput" AutomationProperties.Name="Device name"
                             PlaceholderText="Edit device name" TextWrapping="Wrap" FontFamily="Segoe UI Emoji"
                             TextChanged="DeviceNameInput_TextChanged" />
                    <StackPanel Spacing="8">
                        <Button x:Name="DeviceNameSaveButton" Content="Save" Click="DeviceNameSaveButton_Click" />
                        <Button x:Name="DeviceNameResetButton" Content="Use imported / discovered name"
                                Click="DeviceNameResetButton_Click" />
                        <Button Content="Done" Click="RenameDone_Click" />
                    </StackPanel>
                    <TextBlock x:Name="DeviceNameStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
            <StackPanel x:Name="OverviewPanel" Spacing="16" AutomationProperties.AutomationId="DeviceOverviewPanel">
            <Grid x:Name="DetailsColumns" ColumnSpacing="16" RowSpacing="16" SizeChanged="DetailsColumns_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="NetworkOverviewCard" Style="{StaticResource ScannerSummaryCardStyle}" VerticalAlignment="Stretch">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Network overview" FontSize="18" FontWeight="SemiBold" />
                        <Grid x:Name="OverviewFields" Grid.Row="1" ColumnSpacing="16" RowSpacing="12" SizeChanged="Fields_SizeChanged">
                            <views:DeviceDetailValue x:Name="DeviceAddressText" Label="IP address" />
                            <views:DeviceDetailValue x:Name="DeviceMacText" Label="MAC address" />
                            <views:DeviceDetailValue x:Name="DeviceHostnameText" Label="Discovered hostname" />
                            <views:DeviceDetailValue x:Name="DeviceResponseText" Label="Response" />
                            <views:DeviceDetailValue x:Name="DeviceProbeText" Label="Probe duration" />
                        </Grid>
                        <StackPanel Grid.Row="2" Spacing="12" VerticalAlignment="Bottom">
                            <TextBlock x:Name="DeviceAddressSourceText" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="DeviceAddressPicker" Header="Current address to inspect / probe"
                                      HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DeviceAddressPicker"
                                      Visibility="Collapsed" SelectionChanged="DeviceAddressPicker_SelectionChanged" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="AssignmentsCard" Grid.Column="1" Style="{StaticResource ScannerSummaryCardStyle}" VerticalAlignment="Stretch">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Assignments" FontSize="18" FontWeight="SemiBold" />
                        <Grid x:Name="AssignmentFields" Grid.Row="1" ColumnSpacing="12" RowSpacing="12" SizeChanged="Fields_SizeChanged">
                            <ComboBox x:Name="DevicePersonPicker" Header="Person" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Person" SelectionChanged="DevicePersonPicker_SelectionChanged" />
                            <ComboBox x:Name="DeviceRoomPicker" Header="Room" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Room" SelectionChanged="DeviceRoomPicker_SelectionChanged" />
                        </Grid>
                        <TextBlock x:Name="DeviceAssignmentStatusText" Grid.Row="3" VerticalAlignment="Bottom"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Text="Person and room save when changed." FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
                <Border x:Name="DeviceHistorySummaryCard" Grid.Row="1" Style="{StaticResource ScannerSummaryCardStyle}"
                        AutomationProperties.AutomationId="DeviceHistorySummaryCard">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8" RowSpacing="4" SizeChanged="Fields_SizeChanged">
                            <TextBlock Text="Observation summary" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <HyperlinkButton x:Name="DeviceViewHistory" Content="View history" Padding="0" Click="ViewHistory_Click"
                                             AutomationProperties.AutomationId="DeviceViewHistory"
                                             AutomationProperties.Name="View device history" />
                        </Grid>
                        <TextBlock x:Name="DeviceHistoryFirstSeen" AutomationProperties.AutomationId="DeviceHistoryFirstSeen"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="DeviceHistoryLastSeen" AutomationProperties.AutomationId="DeviceHistoryLastSeen"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center">
                                <Ellipse x:Name="DeviceHistoryPresentDot" Width="10" Height="10"
                                         Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                                <Ellipse x:Name="DeviceHistoryAbsentDot" Width="10" Height="10"
                                         Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock x:Name="DeviceHistoryState" Grid.Column="1" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="DeviceHistoryState" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Saved evidence - not live status." FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Expander x:Name="DeviceHistorySummaryDetails" Header="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  AutomationProperties.AutomationId="DeviceHistorySummaryDetails">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="DeviceHistorySummaryScope" AutomationProperties.AutomationId="DeviceHistorySummaryScope"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DeviceHistoryExactDates" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="DeviceHistorySince" AutomationProperties.AutomationId="DeviceHistorySince"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="Recorded runs describe saved scans, not physical connection times. Gaps between scans do not prove uninterrupted availability."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <Border x:Name="UsageCategoryCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource ScannerSummaryCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Usage category" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Button x:Name="UsageCategoryEdit" Grid.Column="1" Content="Edit" Click="UsageCategoryEdit_Click"
                                        AutomationProperties.AutomationId="UsageCategoryEdit" AutomationProperties.Name="Edit usage category" />
                            </Grid>
                            <TextBlock x:Name="UsageCategoryEffective" FontWeight="SemiBold" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="UsageCategoryEffective" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="UsageCategorySummary" TextWrapping="Wrap" FontSize="12"
                                       AutomationProperties.AutomationId="UsageCategorySummary" />
                            <InfoBar x:Name="UsageCategoryError" IsOpen="False" IsClosable="False" Severity="Error"
                                     Title="Category could not be saved" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel x:Name="UsageCategoryEditor" Spacing="8" Visibility="Collapsed">
                            <ComboBox x:Name="UsageCategoryPicker" Header="Usage category" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="UsageCategoryPicker" AutomationProperties.Name="Usage category"
                                      SelectionChanged="UsageCategory_SelectionChanged" />
                            <Grid ColumnSpacing="8" RowSpacing="8" SizeChanged="Fields_SizeChanged">
                                <Button x:Name="UsageCategorySave" Content="Save category" HorizontalAlignment="Stretch"
                                        Style="{StaticResource AccentButtonStyle}" Click="UsageCategorySave_Click"
                                        AutomationProperties.AutomationId="UsageCategorySave" />
                                <Button x:Name="UsageCategoryCancel" Content="Cancel" HorizontalAlignment="Stretch"
                                        Click="UsageCategoryCancel_Click" AutomationProperties.AutomationId="UsageCategoryCancel"
                                        AutomationProperties.Name="Cancel category changes" />
                            </Grid>
                            <TextBlock x:Name="UsageCategoryEditStatus" TextWrapping="Wrap" FontSize="12"
                                       AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="UsageCategoryReload" Content="Reload saved category" Visibility="Collapsed"
                                    Click="UsageCategoryReload_Click" AutomationProperties.AutomationId="UsageCategoryReload" />
                            <TextBlock Text="A manual choice stays fixed until you save Automatic. Category Save/Cancel never changes Person or Room."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Expander x:Name="UsageCategoryDetails" Header="Evidence and limitations"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      AutomationProperties.AutomationId="UsageCategoryDetails">
                            <StackPanel Spacing="8">
                            <TextBlock x:Name="UsageCategoryEvidence" TextWrapping="Wrap" FontSize="12"
                                       AutomationProperties.AutomationId="UsageCategoryEvidence" />
                            <TextBlock x:Name="UsageCategoryWindow" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="UsageCategoryLimited" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock x:Name="UsageCategorySampling" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="UsageCategoryRefresh" Content="Refresh usage evidence" Click="UsageCategoryRefresh_Click"
                                    AutomationProperties.AutomationId="UsageCategoryRefresh" />
                            </StackPanel>
                            </Expander>
                        </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="IdentificationCard" Style="{StaticResource ScannerSummaryCardStyle}"
                    VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Device identification" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="DeviceClassificationEditButton" Grid.Column="1"
                                AutomationProperties.Name="Edit device identification" Click="ClassificationEdit_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock Text="Edit" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid x:Name="IdentificationReadFields" ColumnSpacing="16" RowSpacing="12" SizeChanged="Fields_SizeChanged">
                        <views:DeviceDetailValue x:Name="DeviceTypeValueText" Label="Device type" />
                        <views:DeviceDetailValue x:Name="DeviceOsText" Label="Operating system" />
                        <StackPanel Spacing="6">
                            <views:DeviceDetailValue x:Name="DeviceBrandText" Label="Vendor / manufacturer" />
                            <TextBlock x:Name="DeviceVendorText" TextWrapping="Wrap" FontSize="12"
                                       AutomationProperties.AutomationId="DeviceDetectedMacVendor"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <views:DeviceDetailValue x:Name="DeviceFamilyText" Label="Family" />
                        <views:DeviceDetailValue x:Name="DeviceModelText" Label="Model" />
                        <views:DeviceDetailValue x:Name="DeviceIconText" Label="Icon" />
                    </Grid>
                    <TextBlock x:Name="DeviceClassificationNoticeText" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="IdentificationEditFields" Spacing="12" Visibility="Collapsed">
                        <Grid x:Name="IdentificationInputs" ColumnSpacing="16" RowSpacing="12" SizeChanged="Fields_SizeChanged">
                            <ComboBox x:Name="DeviceTypePicker" Header="Device type" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Device type" SelectionChanged="ClassificationPicker_SelectionChanged" />
                            <ComboBox x:Name="DeviceOsPicker" Header="Operating system" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Operating system" SelectionChanged="ClassificationPicker_SelectionChanged" />
                            <TextBox x:Name="DeviceBrandInput" Header="Vendor / manufacturer" AutomationProperties.Name="Vendor / manufacturer"
                                     TextChanged="ClassificationText_TextChanged" />
                            <TextBox x:Name="DeviceFamilyInput" Header="Family" AutomationProperties.Name="Family"
                                     TextChanged="ClassificationText_TextChanged" />
                            <TextBox x:Name="DeviceModelInput" Header="Model" AutomationProperties.Name="Model"
                                     TextChanged="ClassificationText_TextChanged" />
                            <ComboBox x:Name="DeviceIconPicker" Header="Device icon" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Device icon" SelectionChanged="ClassificationPicker_SelectionChanged" />
                        </Grid>
                        <TextBlock Text="Blank manufacturer, family or model uses the original/default value. Saving does not change imported Fing or detected MAC-vendor evidence."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DeviceClassificationSaveButton" Content="Save changes"
                                    Click="DeviceClassificationSaveButton_Click" />
                            <Button x:Name="DeviceClassificationCancelButton" Content="Cancel" Click="ClassificationCancel_Click" />
                        </StackPanel>
                        <Button x:Name="DeviceClassificationResetButton" Content="Reset saved identification"
                                Click="DeviceClassificationResetButton_Click"
                                ToolTipService.ToolTip="Clear all six saved identification overrides. Names, assignments and original Fing data are unchanged." />
                    </StackPanel>
                    <TextBlock x:Name="DeviceClassificationStatusText" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Expander Header="How this device was identified" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="DeviceOsEvidenceText" TextWrapping="Wrap" />
                            <TextBlock x:Name="DeviceTypeEvidenceText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="DeviceImportedMetadata" Header="Imported Fing data" IsExpanded="False"
                              AutomationProperties.AutomationId="DeviceImportedMetadata"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="DeviceImportedFields" Spacing="12" />
                    </Expander>
                </StackPanel>
            </Border>
            <Border x:Name="PortsServicesCard" Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="DevicePortsHeading" Text="Ports &amp; services (0)" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DeviceNoPortsText" Text="No open ports detected."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="DevicePortScanButton" Content="Scan additional ports"
                            HorizontalAlignment="Left" Click="DevicePortScanButton_Click" />
                    <CheckBox x:Name="DeviceIncludeUdpCheckBox" Content="Include UDP service checks"
                              IsChecked="False" AutomationProperties.AutomationId="DeviceIncludeUdpCheckBox"
                              ToolTipService.ToolTip="Send one read-only DNS and NTP request. Silence is inconclusive." />
                    <TextBlock x:Name="DevicePortScanStatusText" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="DeviceTcpScanStatus" AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="DeviceUdpScanStatusText" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="DeviceUdpScanStatus" AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid x:Name="DevicePortsList" ColumnSpacing="24" RowSpacing="12" SizeChanged="Fields_SizeChanged" />
                    <TextBlock x:Name="DeviceBrowserStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="DeviceUdpObservations" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="UDP observations (silence is not an open or closed port)" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="DeviceUdpObservationsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:UdpServiceObservation">
                                <TextBlock Text="{x:Bind AccessibleLabel}" TextWrapping="Wrap" Margin="0,2"
                                           AutomationProperties.Name="{x:Bind AccessibleLabel}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
            <StackPanel x:Name="HistoryPanel" Spacing="16" Visibility="Collapsed"
                        AutomationProperties.AutomationId="DeviceHistoryPanel">
            <Border x:Name="DeviceActivityCard" Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16" RowSpacing="8" SizeChanged="Fields_SizeChanged">
                        <TextBlock Text="Activity" FontSize="20" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="16" RowSpacing="8" SizeChanged="Fields_SizeChanged">
                        <ComboBox x:Name="ActivityPeriod" Header="Period" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                  AutomationProperties.AutomationId="ActivityPeriod" AutomationProperties.Name="Activity period"
                                  SelectedIndex="0" SelectionChanged="ActivityPeriod_SelectionChanged">
                            <ComboBoxItem Content="Last 7 days" />
                            <ComboBoxItem Content="Last 30 days" />
                            <ComboBoxItem Content="30 days by weekday" />
                        </ComboBox>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ActivityHoursLabel" Text="Hours per square: 1" TextWrapping="Wrap" />
                        <Slider x:Name="ActivityHours" Minimum="1" Maximum="4" Value="1" StepFrequency="1"
                                TickFrequency="1" TickPlacement="BottomRight" SnapsTo="Ticks" MinWidth="0"
                                HorizontalAlignment="Stretch" ValueChanged="ActivityHours_ValueChanged"
                                AutomationProperties.AutomationId="ActivityHours" AutomationProperties.Name="Activity group hours" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="1 h" FontSize="12" />
                            <TextBlock Text="2 h" FontSize="12" Grid.Column="1" HorizontalAlignment="Center" />
                            <TextBlock Text="3 h" FontSize="12" Grid.Column="2" HorizontalAlignment="Center" />
                            <TextBlock Text="4 h" FontSize="12" Grid.Column="3" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="ActivityWindow" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="ActivityWindow" />
                    <TextBlock x:Name="ActivityStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="ActivityStatus" />
                    <ProgressBar x:Name="ActivityLoading" IsIndeterminate="False" Visibility="Collapsed"
                                 AutomationProperties.Name="Loading completed scan evidence" />
                    <InfoBar x:Name="ActivityError" IsOpen="False" IsClosable="False" Severity="Error"
                             Title="Activity could not be loaded" AutomationProperties.AutomationId="ActivityError" />
                    <Button x:Name="ActivityRefresh" Content="Retry" Click="ActivityRefresh_Click" Visibility="Collapsed"
                            AutomationProperties.AutomationId="ActivityRefresh" />
                    <ScrollViewer x:Name="ActivityScroll" MaxHeight="560" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                  AutomationProperties.AutomationId="ActivityScroll" AutomationProperties.Name="Device activity grid">
                        <!-- Once keeps one Tab stop while every cell stays focusable for UI Automation. -->
                        <Grid x:Name="ActivityGrid" RowSpacing="4" ColumnSpacing="4" TabFocusNavigation="Once" />
                    </ScrollViewer>
                    <TextBlock x:Name="ActivityLegend" TextWrapping="Wrap" FontSize="12"
                               AutomationProperties.AutomationId="ActivityLegend" />
                    <TextBlock x:Name="ActivityDetail" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ActivityDetail" />
                    <Expander Header="How to read this grid" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ActivityScope" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock TextWrapping="Wrap" Text="Green with R means at least one response, not online for the whole interval. Amber with a minus means eligible scans with no response, not proof of absence. Sparse hatching means no eligible scan data; dim dotted squares are later today. Weekday numbers count responding dates; green strength uses all applicable dates, including unknown dates. A skipped DST hour is not applicable (-); repeated clock hours share a square and retain both scan instants. Use arrow keys within the grid; Enter or focus exposes counts. Scroll horizontally to see every hour at narrow widths." />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Scan observations" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Saved scans - not continuous live status." TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Expander x:Name="DeviceScanHistoryDetails" Header="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                    <TextBlock x:Name="DeviceHistoryScope" AutomationProperties.AutomationId="DeviceHistoryScope"
                               TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock x:Name="DeviceHistoryLatest" AutomationProperties.AutomationId="DeviceHistoryLatest"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="DeviceScanHistoryExpander" Header="Completed Scan Observations"
                              IsExpanded="True"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              AutomationProperties.AutomationId="DeviceScanHistoryExpander">
                        <StackPanel Spacing="12">
                            <Expander Header="About these observations" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBlock Text="Current-network completed manual and scheduled scans, newest first. Present / absent means observed present / absent. Pending or incomplete checkpoints are not completed history. Since is the first scan in the latest recorded run of that state, not the physical connection/disconnection time. Gaps between scans do not prove uninterrupted availability. Saved observations do not establish current live presence. All completed observations are retained."
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Expander>
                            <TextBlock x:Name="DeviceScanHistoryCount" AutomationProperties.AutomationId="DeviceScanHistoryCount"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DeviceHistoryNewer" Content="Newer scans" Click="HistoryPage_Click"
                                        AutomationProperties.AutomationId="DeviceHistoryNewer" />
                                <Button x:Name="DeviceHistoryOlder" Content="Older scans" Click="HistoryPage_Click"
                                        AutomationProperties.AutomationId="DeviceHistoryOlder" />
                            </StackPanel>
                            <TextBlock x:Name="DeviceHistoryPageStatus" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="DeviceHistoryPageStatus"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="DeviceScanHistoryEmpty" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="DeviceScanHistoryEmpty" />
                            <StackPanel x:Name="DeviceScanHistoryTable" Spacing="0">
                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" Padding="12,8"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="When (local)" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="Result" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                                <ScrollViewer x:Name="DeviceScanHistoryList" MaxHeight="320" IsTabStop="True"
                                              HorizontalScrollBarVisibility="Disabled"
                                              AutomationProperties.AutomationId="DeviceScanHistoryList"
                                              AutomationProperties.Name="Completed scan history, newest first">
                                    <ItemsControl x:Name="DeviceScanHistoryRows">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="app:DeviceScanHistoryRow">
                                                <views:DeviceScanHistoryItem HorizontalContentAlignment="Stretch"
                                                                            IsTabStop="True"
                                                                            AutomationProperties.Name="{x:Bind AccessibleLabel}">
                                                    <Border Padding="12,8" BorderThickness="0,0,0,1"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            Background="{x:Bind IsAlternateRow, Converter={StaticResource ResultRowBackgroundConverter}}"
                                                            AutomationProperties.Name="{x:Bind AccessibleLabel}"
                                                            ToolTipService.ToolTip="{x:Bind FullTimestamp}">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind When}" TextWrapping="Wrap" />
                                                            <Grid Grid.Column="1" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid VerticalAlignment="Center">
                                                                    <Ellipse Width="10" Height="10" Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                                             Visibility="{x:Bind Present}" />
                                                                    <Ellipse Width="10" Height="10" Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                                                             Visibility="{x:Bind Absent}" />
                                                                </Grid>
                                                                <TextBlock Grid.Column="1" Text="{x:Bind Result}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </views:DeviceScanHistoryItem>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <Border x:Name="VirtualDeviceHistoryCard" Style="{StaticResource ScannerSummaryCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="Virtual device" FontWeight="SemiBold" />
                    <TextBlock Text="MACs are associated by private vendor prefix and the lowest available device number. This is an inference, not proof of one physical device. Names, identification and assignments follow this virtual device."
                               TextWrapping="Wrap" />
                    <Expander Header="MAC and address history" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBlock x:Name="VirtualDeviceHistoryText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   AutomationProperties.AutomationId="VirtualDeviceHistory" />
                    </Expander>
                </StackPanel>
            </Border>
            </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
