<UserControl
    x:Class="FingVibe.App.Views.PeopleRoomsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <UserControl.Resources>
        <!-- Rows stretch with no container inset so their columns line up with the header grid. -->
        <Style x:Key="PeopleRoomsListItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- A stable, always-visible ellipsis that opens labeled Edit and Delete actions. -->
        <Style x:Key="PeopleRoomsActionsButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="{StaticResource ScannerPageContentMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="PeopleRoomsHeadingRow" Style="{StaticResource PageHeaderRowStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:PageHeaderIcon Icon="people-rooms" />
            <TextBlock Grid.Column="1" Text="People &amp; rooms" Style="{StaticResource PageHeaderTitleStyle}" />
        </Grid>
        <ScrollViewer x:Name="PeopleRoomsPage" Grid.Row="1" AutomationProperties.AutomationId="PeopleRoomsPage">
        <StackPanel Spacing="12">
            <TextBlock Text="Manage people and manually assigned device locations; response counts describe the last scan, not presence."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Spacing="8">
                <TextBox x:Name="PeopleRoomsSearchBox" MaxWidth="300" HorizontalAlignment="Left"
                         PlaceholderText="Search people and rooms" AutomationProperties.Name="Search people and rooms"
                         TextChanged="PeopleRoomsSearchBox_TextChanged" />
                <TextBlock x:Name="PeopleRoomsStatusText" Visibility="Collapsed"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border x:Name="PeopleTableBorder" Style="{StaticResource ScannerSummaryCardStyle}" Padding="0">
                <StackPanel>
                    <Border Style="{StaticResource CardHeadingBandStyle}" Margin="0" Padding="12,10">
                    <Grid Style="{StaticResource CardHeadingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE716;" Style="{StaticResource CardHeadingIconStyle}" />
                        <TextBlock Grid.Column="1" Text="People" Style="{StaticResource CardHeadingTextStyle}" />
                        <TextBlock x:Name="PeopleCountText" Grid.Column="2" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="AddPersonButton" Grid.Column="3" Content="Add person"
                                VerticalAlignment="Center" Click="AddPersonButton_Click" />
                    </Grid>
                    </Border>
                    <TextBlock x:Name="PeopleStatusText" Visibility="Collapsed" Margin="12,0,12,8" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid x:Name="PeopleColumnHeaders" Padding="12,8" Background="{ThemeResource ScannerHeaderBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Short name" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Devices" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Responding devices" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <!-- Reserves the row actions button width, including text scaling, so the headers share row columns. -->
                        <Button Grid.Column="4" Style="{StaticResource PeopleRoomsActionsButtonStyle}" Opacity="0"
                                IsHitTestVisible="False" IsTabStop="False" AutomationProperties.AccessibilityView="Raw">
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                        </Button>
                    </Grid>
                    <ListView x:Name="PeopleList" ItemContainerStyle="{StaticResource PeopleRoomsListItemStyle}" IsItemClickEnabled="True"
                              ItemClick="PeopleList_ItemClick" AutomationProperties.Name="People">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ManagedPersonListRow">
                                <Grid Padding="12,4" MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource PeopleRoomsBadgeBackgroundBrush}" CornerRadius="999"
                                            Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Person.ShortName}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource PeopleRoomsBadgeForegroundBrush}"
                                                   FontFamily="Segoe UI Emoji" />
                                    </Border>
                                    <Grid Grid.Column="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <local:PersonIcon IconId="{x:Bind Person.IconId}" FontSize="20"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Person.Name}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{x:Bind DeviceCountText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind RespondedCountText}" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Tag="{x:Bind Person.Id}"
                                            Style="{StaticResource PeopleRoomsActionsButtonStyle}"
                                            AutomationProperties.Name="{x:Bind ActionsLabel}"
                                            ToolTipService.ToolTip="More actions"
                                            Click="PersonActionsButton_Click">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="PeopleEmptyState" Spacing="8" HorizontalAlignment="Center"
                                Margin="12,12,12,24" Visibility="Collapsed">
                        <TextBlock x:Name="PeopleEmptyText" Text="No people yet" FontSize="20"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="Add people to assign devices to the people who use them."
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="RoomsTableBorder" Style="{StaticResource ScannerSummaryCardStyle}" Padding="0">
                <StackPanel>
                    <Border Style="{StaticResource CardHeadingBandStyle}" Margin="0" Padding="12,10">
                    <Grid x:Name="RoomsHeadingRow" Style="{StaticResource CardHeadingRowStyle}"
                          SizeChanged="RoomsHeadingRow_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon Glyph="&#xE80F;" Style="{StaticResource CardHeadingIconStyle}" />
                        <TextBlock Grid.Column="1" Text="Rooms" Style="{StaticResource CardHeadingTextStyle}" />
                        <TextBlock x:Name="RoomsCountText" Grid.Column="2" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <!-- Room-wide actions share the heading; they wrap beneath it when the row cannot hold them. -->
                        <StackPanel x:Name="RoomsActions" Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <HyperlinkButton x:Name="ViewRoomMapButton" Content="View room map"
                                             VerticalAlignment="Center"
                                             AutomationProperties.AutomationId="ViewRoomMapButton"
                                             AutomationProperties.Name="View room map"
                                             Click="RoomMapButton_Click" />
                            <Button x:Name="AddRoomButton" Content="Add room"
                                    VerticalAlignment="Center" Click="AddRoomButton_Click" />
                        </StackPanel>
                    </Grid>
                    </Border>
                    <TextBlock x:Name="RoomsStatusText" Visibility="Collapsed" Margin="12,0,12,8" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid x:Name="RoomsColumnHeaders" Padding="12,8" Background="{ThemeResource ScannerHeaderBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Short name" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Devices" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Responding devices" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <!-- Reserves the row actions button width, including text scaling, so the headers share row columns. -->
                        <Button Grid.Column="4" Style="{StaticResource PeopleRoomsActionsButtonStyle}" Opacity="0"
                                IsHitTestVisible="False" IsTabStop="False" AutomationProperties.AccessibilityView="Raw">
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                        </Button>
                    </Grid>
                    <ListView x:Name="RoomsList" ItemContainerStyle="{StaticResource PeopleRoomsListItemStyle}" IsItemClickEnabled="True"
                              ItemClick="RoomsList_ItemClick" AutomationProperties.Name="Rooms">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ManagedRoomListRow">
                                <Grid Padding="12,4" MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource PeopleRoomsBadgeBackgroundBrush}" CornerRadius="999"
                                            Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Room.ShortName}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource PeopleRoomsBadgeForegroundBrush}"
                                                   FontFamily="Segoe UI Emoji" />
                                    </Border>
                                    <Grid Grid.Column="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="16"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Room.Name}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{x:Bind DeviceCountText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind RespondedCountText}" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Tag="{x:Bind Room.Id}"
                                            Style="{StaticResource PeopleRoomsActionsButtonStyle}"
                                            AutomationProperties.Name="{x:Bind ActionsLabel}"
                                            ToolTipService.ToolTip="More actions"
                                            Click="RoomActionsButton_Click">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="RoomsEmptyState" Spacing="8" HorizontalAlignment="Center"
                                Margin="12,12,12,24" Visibility="Collapsed">
                        <TextBlock x:Name="RoomsEmptyText" Text="No rooms yet" FontSize="20"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="Add rooms to record manually assigned device locations."
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
