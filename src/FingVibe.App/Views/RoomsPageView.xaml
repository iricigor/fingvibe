<UserControl
    x:Class="FingVibe.App.Views.RoomsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App"
    xmlns:models="using:FingVibe.Core.Models">
    <ScrollViewer x:Name="RoomsPage">
        <StackPanel Margin="24,0,24,24" Spacing="12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Rooms" Style="{StaticResource ScannerPageTitleStyle}" Margin="0" />
                    <TextBlock Text="Manage manually assigned device locations; response counts describe the last scan, not detected presence."
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="AddRoomButton" Grid.Column="1" Content="Add room"
                        VerticalAlignment="Center" Click="AddRoomButton_Click" />
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RoomsSearchBox" Width="260" HorizontalAlignment="Left"
                         PlaceholderText="Search rooms" AutomationProperties.Name="Search rooms"
                         TextChanged="RoomsSearchBox_TextChanged" />
                <TextBlock x:Name="RoomsStatusText" Grid.Column="1" VerticalAlignment="Center"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <Border x:Name="RoomsTableBorder" Style="{StaticResource ScannerSummaryCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,8" Background="{ThemeResource ScannerHeaderBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Short name" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Devices" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Last scan" FontWeight="SemiBold" />
                    </Grid>
                    <ListView x:Name="RoomsList" Grid.Row="1" IsItemClickEnabled="True"
                              ItemClick="RoomsList_ItemClick" AutomationProperties.Name="Rooms">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ManagedRoomListRow">
                                <Grid Padding="12,4" MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Room.ShortName}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Room.Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind DeviceCountText}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind RespondedCountText}" />
                                    <Button Grid.Column="4" Content="More" Tag="{x:Bind Room.Id}"
                                            AutomationProperties.Name="{x:Bind ActionsLabel}"
                                            Click="RoomActionsButton_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <StackPanel x:Name="RoomsEmptyState" Spacing="8" HorizontalAlignment="Center"
                        Margin="0,36" Visibility="Collapsed">
                <TextBlock x:Name="RoomsEmptyText" Text="No rooms yet" FontSize="20"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Add rooms to record manually assigned device locations."
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Add room" Click="AddRoomButton_Click" HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
