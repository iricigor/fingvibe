<UserControl
    x:Class="FingVibe.App.Views.DevicesPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App"
    xmlns:views="using:FingVibe.App.Views"
    xmlns:models="using:FingVibe.Core.Models">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="CellHoverTextBrush" Color="#005A9E" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="CellHoverTextBrush" Color="#A8DFFF" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="CellHoverTextBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <DataTemplate x:Key="MacTemplate" x:DataType="local:ScanResultRow">
            <TextBlock FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis"
                       views:DevicesPageView.PreviewText="{x:Bind MacAddressText}" AutomationProperties.Name="{x:Bind MacAddressText}">
                <Run Text="{x:Bind local:DeviceColumnLayoutHelpers.MetadataText(MacOui)}" Foreground="{ThemeResource ScannerMacOuiBrush}" /><Run Text="{x:Bind MacNic}" Foreground="{ThemeResource ScannerMacNicBrush}" />
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="ResponseTemplate" x:DataType="local:ScanResultRow">
            <Grid MinHeight="26" RowSpacing="2" VerticalAlignment="Center"
                  ToolTipService.ToolTip="Relative to responding hosts in this scan: green is fastest, red is slowest.">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ResponseTimeText" Text="{x:Bind local:DeviceColumnLayoutHelpers.MetadataText(LatencyLabel), Mode=OneWay}"
                           FontFamily="Consolas" FontSize="13" TextAlignment="Right" VerticalAlignment="Top" />
                <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{x:Bind LatencyFill, Mode=OneWay}"
                             Visibility="{x:Bind HasLatency, Mode=OneWay}" Height="4"
                             AutomationProperties.Name="{x:Bind LatencyLabel}">
                    <ProgressBar.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#22C55E" Offset="0" />
                            <GradientStop Color="{Binding LatencyFraction, Converter={StaticResource LatencyColorConverter}}" Offset="1" />
                        </LinearGradientBrush>
                    </ProgressBar.Foreground>
                </ProgressBar>
            </Grid>
        </DataTemplate>
        <Style x:Key="FilterStyle" TargetType="DropDownButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="StatusCountStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="HoverLine.Visibility" Value="Collapsed" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverLine.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Presenter.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Presenter.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedLine.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedLine.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedLine.Visibility" Value="Visible" />
                                            <Setter Target="Presenter.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedLine.Visibility" Value="Visible" />
                                            <Setter Target="Presenter.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}"
                                              Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="HoverLine" Height="1" VerticalAlignment="Bottom"
                                    Background="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                            <Border x:Name="SelectedLine" Height="2" VerticalAlignment="Bottom"
                                    Background="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusFilterStyle" TargetType="DropDownButton" BasedOn="{StaticResource FilterStyle}">
            <Setter Property="Width" Value="210" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="DevicesPage" Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DevicesHeading" Text="Devices" Style="{StaticResource ScannerPageTitleStyle}" Margin="0" />
        </Grid>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ScannerCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="16,16,16,8" Spacing="8">
                    <Grid x:Name="DeviceSummary" ColumnSpacing="16"
                          SizeChanged="DeviceSummary_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="InventoryCountsText" ColumnSpacing="8" RowSpacing="2" HorizontalAlignment="Left"
                              AutomationProperties.AccessibilityView="Content">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="OnlineChip" Tag="1" Checked="StatusChip_Changed" Unchecked="StatusChip_Changed" Style="{StaticResource StatusCountStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource ScannerOnlineForegroundBrush}" />
                                    <TextBlock x:Name="OnlineCountText" Text="0 Online" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="OfflineChip" Grid.Column="1" Tag="2" Checked="StatusChip_Changed" Unchecked="StatusChip_Changed" Style="{StaticResource StatusCountStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource ScannerOfflineForegroundBrush}" />
                                    <TextBlock x:Name="OfflineCountText" Text="0 Offline" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="UnknownChip" Grid.Column="2" Tag="4" Checked="StatusChip_Changed" Unchecked="StatusChip_Changed" Style="{StaticResource StatusCountStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource ScannerOfflineForegroundBrush}" />
                                    <TextBlock x:Name="UnknownCountText" Text="0 Unknown" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="FingOnlyChip" Grid.Column="3" Tag="3" Checked="StatusChip_Changed" Unchecked="StatusChip_Changed" Style="{StaticResource StatusCountStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource ScannerImportedForegroundBrush}" />
                                    <TextBlock x:Name="FingOnlyCountText" Text="0 Fing Only" />
                                </StackPanel>
                            </ToggleButton>
                        </Grid>
                        <TextBlock x:Name="ResultCountText" Grid.Column="1" Text="Showing 0 devices"
                                   TextWrapping="Wrap" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="LastScanText" Grid.Column="2" Text="Scan duration —"
                                   TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Border Padding="0,4,0,0">
                        <StackPanel x:Name="DeviceFilters" Spacing="8"
                              SizeChanged="DeviceFilters_SizeChanged">
                            <Grid x:Name="DeviceSearchFilters" ColumnSpacing="8" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ResultSearchBox"
                                         PlaceholderText="Search devices"
                                         AutomationProperties.Name="Search devices"
                                         TextChanged="ResultSearchBox_TextChanged" />
                                <DropDownButton x:Name="InventoryStatusFilter" Grid.Column="1"
                                                Style="{StaticResource StatusFilterStyle}"
                                                AutomationProperties.AutomationId="InventoryStatusFilter" />
                                <Border x:Name="FilterActions" Grid.Column="2" VerticalAlignment="Top"
                                        BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="FilterExpander" MinWidth="40" MinHeight="30" IsChecked="False"
                                              BorderThickness="0" CornerRadius="3"
                                              AutomationProperties.Name="Show additional device filters"
                                              ToolTipService.ToolTip="Show or hide additional device filters"
                                              Checked="FilterExpander_Changed" Unchecked="FilterExpander_Changed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE71C;" FontSize="16" />
                                        <TextBlock x:Name="ActiveFilterCount" Visibility="Collapsed" />
                                    </StackPanel>
                                </ToggleButton>
                                        <Button x:Name="ClearFiltersLink" Grid.Column="1" MinWidth="36" MinHeight="30"
                                                Padding="8,4" BorderThickness="1,0,0,0" CornerRadius="0,3,3,0"
                                                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                Click="ClearFilters_Click" Visibility="Collapsed"
                                                AutomationProperties.Name="Clear all Devices filters"
                                                ToolTipService.ToolTip="Clear filters">
                                            <FontIcon Glyph="&#xE894;" FontSize="16" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Grid x:Name="DeviceFilterOptions"
                                  ColumnSpacing="8" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DropDownButton x:Name="TypeFilter" Style="{StaticResource FilterStyle}" />
                                <DropDownButton x:Name="OperatingSystemFilter" Grid.Column="1" Style="{StaticResource FilterStyle}" />
                                <DropDownButton x:Name="VendorFilter" Grid.Column="2" Style="{StaticResource FilterStyle}" />
                                <DropDownButton x:Name="PersonFilter" Grid.Column="3" Style="{StaticResource FilterStyle}" />
                                <DropDownButton x:Name="RoomFilter" Grid.Column="4" Style="{StaticResource FilterStyle}" />
                                <DropDownButton x:Name="PortsFilter" Grid.Column="5" Style="{StaticResource FilterStyle}">
                                    <DropDownButton.Flyout>
                                        <Flyout>
                                            <StackPanel x:Name="PortsFilterChoices"
                                                        AutomationProperties.Name="Ports choices"
                                                        AutomationProperties.AccessibilityView="Content">
                                                <CheckBox x:Name="OpenPortsFilter" Content="With open ports" IsChecked="False"
                                                          AutomationProperties.Name="With open ports"
                                                          Checked="OpenPortsFilter_Changed" Unchecked="OpenPortsFilter_Changed" />
                                            </StackPanel>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ScrollViewer x:Name="TableViewport" Grid.Row="1"
                              ViewChanged="TableViewport_ViewChanged"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="{x:Bind local:DeviceColumnLayoutHelpers.ToTableWidth(Columns.TotalWidth), Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="DeviceTableHeader" AutomationProperties.Name="Device column titles"
                              AutomationProperties.AccessibilityView="Content"
                              Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderPadding(Columns.HeaderVerticalPadding), Mode=OneWay}" Background="{ThemeResource ScannerHeaderBackgroundBrush}"
                              BorderBrush="{ThemeResource ScannerCardBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Name.EffectiveWidth), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Addresses.EffectiveWidth), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.VendorOs.EffectiveWidth), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Ports.EffectiveWidth), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Connection.EffectiveWidth), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateResponseWidth), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateMacWidth), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateOsWidth), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateTypeWidth), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Assignments.EffectiveWidth), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateRoomWidth), Mode=OneWay}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Visibility="{x:Bind Columns.Name.IsVisible, Mode=OneWay}">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Name" FontWeight="SemiBold" FontSize="12" Margin="{x:Bind local:DeviceColumnLayoutHelpers.HeaderPrimaryMargin(Columns.HeaderLabelTopMargin), Mode=OneWay}" />
                                    <Button Tag="DeviceType" Click="SortHeader_Click"
                                            MinHeight="0" Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderButtonPadding(Columns.HeaderButtonVerticalPadding), Mode=OneWay}"
                                            Visibility="{x:Bind Columns.ShowMergedType, Mode=OneWay}"
                                            Style="{StaticResource ScannerHeaderButtonStyle}" ToolTipService.ToolTip="Sort by device type">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Device type" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="DeviceTypeSortGlyph" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <local:ColumnResizeGrip Column="{x:Bind Columns.Name}" AutomationProperties.Name="{x:Bind Columns.Name.ResizeLabel}"
                                                        SeparatorVisibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.Name.HasFollowingVisibleColumn), Mode=OneWay}" />
                            </Grid>
                            <Grid Grid.Column="1" Visibility="{x:Bind Columns.Address.IsVisible, Mode=OneWay}">
                                <StackPanel Margin="0,0,12,0">
                                <Button Tag="Address" Click="SortHeader_Click" MinHeight="0" Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderButtonPadding(Columns.HeaderButtonVerticalPadding), Mode=OneWay}"
                                        Style="{StaticResource ScannerHeaderButtonStyle}" ToolTipService.ToolTip="Sort by IP address">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="IP address" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AddressSortGlyph" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="MacAddress" Click="SortHeader_Click" Visibility="{x:Bind Columns.ShowMergedMac, Mode=OneWay}"
                                        Style="{StaticResource ScannerHeaderButtonStyle}" MinHeight="0" Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderButtonPadding(Columns.HeaderButtonVerticalPadding), Mode=OneWay}" ToolTipService.ToolTip="Sort by MAC address">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="MAC address" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="MergedMacAddressSortGlyph" />
                                    </StackPanel>
                                </Button>
                                </StackPanel>
                                <local:ColumnResizeGrip Column="{x:Bind Columns.Addresses, Mode=OneWay}" AutomationProperties.Name="{x:Bind Columns.Addresses.ResizeLabel, Mode=OneWay}"
                                                        SeparatorVisibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.Addresses.HasFollowingVisibleColumn), Mode=OneWay}" />
                            </Grid>
                            <Grid Grid.Column="2" Visibility="{x:Bind Columns.Vendor.IsVisible, Mode=OneWay}">
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Vendor" FontWeight="SemiBold" FontSize="12" Margin="{x:Bind local:DeviceColumnLayoutHelpers.HeaderPrimaryMargin(Columns.HeaderLabelTopMargin), Mode=OneWay}" />
                                    <Button Tag="OperatingSystem" Click="SortHeader_Click" MinHeight="0" Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderButtonPadding(Columns.HeaderButtonVerticalPadding), Mode=OneWay}"
                                            Visibility="{x:Bind Columns.ShowMergedOs, Mode=OneWay}"
                                            Style="{StaticResource ScannerHeaderButtonStyle}" ToolTipService.ToolTip="Sort by operating system">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="OS" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="MergedOperatingSystemSortGlyph" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <local:ColumnResizeGrip Column="{x:Bind Columns.VendorOs, Mode=OneWay}" AutomationProperties.Name="{x:Bind Columns.VendorOs.ResizeLabel, Mode=OneWay}"
                                                        SeparatorVisibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.VendorOs.HasFollowingVisibleColumn), Mode=OneWay}" />
                            </Grid>
                            <Grid Grid.Column="3" Visibility="{x:Bind Columns.Ports.IsVisible, Mode=OneWay}">
                                <TextBlock Text="Open ports" FontWeight="SemiBold" FontSize="12" Margin="{x:Bind local:DeviceColumnLayoutHelpers.HeaderTextMargin(Columns.HeaderLabelTopMargin), Mode=OneWay}" VerticalAlignment="Center" />
                                <local:ColumnResizeGrip Column="{x:Bind Columns.Ports}" AutomationProperties.Name="{x:Bind Columns.Ports.ResizeLabel}"
                                                        SeparatorVisibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.Ports.HasFollowingVisibleColumn), Mode=OneWay}" />
                            </Grid>
                            <Grid Grid.Column="4" Visibility="{x:Bind Columns.Connection.IsVisible, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibleStarWidth(Columns.Status.IsVisible), Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibleStarWidth(Columns.ShowConnectionResponse), Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <Grid Visibility="{x:Bind Columns.Status.IsVisible, Mode=OneWay}">
                                    <Button Tag="Status" Click="SortHeader_Click" Margin="0,0,12,0" MinHeight="0"
                                            Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderButtonPadding(Columns.HeaderButtonVerticalPadding), Mode=OneWay}"
                                            Style="{StaticResource ScannerHeaderButtonStyle}" ToolTipService.ToolTip="Sort by status">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Status" FontWeight="SemiBold" />
                                            <TextBlock x:Name="StatusSortGlyph" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Grid.Column="1" Visibility="{x:Bind Columns.ShowConnectionResponse, Mode=OneWay}">
                                    <Button Tag="Response" Click="SortHeader_Click" Margin="0,0,12,0" HorizontalContentAlignment="Right" MinHeight="0"
                                            Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderButtonPadding(Columns.HeaderButtonVerticalPadding), Mode=OneWay}"
                                            Style="{StaticResource ScannerHeaderButtonStyle}" ToolTipService.ToolTip="Sort by response time">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Response" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ResponseSortGlyph" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <local:ColumnResizeGrip x:Name="ConnectionResizeGrip" Grid.ColumnSpan="2"
                                                        Column="{x:Bind Columns.Connection, Mode=OneWay}" AutomationProperties.Name="{x:Bind Columns.Connection.ResizeLabel, Mode=OneWay}"
                                                        SeparatorVisibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.Connection.HasFollowingVisibleColumn), Mode=OneWay}" />
                            </Grid>
                            <Grid Grid.Column="5" Visibility="{x:Bind Columns.ShowSeparateResponse, Mode=OneWay}">
                                <Button Tag="Response" Click="SortHeader_Click" Margin="0,0,12,0" HorizontalContentAlignment="Right" MinHeight="0"
                                        Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderButtonPadding(Columns.HeaderButtonVerticalPadding), Mode=OneWay}"
                                        Style="{StaticResource ScannerHeaderButtonStyle}" ToolTipService.ToolTip="Sort by response time">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Response" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SeparateResponseSortGlyph" />
                                    </StackPanel>
                                </Button>
                                <local:ColumnResizeGrip Column="{x:Bind Columns.Response}" AutomationProperties.Name="{x:Bind Columns.Response.ResizeLabel}"
                                                        SeparatorVisibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.Response.HasFollowingVisibleColumn), Mode=OneWay}" />
                            </Grid>
                            <Grid Grid.Column="6" Visibility="{x:Bind Columns.ShowSeparateMac, Mode=OneWay}">
                                <Button Tag="MacAddress" Click="SortHeader_Click" Margin="0,0,12,0" MinHeight="0"
                                        Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderButtonPadding(Columns.HeaderButtonVerticalPadding), Mode=OneWay}"
                                        Style="{StaticResource ScannerHeaderButtonStyle}" ToolTipService.ToolTip="Sort by MAC address">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="MAC address" FontWeight="SemiBold" />
                                        <TextBlock x:Name="MacAddressSortGlyph" />
                                    </StackPanel>
                                </Button>
                                <local:ColumnResizeGrip Column="{x:Bind Columns.Mac}" AutomationProperties.Name="{x:Bind Columns.Mac.ResizeLabel}"
                                                        SeparatorVisibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.Mac.HasFollowingVisibleColumn), Mode=OneWay}" />
                            </Grid>
                            <Grid Grid.Column="7" Visibility="{x:Bind Columns.ShowSeparateOs, Mode=OneWay}">
                                <Button Tag="OperatingSystem" Click="SortHeader_Click" Margin="0,0,12,0" MinHeight="0"
                                        Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderButtonPadding(Columns.HeaderButtonVerticalPadding), Mode=OneWay}"
                                        Style="{StaticResource ScannerHeaderButtonStyle}" ToolTipService.ToolTip="Sort by operating system">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="OS" FontWeight="SemiBold" />
                                        <TextBlock x:Name="OperatingSystemSortGlyph" />
                                    </StackPanel>
                                </Button>
                                <local:ColumnResizeGrip Column="{x:Bind Columns.OperatingSystem}" AutomationProperties.Name="{x:Bind Columns.OperatingSystem.ResizeLabel}"
                                                        SeparatorVisibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.OperatingSystem.HasFollowingVisibleColumn), Mode=OneWay}" />
                            </Grid>
                            <Grid Grid.Column="8" Visibility="{x:Bind Columns.ShowSeparateType, Mode=OneWay}">
                                <Button Tag="DeviceType" Click="SortHeader_Click" Margin="0,0,12,0" MinHeight="0"
                                        Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderButtonPadding(Columns.HeaderButtonVerticalPadding), Mode=OneWay}"
                                        Style="{StaticResource ScannerHeaderButtonStyle}" ToolTipService.ToolTip="Sort by device type">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Device type" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SeparateDeviceTypeSortGlyph" />
                                    </StackPanel>
                                </Button>
                                <local:ColumnResizeGrip Column="{x:Bind Columns.Type}" AutomationProperties.Name="{x:Bind Columns.Type.ResizeLabel}"
                                                        SeparatorVisibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.Type.HasFollowingVisibleColumn), Mode=OneWay}" />
                            </Grid>
                            <Grid Grid.Column="9" Visibility="{x:Bind Columns.Assignments.IsVisible, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Columns.Assignments.Header, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Margin="{x:Bind local:DeviceColumnLayoutHelpers.HeaderTextMargin(Columns.HeaderLabelTopMargin), Mode=OneWay}" VerticalAlignment="Center"
                                           Visibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.ShowSeparatePerson), Mode=OneWay}" />
                                <TextBlock Text="Room" FontWeight="SemiBold" FontSize="12" Margin="{x:Bind local:DeviceColumnLayoutHelpers.HeaderTextMargin(Columns.HeaderLabelTopMargin), Mode=OneWay}" VerticalAlignment="Center"
                                           Visibility="{x:Bind Columns.ShowRoomOnly, Mode=OneWay}" />
                                <StackPanel Margin="0,0,12,0" Visibility="{x:Bind Columns.ShowMergedRoom, Mode=OneWay}">
                                    <TextBlock Text="Person" FontWeight="SemiBold" FontSize="12" Margin="{x:Bind local:DeviceColumnLayoutHelpers.HeaderPrimaryMargin(Columns.HeaderLabelTopMargin), Mode=OneWay}" />
                                    <TextBlock Text="Room" FontSize="11" Margin="{x:Bind local:DeviceColumnLayoutHelpers.HeaderSecondaryMargin(Columns.HeaderSecondaryMargin), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <local:ColumnResizeGrip Column="{x:Bind Columns.Assignments, Mode=OneWay}" AutomationProperties.Name="{x:Bind Columns.Assignments.ResizeLabel, Mode=OneWay}"
                                                        SeparatorVisibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.Assignments.HasFollowingVisibleColumn), Mode=OneWay}" />
                            </Grid>
                            <Grid Grid.Column="10" Visibility="{x:Bind Columns.ShowSeparateRoom, Mode=OneWay}">
                                <TextBlock Text="Room" FontWeight="SemiBold" FontSize="12" Margin="{x:Bind local:DeviceColumnLayoutHelpers.HeaderTextMargin(Columns.HeaderLabelTopMargin), Mode=OneWay}" VerticalAlignment="Center" />
                                <local:ColumnResizeGrip Column="{x:Bind Columns.Room}" AutomationProperties.Name="{x:Bind Columns.Room.ResizeLabel}"
                                                        SeparatorVisibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.Room.HasFollowingVisibleColumn), Mode=OneWay}" />
                            </Grid>
                        </Grid>
                        <ListView x:Name="ResultsList" Grid.Row="1" SelectionMode="Single"
                                  IsItemClickEnabled="True" ItemClick="ResultsList_ItemClick"
                                  ContainerContentChanging="ResultsList_ContainerContentChanging"
                                  SelectionChanged="ResultsList_SelectionChanged"
                                  AutomationProperties.Name="Scan results">
                            <ListView.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#DBEAFE" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#BFDBFE" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#BFDBFE" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Dark">
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#243F65" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#2C4D7B" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#2C4D7B" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="{Binding Columns.RowMinimumHeight}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ScanResultRow">
                                    <Grid Padding="{x:Bind local:DeviceColumnLayoutHelpers.RowPadding(Columns.RowVerticalPadding), Mode=OneWay}"
                                          MinHeight="{x:Bind Columns.RowMinimumHeight, Mode=OneWay}"
                                          Background="{x:Bind HasStripe, Mode=OneWay, Converter={StaticResource ResultRowBackgroundConverter}}">
                                        <Grid.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </Grid.Resources>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Name.EffectiveWidth), Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Addresses.EffectiveWidth), Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.VendorOs.EffectiveWidth), Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Ports.EffectiveWidth), Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Connection.EffectiveWidth), Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateResponseWidth), Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateMacWidth), Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateOsWidth), Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateTypeWidth), Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Assignments.EffectiveWidth), Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateRoomWidth), Mode=OneWay}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Margin="0,0,12,0" ColumnSpacing="8"
                                              Visibility="{x:Bind Columns.Name.IsVisible, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon x:Name="DeviceIcon" Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="20" Width="24"
                                                      VerticalAlignment="Center"
                                                      ToolTipService.ToolTip="{x:Bind IconSource, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind IconSource, Mode=OneWay}" />
                                            <StackPanel Grid.Column="1" Spacing="{x:Bind Columns.RowSpacing, Mode=OneWay}" VerticalAlignment="Center">
                                                <TextBlock x:Name="DeviceNameText" Text="{x:Bind NameText, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                           FontFamily="Segoe UI Emoji" Opacity="{x:Bind NameOpacity, Mode=OneWay}"
                                                           views:DevicesPageView.PreviewText="{x:Bind NameText, Mode=OneWay}" />
                                                <TextBlock x:Name="DeviceTypeLabel" Text="{x:Bind local:DeviceColumnLayoutHelpers.MetadataText(DeviceTypeText), Mode=OneWay}"
                                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{x:Bind local:DeviceColumnLayoutHelpers.SecondaryTypeVisibility(Columns.ShowMergedType, DeviceTypeText), Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind DeviceTypeSource, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="{x:Bind Columns.RowSpacing, Mode=OneWay}" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,12,0"
                                                   Visibility="{x:Bind Columns.Address.IsVisible, Mode=OneWay}"
                                                   views:DevicesPageView.PreviewText="{x:Bind AddressText, Mode=OneWay}"
                                                   AutomationProperties.Name="{x:Bind AddressText, Mode=OneWay}">
                                            <Run Text="{x:Bind DisplayAddressPrefix, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{x:Bind DisplayAddressHost, Mode=OneWay}" FontWeight="SemiBold" FontSize="{x:Bind AddressHostFontSize, Mode=OneWay}" />
                                        </TextBlock>
                                        <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource MacTemplate}"
                                                        Margin="0,0,12,0" HorizontalContentAlignment="Stretch"
                                                        Visibility="{x:Bind Columns.ShowMergedMac, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="{x:Bind Columns.RowSpacing, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                    Visibility="{x:Bind Columns.Vendor.IsVisible, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind local:DeviceColumnLayoutHelpers.MetadataText(VendorDisplayText), Mode=OneWay}"
                                                   Opacity="{x:Bind VendorOpacity, Mode=OneWay}"
                                                   Visibility="{x:Bind Columns.Vendor.IsVisible, Mode=OneWay}"
                                                   views:DevicesPageView.PreviewText="{x:Bind views:DevicesPageView.VendorPreviewText(VendorDisplayText, VendorDescription), Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="MergedOperatingSystemText"
                                                   Text="{x:Bind local:DeviceColumnLayoutHelpers.KnownMetadataText(OperatingSystemText), Mode=OneWay}"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Opacity="{x:Bind OperatingSystemOpacity, Mode=OneWay}"
                                                   Visibility="{x:Bind Columns.ShowMergedOs, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind OperatingSystemSource, Mode=OneWay}" />
                                        </StackPanel>
                                        <ItemsControl Grid.Column="3" ItemsSource="{x:Bind OpenPortItems, Mode=OneWay}" VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      Visibility="{x:Bind Columns.Ports.IsVisible, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:OpenPort">
                                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                                              FontSize="16"
                                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              Glyph="{Binding Converter={StaticResource PortIconGlyphConverter}}"
                                                              AutomationProperties.Name="{Binding AccessibleLabel}"
                                                              ToolTipService.ToolTip="{Binding AccessibleLabel}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid x:Name="ConnectionCell" Grid.Column="4" Margin="0,0,12,0" MinHeight="26" VerticalAlignment="Center"
                                              Visibility="{x:Bind Columns.Connection.IsVisible, Mode=OneWay}"
                                              ToolTipService.ToolTip="Response bar is relative to responding hosts in this scan: green is fastest, red is slowest.">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibleStarWidth(Columns.Status.IsVisible), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibleStarWidth(Columns.ShowConnectionResponse), Mode=OneWay}" />
                                            </Grid.ColumnDefinitions>
                                            <Grid x:Name="DeviceStatusCell" Visibility="{x:Bind Columns.Status.IsVisible, Mode=OneWay}" VerticalAlignment="Top"
                                                  ToolTipService.ToolTip="{x:Bind StatusContext}">
                                                <Border Visibility="{x:Bind IsOnline}" Padding="8,1" CornerRadius="10"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{ThemeResource ScannerOnlineBackgroundBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="5" Height="5" Fill="{ThemeResource ScannerOnlineForegroundBrush}" />
                                                        <TextBlock Text="{x:Bind StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource ScannerOnlineForegroundBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Visibility="{x:Bind IsOffline}" Padding="8,1" CornerRadius="10"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{ThemeResource ScannerOfflineBackgroundBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="5" Height="5" Fill="{ThemeResource ScannerOfflineForegroundBrush}" />
                                                        <TextBlock Text="{x:Bind StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource ScannerOfflineForegroundBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Visibility="{x:Bind IsFingOnly}" Padding="8,1" CornerRadius="10"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{ThemeResource ScannerImportedBackgroundBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="5" Height="5" Fill="{ThemeResource ScannerImportedForegroundBrush}" />
                                                        <TextBlock Text="{x:Bind StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource ScannerImportedForegroundBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Visibility="{x:Bind IsHistorical}" Padding="8,1" CornerRadius="10"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{ThemeResource ScannerOfflineBackgroundBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="5" Height="5" Fill="{ThemeResource ScannerOfflineForegroundBrush}" />
                                                        <TextBlock Text="{x:Bind StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource ScannerOfflineForegroundBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <ContentControl Grid.ColumnSpan="2" Content="{x:Bind}" ContentTemplate="{StaticResource ResponseTemplate}"
                                                            HorizontalContentAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="False"
                                                            Visibility="{x:Bind Columns.ShowConnectionResponse, Mode=OneWay}" />
                                        </Grid>
                                        <ContentControl Grid.Column="5" Content="{x:Bind}" ContentTemplate="{StaticResource ResponseTemplate}"
                                                        Margin="0,0,12,0" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
                                                        Visibility="{x:Bind Columns.ShowSeparateResponse, Mode=OneWay}" />
                                        <ContentControl Grid.Column="6" Content="{x:Bind}" ContentTemplate="{StaticResource MacTemplate}"
                                                        Margin="0,0,12,0" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
                                                        Visibility="{x:Bind Columns.ShowSeparateMac, Mode=OneWay}" />
                                        <TextBlock Grid.Column="7" Text="{x:Bind local:DeviceColumnLayoutHelpers.MetadataText(OperatingSystemText), Mode=OneWay}" Margin="0,0,12,0"
                                                   Opacity="{x:Bind OperatingSystemOpacity, Mode=OneWay}"
                                                   Visibility="{x:Bind Columns.ShowSeparateOs, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind OperatingSystemSource, Mode=OneWay}" />
                                        <TextBlock Grid.Column="8" Text="{x:Bind local:DeviceColumnLayoutHelpers.MetadataText(DeviceTypeText), Mode=OneWay}"
                                                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis" Opacity="{x:Bind DeviceTypeOpacity, Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind DeviceTypeSource, Mode=OneWay}"
                                                   Visibility="{x:Bind Columns.ShowSeparateType, Mode=OneWay}" />
                                        <Grid Grid.Column="9" Visibility="{x:Bind Columns.ShowMergedRoom, Mode=OneWay}">
                                            <StackPanel x:Name="MergedAssignments" Spacing="{x:Bind Columns.AssignmentSpacing, Mode=OneWay}" VerticalAlignment="Center">
                                                <Grid x:Name="MergedPersonLine" ColumnSpacing="4" HorizontalAlignment="Center" Background="Transparent"
                                                      Visibility="{x:Bind HasPersonAssignment, Mode=OneWay}"
                                                      views:DevicesPageView.PreviewText="{x:Bind PersonAssignmentDescription, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind PersonAssignmentDescription, Mode=OneWay}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE77B;" FontSize="12" Width="12" Height="12" VerticalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="MergedPersonValue" Grid.Column="1" Text="{x:Bind PersonShortName, Mode=OneWay}"
                                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                                               AutomationProperties.Name="{x:Bind PersonAssignmentDescription, Mode=OneWay}" />
                                                </Grid>
                                                <Grid x:Name="MergedRoomLine" ColumnSpacing="4" HorizontalAlignment="Center" Background="Transparent"
                                                      Visibility="{x:Bind HasRoomAssignment, Mode=OneWay}"
                                                      views:DevicesPageView.PreviewText="{x:Bind RoomAssignmentDescription, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind RoomAssignmentDescription, Mode=OneWay}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE80F;" FontSize="12" Width="12" Height="12" VerticalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="MergedRoomValue" Grid.Column="1" Text="{x:Bind RoomShortName, Mode=OneWay}"
                                                               FontFamily="Segoe UI Emoji" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               AutomationProperties.Name="{x:Bind RoomAssignmentDescription, Mode=OneWay}" />
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock x:Name="MergedAssignmentsEmpty" Text="-" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind HasNoAssignments, Mode=OneWay}"
                                                       views:DevicesPageView.PreviewText="Person and room: Unassigned"
                                                       AutomationProperties.Name="Person and room: Unassigned" />
                                        </Grid>
                                        <Button Grid.Column="9" Content="{x:Bind local:DeviceColumnLayoutHelpers.AssignmentText(PersonId, PersonShortName), Mode=OneWay}"
                                                FontSize="12" Style="{StaticResource ScannerAssignmentTextStyle}"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.ShowSeparatePerson), Mode=OneWay}"
                                                Opacity="{x:Bind PersonOpacity, Mode=OneWay}"
                                                views:DevicesPageView.PreviewText="{x:Bind PersonFullName, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind PersonFullName, Mode=OneWay}" />
                                        <Button Grid.Column="9" Content="{x:Bind local:DeviceColumnLayoutHelpers.AssignmentText(RoomId, RoomShortName), Mode=OneWay}"
                                                FontSize="12" Style="{StaticResource ScannerAssignmentTextStyle}" FontFamily="Segoe UI Emoji"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.ShowRoomOnly), Mode=OneWay}"
                                                Opacity="{x:Bind RoomOpacity, Mode=OneWay}"
                                                views:DevicesPageView.PreviewText="{x:Bind RoomFullName, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind RoomFullName, Mode=OneWay}" />
                                        <Button Grid.Column="10" Content="{x:Bind local:DeviceColumnLayoutHelpers.AssignmentText(RoomId, RoomShortName), Mode=OneWay}"
                                                Style="{StaticResource ScannerAssignmentTextStyle}"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe UI Emoji"
                                                Opacity="{x:Bind RoomOpacity, Mode=OneWay}"
                                                Visibility="{x:Bind Columns.ShowSeparateRoom, Mode=OneWay}"
                                                views:DevicesPageView.PreviewText="{x:Bind RoomFullName, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind RoomFullName, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
                <Canvas x:Name="PreviewLayer" Grid.Row="1" IsHitTestVisible="False">
                    <Border x:Name="CellPreview" Visibility="Collapsed" Padding="8,4"
                            Background="{ThemeResource ScannerHeaderBackgroundBrush}"
                            BorderBrush="{ThemeResource ScannerCardBorderBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <TextBlock x:Name="CellPreviewText" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock x:Name="HoverTextPalette" Visibility="Collapsed"
                               Foreground="{ThemeResource CellHoverTextBrush}" />
                </Canvas>
                <TextBlock x:Name="EmptyResultsText"
                           Grid.Row="1"
                           Text="Select Scan LAN to probe every address on the detected subnet."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
