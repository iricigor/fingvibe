                                        Style="{StaticResource ScannerHeaderButtonStyle}" ToolTipService.ToolTip="Sort by effective usage category">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Usage category" FontWeight="SemiBold" />
                                        <TextBlock x:Name="UsageCategorySortGlyph" />
