                                </Button>
                                <local:ColumnResizeGrip Column="{x:Bind Columns.Room}" AutomationProperties.Name="{x:Bind Columns.Room.ResizeLabel}" />
                            </Grid>
                            <Grid Grid.Column="12" Visibility="{x:Bind Columns.LastSeen.IsVisible, Mode=OneWay}">
                                <Button x:Name="LastSeenSortButton" Tag="LastSeen" Click="SortHeader_Click" Margin="0,0,12,0" MinHeight="0"
                                        Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderButtonPadding(Columns.HeaderButtonVerticalPadding), Mode=OneWay}"
                                        Style="{StaticResource ScannerHeaderButtonStyle}" ToolTipService.ToolTip="Sort by last seen time">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Last seen" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LastSeenSortGlyph" />
