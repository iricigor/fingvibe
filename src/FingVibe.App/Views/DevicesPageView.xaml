                                <local:ColumnResizeGrip Column="{x:Bind Columns.Type}" AutomationProperties.Name="{x:Bind Columns.Type.ResizeLabel}" />
                            </Grid>
                            <Grid Grid.Column="9" Visibility="{x:Bind Columns.UsageCategory.IsVisible, Mode=OneWay}">
                                <Button x:Name="UsageCategorySortButton" Tag="UsageCategory" Click="SortHeader_Click" Margin="0,0,12,0" MinHeight="0"
