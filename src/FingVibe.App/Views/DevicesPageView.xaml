                                <local:ColumnResizeGrip Column="{x:Bind Columns.LastSeen}" AutomationProperties.Name="{x:Bind Columns.LastSeen.ResizeLabel}" />
                            </Grid>
                        </Grid>
                        <ListView x:Name="ResultsList" Grid.Row="1" SelectionMode="Single"
                                  IsItemClickEnabled="True" ItemClick="ResultsList_ItemClick"
                                  KeyDown="ResultsList_KeyDown"
                                  ContainerContentChanging="ResultsList_ContainerContentChanging"
                                  SelectionChanged="ResultsList_SelectionChanged"
                                  AutomationProperties.Name="Scan results">
                            <ListView.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#DBEAFE" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#BFDBFE" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#BFDBFE" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Dark">
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#243F65" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#2C4D7B" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#2C4D7B" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <!-- The row template owns the minimum; remove WinUI's 40-DIP container floor. -->
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ScanResultRow">
                                    <StackPanel Background="{x:Bind HasStripe, Mode=OneWay, Converter={StaticResource ResultRowBackgroundConverter}}">
                                        <StackPanel.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <Grid Padding="{x:Bind local:DeviceColumnLayoutHelpers.RowPadding(Columns.RowVerticalPadding), Mode=OneWay}"
                                              MinHeight="{x:Bind Columns.RowMinimumHeight, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Name.EffectiveWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Addresses.EffectiveWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.VendorOs.EffectiveWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Ports.EffectiveWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Connection.EffectiveWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateResponseWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateMacWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateOsWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateTypeWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.UsageCategory.EffectiveWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Assignments.EffectiveWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateRoomWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.LastSeen.EffectiveWidth), Mode=OneWay}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                        <Grid Margin="0,0,12,0"
                                              Visibility="{x:Bind Columns.Name.IsVisible, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="DeviceMacExpansionButton" Click="DeviceMacExpansionButton_Click"
                                                    Visibility="{x:Bind HasEarlierMacAddresses, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanToggleMacAddresses, Mode=OneWay}"
                                                    Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0"
                                                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                                    AutomationProperties.AutomationId="DeviceMacExpansionButton"
                                                    AutomationProperties.Name="{x:Bind MacExpansionName, Mode=OneWay}"
                                                    AutomationProperties.HelpText="{x:Bind MacExpansionState, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind MacExpansionGlyph, Mode=OneWay}"
                                                          FontFamily="Segoe Fluent Icons" FontSize="12" />
                                            </Button>
                                            <FontIcon x:Name="DeviceIcon" Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="20" Width="24"
                                                      Grid.Column="1"
                                                      Margin="{x:Bind local:DeviceColumnLayoutHelpers.MacExpansionIconMargin(HasEarlierMacAddresses), Mode=OneWay}"
                                                      VerticalAlignment="Center"
                                                      ToolTipService.ToolTip="{x:Bind IconSource, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind IconSource, Mode=OneWay}" />
                                            <StackPanel Grid.Column="2" Margin="8,0,0,0"
                                                        Spacing="{x:Bind Columns.RowSpacing, Mode=OneWay}" VerticalAlignment="Center">
                                                <TextBlock x:Name="DeviceNameText" Text="{x:Bind NameText, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                           FontFamily="Segoe UI Emoji" Opacity="{x:Bind NameOpacity, Mode=OneWay}"
                                                           views:DevicesPageView.PreviewText="{x:Bind NameText, Mode=OneWay}" />
                                                <TextBlock x:Name="DeviceTypeLabel" Text="{x:Bind local:DeviceColumnLayoutHelpers.MetadataText(DeviceTypeText), Mode=OneWay}"
                                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{x:Bind local:DeviceColumnLayoutHelpers.SecondaryTypeVisibility(Columns.ShowMergedType, DeviceTypeText), Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind DeviceTypeSource, Mode=OneWay}" />
                                            </StackPanel>
                                            <Button x:Name="DeviceMatchButton" Grid.Column="3" Click="DeviceMatchButton_Click"
                                                    Margin="8,0,0,0"
                                                    PointerEntered="DeviceMatchButton_PointerEntered"
                                                    PointerExited="DeviceMatchButton_PointerExited"
                                                    Visibility="{x:Bind HasMatchSuggestions, Mode=OneWay}"
                                                    Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0"
                                                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                                    AutomationProperties.AutomationId="DeviceMatchButton"
                                                    AutomationProperties.Name="{x:Bind MatchSuggestionName, Mode=OneWay}"
                                                    AutomationProperties.HelpText="{x:Bind MatchSuggestionText, Mode=OneWay}">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip AutomationProperties.AutomationId="DeviceMatchTooltip"
                                                             Content="{x:Bind MatchSuggestionText, Mode=OneWay}"
                                                             AutomationProperties.Name="{x:Bind MatchSuggestionText, Mode=OneWay}" />
                                                </ToolTipService.ToolTip>
                                                <FontIcon Glyph="&#xE71B;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                                          Foreground="{ThemeResource ScannerPossibleMatchBrush}" />
                                            </Button>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="{x:Bind Columns.RowSpacing, Mode=OneWay}" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,12,0"
                                                   Visibility="{x:Bind Columns.Address.IsVisible, Mode=OneWay}"
                                                   views:DevicesPageView.PreviewText="{x:Bind AddressText, Mode=OneWay}"
                                                   AutomationProperties.Name="{x:Bind AddressText, Mode=OneWay}">
                                            <Run Text="{x:Bind DisplayAddressPrefix, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{x:Bind DisplayAddressHost, Mode=OneWay}" FontWeight="SemiBold" FontSize="{x:Bind AddressHostFontSize, Mode=OneWay}" />
                                        </TextBlock>
                                        <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource MacTemplate}"
                                                        Margin="0,0,12,0" HorizontalContentAlignment="Stretch"
                                                        Visibility="{x:Bind Columns.ShowMergedMac, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="{x:Bind Columns.RowSpacing, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                    Visibility="{x:Bind Columns.Vendor.IsVisible, Mode=OneWay}">
                                        <TextBlock x:Name="DeviceVendorText" Text="{x:Bind VendorDisplayText, Mode=OneWay}"
                                                   AutomationProperties.HelpText="{x:Bind VendorDescription, Mode=OneWay}"
                                                   Opacity="{x:Bind VendorOpacity, Mode=OneWay}"
                                                   Visibility="{x:Bind Columns.Vendor.IsVisible, Mode=OneWay}"
                                                   views:DevicesPageView.PreviewText="{x:Bind views:DevicesPageView.VendorPreviewText(VendorDisplayText, VendorDescription), Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="MergedOperatingSystemText"
                                                   Text="{x:Bind local:DeviceColumnLayoutHelpers.KnownMetadataText(OperatingSystemText), Mode=OneWay}"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Opacity="{x:Bind OperatingSystemOpacity, Mode=OneWay}"
                                                   Visibility="{x:Bind Columns.ShowMergedOs, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind OperatingSystemSource, Mode=OneWay}" />
                                        </StackPanel>
                                        <Grid Grid.Column="3" Margin="0,0,12,0" ColumnSpacing="8" VerticalAlignment="Center"
                                              Visibility="{x:Bind Columns.Ports.IsVisible, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                        <ItemsControl ItemsSource="{x:Bind OpenPortItems, Mode=OneWay}" VerticalAlignment="Center"
                                                      HorizontalAlignment="Left">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:OpenPort">
                                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                                              FontSize="16"
                                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              Glyph="{Binding Converter={StaticResource PortIconGlyphConverter}}"
                                                              AutomationProperties.Name="{Binding AccessibleLabel}"
                                                              ToolTipService.ToolTip="{Binding AccessibleLabel}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                            <Button x:Name="ServiceDiscoveryButton" Grid.Column="1" Click="ServiceDiscoveryButton_Click"
                                                    Visibility="{x:Bind HasLatestServiceDiscovery, Mode=OneWay}"
                                                    Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                                    Background="Transparent" BorderThickness="0"
                                                    AutomationProperties.AutomationId="ServiceDiscoveryButton"
                                                    AutomationProperties.Name="{x:Bind ServiceDiscoveryName, Mode=OneWay}"
                                                    AutomationProperties.HelpText="{x:Bind ServiceDiscoveryText, Mode=OneWay}"
                                                    ToolTipService.ToolTip="{x:Bind ServiceDiscoveryText, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE95A;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Button>
                                        </Grid>
                                        <Grid x:Name="ConnectionCell" Grid.Column="4" Margin="0,0,12,0" MinHeight="26" VerticalAlignment="Center"
                                              Visibility="{x:Bind Columns.Connection.IsVisible, Mode=OneWay}"
                                              ToolTipService.ToolTip="Response bar is relative to responding hosts in this scan: green is fastest, red is slowest.">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibleStarWidth(Columns.Status.IsVisible), Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibleStarWidth(Columns.ShowConnectionResponse), Mode=OneWay}" />
                                            </Grid.ColumnDefinitions>
                                            <Grid x:Name="DeviceStatusCell" Visibility="{x:Bind Columns.Status.IsVisible, Mode=OneWay}" VerticalAlignment="Top"
                                                  ToolTipService.ToolTip="{x:Bind StatusContext, Mode=OneWay}">
                                                <Border Visibility="{x:Bind IsOnline, Mode=OneWay}" Padding="8,1" CornerRadius="10"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{ThemeResource ScannerOnlineBackgroundBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="5" Height="5" Fill="{ThemeResource ScannerOnlineForegroundBrush}" />
                                                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource ScannerOnlineForegroundBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Visibility="{x:Bind IsOffline, Mode=OneWay}" Padding="8,1" CornerRadius="10"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{ThemeResource OfflineRowBadgeBackgroundBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="5" Height="5" Fill="{ThemeResource StatusChoiceOfflineBrush}" />
                                                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource StatusChoiceOfflineBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Visibility="{x:Bind IsFingOnly, Mode=OneWay}" Padding="8,1" CornerRadius="10"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{ThemeResource FingOnlyRowBadgeBackgroundBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="5" Height="5" Fill="{ThemeResource StatusChoiceFingOnlyBrush}" />
                                                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource StatusChoiceFingOnlyBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Visibility="{x:Bind IsHistorical, Mode=OneWay}" Padding="8,1" CornerRadius="10"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{ThemeResource ScannerOfflineBackgroundBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="5" Height="5" Fill="{ThemeResource ScannerOfflineForegroundBrush}" />
                                                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource ScannerOfflineForegroundBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <ContentControl Grid.ColumnSpan="2" Content="{x:Bind}" ContentTemplate="{StaticResource ResponseTemplate}"
                                                            HorizontalContentAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="False"
                                                            Visibility="{x:Bind Columns.ShowConnectionResponse, Mode=OneWay}" />
                                        </Grid>
                                        <ContentControl Grid.Column="5" Content="{x:Bind}" ContentTemplate="{StaticResource ResponseTemplate}"
                                                        Margin="0,0,12,0" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
                                                        Visibility="{x:Bind Columns.ShowSeparateResponse, Mode=OneWay}" />
                                        <ContentControl Grid.Column="6" Content="{x:Bind}" ContentTemplate="{StaticResource MacTemplate}"
                                                        Margin="0,0,12,0" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
                                                        Visibility="{x:Bind Columns.ShowSeparateMac, Mode=OneWay}" />
                                        <TextBlock Grid.Column="7" Text="{x:Bind local:DeviceColumnLayoutHelpers.MetadataText(OperatingSystemText), Mode=OneWay}" Margin="0,0,12,0"
                                                   Opacity="{x:Bind OperatingSystemOpacity, Mode=OneWay}"
                                                   Visibility="{x:Bind Columns.ShowSeparateOs, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind OperatingSystemSource, Mode=OneWay}" />
                                        <TextBlock Grid.Column="8" Text="{x:Bind local:DeviceColumnLayoutHelpers.MetadataText(DeviceTypeText), Mode=OneWay}"
                                                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis" Opacity="{x:Bind DeviceTypeOpacity, Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind DeviceTypeSource, Mode=OneWay}"
                                                   Visibility="{x:Bind Columns.ShowSeparateType, Mode=OneWay}" />
                                        <Button Grid.Column="9" Margin="0,0,12,0" Padding="0" MinWidth="0" MinHeight="0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                                UseSystemFocusVisuals="True" AutomationProperties.AutomationId="UsageCategoryCell"
                                                AutomationProperties.Name="{x:Bind UsageCategoryCellName, Mode=OneWay}"
                                                AutomationProperties.HelpText="{x:Bind UsageCategoryDescription, Mode=OneWay}"
                                                Visibility="{x:Bind Columns.UsageCategory.IsVisible, Mode=OneWay}">
                                            <ToolTipService.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="{x:Bind UsageCategoryDescription, Mode=OneWay}"
                                                               MaxWidth="360" TextWrapping="Wrap" />
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <TextBlock x:Name="UsageCategoryCellDetailsText"
                                                               Text="{x:Bind UsageCategoryDescription, Mode=OneWay}"
                                                               MaxWidth="360" TextWrapping="Wrap" />
                                                </Flyout>
                                            </Button.Flyout>
                                            <Grid HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="6" BorderThickness="1" VerticalAlignment="Center"
                                                        MaxWidth="{x:Bind local:DeviceColumnLayoutHelpers.UsageCategoryBadgeMaximumWidth(Columns.UsageCategory.Width, HasUsageCategoryIndicator), Mode=OneWay}"
                                                        Background="{ThemeResource UsageCategoryBadgeBackgroundBrush}"
                                                        BorderBrush="{ThemeResource UsageCategoryBadgeStrokeBrush}">
                                                    <Grid>
                                                        <Border CornerRadius="5" Background="{ThemeResource UsageCategoryPermanentTintBrush}"
                                                                Visibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(IsPermanentUsageCategory), Mode=OneWay}" />
                                                        <Border CornerRadius="5" Background="{ThemeResource UsageCategoryPersonalTintBrush}"
                                                                Visibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(IsPersonalUsageCategory), Mode=OneWay}" />
                                                        <Border CornerRadius="5" Background="{ThemeResource UsageCategoryGuestTintBrush}"
                                                                Visibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(IsGuestUsageCategory), Mode=OneWay}" />
                                                        <TextBlock x:Name="DeviceUsageCategoryText" Text="{x:Bind UsageCategoryCellText, Mode=OneWay}"
                                                                   Margin="6,2" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock x:Name="DeviceUsageCategoryIndicator" Grid.Column="1"
                                                           Text="{x:Bind UsageCategoryIndicatorGlyph, Mode=OneWay}"
                                                           FontFamily="Segoe Fluent Icons" FontSize="12" Width="12"
                                                           Margin="6,0,0,0" VerticalAlignment="Center" IsTextScaleFactorEnabled="False"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           AutomationProperties.AutomationId="DeviceUsageCategoryIndicator"
                                                           AutomationProperties.AccessibilityView="Raw"
                                                           Visibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(HasUsageCategoryIndicator), Mode=OneWay}" />
                                            </Grid>
                                        </Button>
                                        <Grid Grid.Column="10" Visibility="{x:Bind Columns.ShowMergedRoom, Mode=OneWay}">
                                            <StackPanel x:Name="MergedAssignments" Spacing="{x:Bind Columns.AssignmentSpacing, Mode=OneWay}" VerticalAlignment="Center">
                                                <Grid x:Name="MergedPersonLine" ColumnSpacing="4" HorizontalAlignment="Center" Background="Transparent"
                                                      Visibility="{x:Bind HasPersonAssignment, Mode=OneWay}"
                                                      views:DevicesPageView.PreviewText="{x:Bind PersonAssignmentDescription, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind PersonAssignmentDescription, Mode=OneWay}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <local:PersonIcon IconId="{x:Bind PersonIconId, Mode=OneWay}" FontSize="16"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="MergedPersonValue" Grid.Column="1" Text="{x:Bind PersonShortName, Mode=OneWay}"
                                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                                               AutomationProperties.Name="{x:Bind PersonAssignmentDescription, Mode=OneWay}" />
                                                </Grid>
                                                <Grid x:Name="MergedRoomLine" ColumnSpacing="4" HorizontalAlignment="Center" Background="Transparent"
                                                      Visibility="{x:Bind HasRoomAssignment, Mode=OneWay}"
                                                      views:DevicesPageView.PreviewText="{x:Bind RoomAssignmentDescription, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind RoomAssignmentDescription, Mode=OneWay}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE80F;" FontSize="12" Width="12" Height="12" VerticalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="MergedRoomValue" Grid.Column="1" Text="{x:Bind RoomShortName, Mode=OneWay}"
                                                               FontFamily="Segoe UI Emoji" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               AutomationProperties.Name="{x:Bind RoomAssignmentDescription, Mode=OneWay}" />
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock x:Name="MergedAssignmentsEmpty" Text="-" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind HasNoAssignments, Mode=OneWay}"
                                                       views:DevicesPageView.PreviewText="Person and room: Unassigned"
                                                       AutomationProperties.Name="Person and room: Unassigned" />
                                        </Grid>
                                        <Button Grid.Column="10"
                                                FontSize="12" Style="{StaticResource ScannerAssignmentTextStyle}"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.ShowSeparatePerson), Mode=OneWay}"
                                                Opacity="{x:Bind PersonOpacity, Mode=OneWay}"
                                                views:DevicesPageView.PreviewText="{x:Bind PersonFullName, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind PersonFullName, Mode=OneWay}">
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <local:PersonIcon IconId="{x:Bind PersonIconId, Mode=OneWay}" FontSize="16"
                                                                  Visibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(HasPersonAssignment), Mode=OneWay}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind local:DeviceColumnLayoutHelpers.AssignmentText(PersonId, PersonShortName), Mode=OneWay}"
                                                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="10" Content="{x:Bind local:DeviceColumnLayoutHelpers.AssignmentText(RoomId, RoomShortName), Mode=OneWay}"
                                                FontSize="12" Style="{StaticResource ScannerAssignmentTextStyle}" FontFamily="Segoe UI Emoji"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind local:DeviceColumnLayoutHelpers.ToVisibility(Columns.ShowRoomOnly), Mode=OneWay}"
                                                Opacity="{x:Bind RoomOpacity, Mode=OneWay}"
                                                views:DevicesPageView.PreviewText="{x:Bind RoomFullName, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind RoomFullName, Mode=OneWay}" />
                                        <Button Grid.Column="11" Content="{x:Bind local:DeviceColumnLayoutHelpers.AssignmentText(RoomId, RoomShortName), Mode=OneWay}"
                                                Style="{StaticResource ScannerAssignmentTextStyle}"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe UI Emoji"
                                                Opacity="{x:Bind RoomOpacity, Mode=OneWay}"
                                                Visibility="{x:Bind Columns.ShowSeparateRoom, Mode=OneWay}"
                                                views:DevicesPageView.PreviewText="{x:Bind RoomFullName, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind RoomFullName, Mode=OneWay}" />
                                        <TextBlock x:Name="DeviceLastSeenText" Grid.Column="12" Text="{x:Bind LastSeenText, Mode=OneWay}"
                                                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                                                   Opacity="{x:Bind LastSeenOpacity, Mode=OneWay}"
                                                   Visibility="{x:Bind Columns.LastSeen.IsVisible, Mode=OneWay}"
                                                   views:DevicesPageView.PreviewText="{x:Bind LastSeenDescription, Mode=OneWay}" />
                                        </Grid>
                                        <ItemsControl x:Name="DeviceMacExpansionLines"
                                                      ItemsSource="{x:Bind VisibleMacExpansionLines, Mode=OneWay}"
                                                      Visibility="{x:Bind AreMacAddressesExpanded, Mode=OneWay}"
                                                      AutomationProperties.AutomationId="DeviceMacExpansionLines">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:DeviceMacExpansionLine">
                                                    <Grid MinHeight="30" Padding="{x:Bind local:DeviceColumnLayoutHelpers.RowPadding(Columns.RowVerticalPadding)}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Name.EffectiveWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Addresses.EffectiveWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.VendorOs.EffectiveWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Ports.EffectiveWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Connection.EffectiveWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateResponseWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateMacWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateOsWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateTypeWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.UsageCategory.EffectiveWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.Assignments.EffectiveWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.SeparateRoomWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="{x:Bind local:DeviceColumnLayoutHelpers.ToGridLength(Columns.LastSeen.EffectiveWidth), Mode=OneWay}" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Margin="32,0,12,0" Text="{x:Bind Label}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   AutomationProperties.AutomationId="DeviceMacExpansionLabel"
                                                                   AutomationProperties.Name="{x:Bind AccessibleText}" />
                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0" Spacing="1" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Consolas">
                                                                <Run Text="{x:Bind AddressPrefix}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{x:Bind AddressHost}" FontWeight="SemiBold" />
                                                            </TextBlock>
                                                            <TextBlock Text="{x:Bind Mac}" FontFamily="Consolas" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       Visibility="{x:Bind Columns.ShowMergedMac}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Margin="0,0,12,0" Text="{x:Bind Vendor}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{x:Bind Columns.Vendor.IsVisible}" />
                                                        <TextBlock Grid.Column="4" Margin="0,0,12,0" Text="{x:Bind Status}"
                                                                   AutomationProperties.Name="{x:Bind Status}"
                                                                   Visibility="{x:Bind Columns.Status.IsVisible}" />
                                                        <TextBlock Grid.Column="6" Margin="0,0,12,0" Text="{x:Bind Mac}"
                                                                   FontFamily="Consolas"
                                                                   Visibility="{x:Bind Columns.ShowSeparateMac}" />
                                                        <TextBlock Grid.Column="12" Margin="0,0,12,0" Text="{x:Bind LastSeen}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{x:Bind Columns.LastSeen.IsVisible}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="32,2,12,6" Text="{x:Bind MoreMacAddressesText, Mode=OneWay}"
                                                   AutomationProperties.AutomationId="DeviceMacExpansionMore"
                                                   Visibility="{x:Bind local:DeviceColumnLayoutHelpers.TextVisibility(MoreMacAddressesText), Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
                <Canvas x:Name="PreviewLayer" Grid.Row="1" IsHitTestVisible="False">
                    <Border x:Name="CellPreview" Visibility="Collapsed" Padding="8,4"
                            Background="{ThemeResource ScannerHeaderBackgroundBrush}"
                            BorderBrush="{ThemeResource ScannerCardBorderBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <TextBlock x:Name="CellPreviewText" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock x:Name="HoverTextPalette" Visibility="Collapsed"
                               Foreground="{ThemeResource CellHoverTextBrush}" />
                </Canvas>
                <TextBlock x:Name="EmptyResultsText"
                           Grid.Row="1"
                           Text="Select Scan LAN to probe every address on the detected subnet."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
