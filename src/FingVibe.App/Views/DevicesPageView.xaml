                            <Grid Grid.Column="11" Visibility="{x:Bind Columns.ShowSeparateRoom, Mode=OneWay}">
                                <Button x:Name="RoomSortButton" Tag="Room" Click="SortHeader_Click" Margin="0,0,12,0" MinHeight="0"
                                        Padding="{x:Bind local:DeviceColumnLayoutHelpers.HeaderButtonPadding(Columns.HeaderButtonVerticalPadding), Mode=OneWay}"
                                        Style="{StaticResource ScannerHeaderButtonStyle}" ToolTipService.ToolTip="Sort by room's full name">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Room" FontWeight="SemiBold" />
                                        <TextBlock x:Name="RoomSortGlyph" />
