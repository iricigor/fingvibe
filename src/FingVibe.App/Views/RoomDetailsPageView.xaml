<UserControl
    x:Class="FingVibe.App.Views.RoomDetailsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App"
    xmlns:models="using:FingVibe.Core.Models">
    <Grid Margin="{StaticResource ScannerPageContentMargin}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Identity variant of the shared page header (#670): Back, the room's own 48-DIP symbol with its short-name
             badge beneath it, the name in the shared title style, then Edit and Delete. -->
        <Grid x:Name="RoomDetailHeading" Style="{StaticResource PageHeaderRowStyle}"
              SizeChanged="RoomDetailHeading_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <local:PageBackButton x:Name="RoomBackButton" Destination="People &amp; rooms"
                    AccessibleDestination="people and rooms" BackRequested="BackToRoomsButton_Click"
                    AutomationProperties.AutomationId="RoomBackButton" />
            <FontIcon x:Name="RoomDetailIcon" Grid.Column="1" Width="48" Height="48" FontSize="48"
                      FontFamily="Segoe Fluent Icons" IsTextScaleFactorEnabled="False"
                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                      AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="RoomDetailName" Grid.Column="2" Style="{StaticResource PageHeaderTitleStyle}" />
            <StackPanel x:Name="RoomDetailActions" Grid.Column="3" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <Button x:Name="EditRoomDetailButton" Content="Edit" Click="EditRoomButton_Click" />
                <Button x:Name="DeleteRoomDetailButton" Content="Delete" Click="DeleteRoomButton_Click" />
            </StackPanel>
            <!-- A badge wider than the icon at larger text extends right instead of moving the title. -->
            <TextBlock x:Name="RoomDetailShortName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                       MinWidth="48" Margin="0,4,0,0" HorizontalAlignment="Left" TextAlignment="Center"
                       FontFamily="Segoe UI Emoji" FontSize="18" FontWeight="SemiBold" />
        </Grid>
        <ScrollViewer x:Name="RoomDetailPage" Grid.Row="1">
        <StackPanel Spacing="16">
            <TextBlock x:Name="RoomDetailNotes" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="RoomDeviceCountText" FontWeight="SemiBold" />
                    <TextBlock x:Name="RoomRespondedCountText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource CardHeadingBandStyle}">
                        <Grid Style="{StaticResource CardHeadingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE77B;" Style="{StaticResource CardHeadingIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Assigned devices" Style="{StaticResource CardHeadingTextStyle}" />
                            <Button x:Name="AssignRoomDevicesButton" Grid.Column="2" Content="Assign devices"
                                    Click="AssignRoomDeviceButton_Click" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="RoomAssignedDevicesEmptyText" Text="No devices assigned."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="RoomAssignedDevicesList" IsItemClickEnabled="True"
                              ItemClick="AssignedRoomDevice_ItemClick" AutomationProperties.Name="Assigned devices">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AssignedDeviceListRow">
                                <Grid Padding="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind NameText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind StatusText}" ToolTipService.ToolTip="{x:Bind StatusContext}"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind AddressText}" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind MacAddressText}" FontFamily="Consolas" />
                                    <Button Grid.Column="3" Content="Unassign" Tag="{x:Bind IdentityKey}"
                                            Click="UnassignRoomDeviceButton_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="RoomDetailStatusText" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
