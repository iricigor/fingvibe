<UserControl
    x:Class="FingVibe.App.Views.RoomDetailsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App"
    xmlns:models="using:FingVibe.Core.Models">
    <ScrollViewer x:Name="RoomDetailPage">
        <StackPanel Margin="24,0,24,24" Spacing="16">
            <Button Click="BackToRoomsButton_Click" AutomationProperties.Name="Back to rooms">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Rooms" />
                </StackPanel>
            </Button>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Padding="12,6" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon x:Name="RoomDetailIcon" FontFamily="Segoe Fluent Icons" FontSize="48"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="RoomDetailShortName" FontFamily="Segoe UI Emoji" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="RoomDetailName" Grid.Column="1" FontSize="28"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="EditRoomDetailButton" Grid.Column="2" Content="Edit" Click="EditRoomButton_Click" />
                <Button x:Name="DeleteRoomDetailButton" Grid.Column="3" Content="Delete" Click="DeleteRoomButton_Click" />
            </Grid>
            <TextBlock x:Name="RoomDetailNotes" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="RoomDeviceCountText" FontWeight="SemiBold" />
                    <TextBlock x:Name="RoomRespondedCountText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Assigned devices" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Button x:Name="AssignRoomDevicesButton" Grid.Column="1" Content="Assign devices" Click="AssignRoomDeviceButton_Click" />
            </Grid>
            <TextBlock x:Name="RoomAssignedDevicesEmptyText" Text="No devices assigned."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView x:Name="RoomAssignedDevicesList" IsItemClickEnabled="True"
                      ItemClick="AssignedRoomDevice_ItemClick" AutomationProperties.Name="Assigned devices">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AssignedDeviceListRow">
                        <Grid Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind NameText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind StatusText}" ToolTipService.ToolTip="{x:Bind StatusContext}"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind AddressText}" FontFamily="Consolas" />
                            <TextBlock Grid.Column="2" Text="{x:Bind MacAddressText}" FontFamily="Consolas" />
                            <Button Grid.Column="3" Content="Unassign" Tag="{x:Bind MacAddress}"
                                    Click="UnassignRoomDeviceButton_Click" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="RoomDetailStatusText" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
