<UserControl
    x:Class="FingVibe.App.Views.SettingsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <UserControl.Resources>
        <Style x:Key="SettingsSectionStyle" TargetType="Expander">
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SettingsCardHeaderStyle" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="Padding" Value="0,12" />
        </Style>
        <Style x:Key="SettingsCardIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        </Style>
        <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsCardSummaryStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SettingsNavigationCardStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="Padding" Value="16,0,8,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource ExpanderHeaderBackground}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ExpanderHeaderBorderBrush}" />
            <Setter Property="BorderThickness" Value="{ThemeResource ExpanderHeaderBorderThickness}" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="SettingsPage" Margin="{StaticResource ScannerPageContentMargin}" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:PageHeaderIcon Icon="tools" />
                <TextBlock Grid.Column="1" Text="Settings" Style="{StaticResource ScannerPageTitleStyle}"
                           Margin="0" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="SettingsPage">
        <StackPanel Spacing="16">
            <StackPanel x:Name="SettingsCards" Spacing="4">
            <Expander x:Name="AppearanceSection" Style="{StaticResource SettingsSectionStyle}"
                      AutomationProperties.Name="Appearance preferences">
                <Expander.Header>
                    <Grid Style="{StaticResource SettingsCardHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsCardIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="AppearanceSettingsHeading" Text="Appearance" Style="{StaticResource SettingsCardTitleStyle}" />
                            <TextBlock x:Name="AppearanceSummary" Style="{StaticResource SettingsCardSummaryStyle}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <Grid x:Name="AppearanceOptions" ColumnSpacing="16" RowSpacing="12"
                          SizeChanged="AppearanceOptions_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="ModePicker"
                                  Header="Mode"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="ModePicker_SelectionChanged">
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                        <ComboBox x:Name="ThemePicker"
                                  Grid.Row="1" Grid.ColumnSpan="3"
                                  Header="Theme"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="AppearancePicker_SelectionChanged">
                            <ComboBoxItem Content="Standard" />
                            <ComboBoxItem Content="Warm" />
                            <ComboBoxItem Content="Colorful" />
                        </ComboBox>
                        <ComboBox x:Name="BackdropPicker"
                                  Grid.Row="2" Grid.ColumnSpan="3"
                                  Header="Window backdrop"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="AppearancePicker_SelectionChanged">
                            <ComboBoxItem Content="Solid" />
                            <ComboBoxItem Content="Mica" />
                            <ComboBoxItem Content="Mica Alt" />
                            <ComboBoxItem Content="Acrylic" />
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="AppearanceSaveStatus"
                               Text="Appearance changes apply immediately and save automatically, with material effects depending on Windows transparency settings."
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>
            <Expander x:Name="DevicesSection" Style="{StaticResource SettingsSectionStyle}"
                      AutomationProperties.Name="Devices page preferences">
                <Expander.Header>
                    <Grid Style="{StaticResource SettingsCardHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE772;" Style="{StaticResource SettingsCardIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="DevicesSettingsHeading" Text="Devices page" Style="{StaticResource SettingsCardTitleStyle}" />
                            <TextBlock x:Name="DevicesSummary" Style="{StaticResource SettingsCardSummaryStyle}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="8">
                    <Grid x:Name="DevicePreferences" ColumnSpacing="16" RowSpacing="8"
                          SizeChanged="DevicePreferences_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleSwitch x:Name="CompactRowsSwitch" Loaded="DevicePreferenceSwitch_Loaded"
                                  Header="Compact rows" AutomationProperties.Name="Compact rows"
                                  IsOn="{x:Bind Columns.CompactRows, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Reduce row spacing without shrinking text; turn off for relaxed rows." />
                        <ToggleSwitch x:Name="EnlargedCellPreviews" Grid.Column="1" Loaded="DevicePreferenceSwitch_Loaded"
                                  Header="Cell hover previews"
                                  AutomationProperties.Name="Cell hover emphasis and full-value previews"
                                  IsOn="{x:Bind Columns.EnlargedCellPreviews, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Brighten hovered Devices text and reveal shortened values; turn off to use ordinary tooltips." />
                    </Grid>
                    <TextBlock Text="Choose which information appears and which columns share a compact presentation."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="VisibleColumnsHeading" Text="Visible columns" FontSize="16" FontWeight="SemiBold"
                               Margin="0,8,0,0" />
                    <ItemsControl x:Name="ColumnChoices" ItemsSource="{x:Bind VisibilityChoices}"
                                  Loaded="ColumnChoices_Loaded" SizeChanged="ColumnChoices_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid ColumnSpacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:DeviceColumn">
                                <CheckBox AutomationProperties.Name="{x:Bind Header}"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{x:Bind IsVisible, Mode=TwoWay}"
                                          IsEnabled="{x:Bind CanHide}">
                                    <TextBlock Text="{x:Bind local:DeviceColumnLayoutHelpers.VisibilityChoiceLabel(Header, CanHide)}" TextWrapping="Wrap" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="{ThemeResource ScannerCardBorderBrush}" Margin="0,8,0,4" />
                    <TextBlock x:Name="CombinedColumnsHeading" Text="Combined columns" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="CombinedColumnsDescription" Text="Show each selected pair in one column instead of two."
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid x:Name="CombinationOptions" ColumnSpacing="16" SizeChanged="CombinationOptions_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="CombineNameType" AutomationProperties.Name="Combine Name and Type"
                                  IsChecked="{x:Bind Columns.CombineNameType, Mode=TwoWay}">
                            <TextBlock Text="Name + Device type" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="CombineAddresses" Grid.Row="1" AutomationProperties.Name="Combine IP and MAC"
                                  IsChecked="{x:Bind Columns.CombineAddresses, Mode=TwoWay}">
                            <TextBlock Text="IP address + MAC address" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="CombineStatusResponse" Grid.Row="2" AutomationProperties.Name="Combine Status and Response"
                                  IsChecked="{x:Bind Columns.CombineStatusResponse, Mode=TwoWay}">
                            <TextBlock Text="Status + Response" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="CombinePersonRoom" Grid.Row="3" AutomationProperties.Name="Combine Person and Room"
                                  IsChecked="{x:Bind Columns.CombinePersonRoom, Mode=TwoWay}">
                            <TextBlock Text="Person + Room" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="CombineVendorOs" Grid.Row="4" AutomationProperties.Name="Combine Vendor and OS"
                                  IsChecked="{x:Bind Columns.CombineVendorOs, Mode=TwoWay}">
                            <TextBlock Text="Vendor + OS" TextWrapping="Wrap" />
                        </CheckBox>
                    </Grid>
                    <TextBlock x:Name="TableSaveStatus"
                               Text="Table preferences are saved automatically."
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid x:Name="ColumnFooter" ColumnSpacing="16" RowSpacing="8" Margin="0,4,0,0"
                          SizeChanged="ColumnFooter_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="MandatoryColumnNote"
                                   Grid.ColumnSpan="2"
                                   Text="Name and IP address are always shown so every device remains identifiable."
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="ResetColumnsButton" Grid.Row="1" Grid.ColumnSpan="2"
                                Content="Reset columns" Click="ResetColumnsButton_Click" />
                    </Grid>
                </StackPanel>
            </Expander>
            <Expander x:Name="ScheduledScansSection" Style="{StaticResource SettingsSectionStyle}"
                      AutomationProperties.Name="Background activity preferences">
                <Expander.Header>
                    <Grid Style="{StaticResource SettingsCardHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE787;" Style="{StaticResource SettingsCardIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ScheduledScansHeading" Text="Background activity" Style="{StaticResource SettingsCardTitleStyle}" />
                            <TextBlock x:Name="ScheduledScansSummary" Style="{StaticResource SettingsCardSummaryStyle}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ScheduledScansDescription"
                               Text="Scan the selected LAN automatically while FingVibe is open, including when it is minimized. Scheduled scans pause while Windows sleeps and stop when FingVibe closes."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid x:Name="ScheduledScanOptions" ColumnSpacing="16" RowSpacing="8"
                          SizeChanged="ScheduledScanOptions_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleSwitch x:Name="ScheduledScansSwitch" Loaded="DevicePreferenceSwitch_Loaded"
                                      Header="Scheduled scans" AutomationProperties.Name="Scheduled scans"
                                      Toggled="ScheduledScansSwitch_Toggled"
                                      ToolTipService.ToolTip="Scan the selected LAN at the chosen interval while FingVibe is open." />
                        <ComboBox x:Name="ScanIntervalPicker" Grid.Column="1"
                                  Header="Scan every" AutomationProperties.Name="Scheduled scan interval"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                  SelectionChanged="ScanIntervalPicker_SelectionChanged" />
                    </Grid>
                    <TextBlock x:Name="ScheduledScanStatus"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="ScheduledScanEvidenceNote"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Height="1" Margin="0,4,0,4"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="NetworkMonitoringDisclosure"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch x:Name="NetworkMonitoringSwitch" Loaded="DevicePreferenceSwitch_Loaded"
                                  Header="Monitor network health" AutomationProperties.Name="Monitor network health"
                                  Toggled="NetworkMonitoringSwitch_Toggled"
                                  ToolTipService.ToolTip="Collect raw background ping and DNS observations while FingVibe is open." />
                    <TextBlock x:Name="NetworkMonitorStatusText"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>
            <Button x:Name="AboutSettingsButton" Click="AboutSettingsButton_Click"
                    Style="{StaticResource SettingsNavigationCardStyle}"
                    AutomationProperties.Name="About FingVibe &amp; updates">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Style="{StaticResource SettingsCardHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" Style="{StaticResource SettingsCardIconStyle}" />
                            <Ellipse x:Name="AboutUpdateIndicator" Width="8" Height="8"
                                     Fill="#D97706" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Visibility="Collapsed" IsHitTestVisible="False"
                                     AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="AboutSettingsHeading" Text="About FingVibe &amp; updates" Style="{StaticResource SettingsCardTitleStyle}" />
                            <TextBlock x:Name="AboutSummary" Style="{StaticResource SettingsCardSummaryStyle}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" Width="32" Height="32" Margin="20,0,0,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" IsTextScaleFactorEnabled="False"
                                  IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </Grid>
            </Button>
            </StackPanel>
        </StackPanel>
            </ScrollViewer>
        </Grid>
    <local:AboutPage x:Name="AboutView" Visibility="Collapsed" BackRequested="AboutView_BackRequested" />
    </Grid>
</UserControl>
