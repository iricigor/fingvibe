<UserControl
    x:Class="FingVibe.App.Views.SettingsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <ScrollViewer x:Name="SettingsPage">
        <StackPanel Margin="{StaticResource ScannerPageContentMargin}" Spacing="16">
            <TextBlock Text="Settings" Style="{StaticResource ScannerPageTitleStyle}" Margin="0" />
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid x:Name="AppearanceOptions" ColumnSpacing="16" RowSpacing="12"
                          SizeChanged="AppearanceOptions_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="ModePicker"
                                  Header="Mode"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="ModePicker_SelectionChanged">
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                        <ComboBox x:Name="ThemePicker"
                                  Grid.Row="1" Grid.ColumnSpan="3"
                                  Header="Theme"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="AppearancePicker_SelectionChanged">
                            <ComboBoxItem Content="Standard" />
                            <ComboBoxItem Content="Warm" />
                            <ComboBoxItem Content="Colorful" />
                        </ComboBox>
                        <ComboBox x:Name="BackdropPicker"
                                  Grid.Row="2" Grid.ColumnSpan="3"
                                  Header="Window backdrop"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="AppearancePicker_SelectionChanged">
                            <ComboBoxItem Content="Solid" />
                            <ComboBoxItem Content="Mica" />
                            <ComboBoxItem Content="Mica Alt" />
                            <ComboBoxItem Content="Acrylic" />
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="AppearanceSaveStatus"
                               Text="Appearance changes apply immediately and save automatically, with material effects depending on Windows transparency settings."
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="DevicesSettingsHeading" Text="Devices page" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid x:Name="DevicePreferences" ColumnSpacing="16" RowSpacing="8"
                          SizeChanged="DevicePreferences_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleSwitch x:Name="CompactRowsSwitch" Loaded="DevicePreferenceSwitch_Loaded"
                                  Header="Compact rows" AutomationProperties.Name="Compact rows"
                                  IsOn="{x:Bind Columns.CompactRows, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Reduce row spacing without shrinking text; turn off for relaxed rows." />
                        <ToggleSwitch x:Name="EnlargedCellPreviews" Grid.Column="1" Loaded="DevicePreferenceSwitch_Loaded"
                                  Header="Cell hover previews"
                                  AutomationProperties.Name="Cell hover emphasis and full-value previews"
                                  IsOn="{x:Bind Columns.EnlargedCellPreviews, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Brighten hovered Devices text and reveal shortened values; turn off to use ordinary tooltips." />
                    </Grid>
                    <TextBlock Text="Choose which information appears and which columns share a compact presentation."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="VisibleColumnsHeading" Text="Visible columns" FontSize="16" FontWeight="SemiBold"
                               Margin="0,8,0,0" />
                    <ItemsControl x:Name="ColumnChoices" ItemsSource="{x:Bind VisibilityChoices}"
                                  Loaded="ColumnChoices_Loaded" SizeChanged="ColumnChoices_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid ColumnSpacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:DeviceColumn">
                                <CheckBox AutomationProperties.Name="{x:Bind Header}"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{x:Bind IsVisible, Mode=TwoWay}"
                                          IsEnabled="{x:Bind CanHide}">
                                    <TextBlock Text="{x:Bind local:DeviceColumnLayoutHelpers.VisibilityChoiceLabel(Header, CanHide)}" TextWrapping="Wrap" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="{ThemeResource ScannerCardBorderBrush}" Margin="0,8,0,4" />
                    <TextBlock x:Name="CombinedColumnsHeading" Text="Combined columns" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="CombinedColumnsDescription" Text="Show each selected pair in one column instead of two."
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid x:Name="CombinationOptions" ColumnSpacing="16" SizeChanged="CombinationOptions_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="CombineNameType" AutomationProperties.Name="Combine Name and Type"
                                  IsChecked="{x:Bind Columns.CombineNameType, Mode=TwoWay}">
                            <TextBlock Text="Name + Device type" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="CombineAddresses" Grid.Row="1" AutomationProperties.Name="Combine IP and MAC"
                                  IsChecked="{x:Bind Columns.CombineAddresses, Mode=TwoWay}">
                            <TextBlock Text="IP address + MAC address" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="CombineStatusResponse" Grid.Row="2" AutomationProperties.Name="Combine Status and Response"
                                  IsChecked="{x:Bind Columns.CombineStatusResponse, Mode=TwoWay}">
                            <TextBlock Text="Status + Response" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="CombinePersonRoom" Grid.Row="3" AutomationProperties.Name="Combine Person and Room"
                                  IsChecked="{x:Bind Columns.CombinePersonRoom, Mode=TwoWay}">
                            <TextBlock Text="Person + Room" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="CombineVendorOs" Grid.Row="4" AutomationProperties.Name="Combine Vendor and OS"
                                  IsChecked="{x:Bind Columns.CombineVendorOs, Mode=TwoWay}">
                            <TextBlock Text="Vendor + OS" TextWrapping="Wrap" />
                        </CheckBox>
                    </Grid>
                    <TextBlock x:Name="TableSaveStatus"
                               Text="Table preferences are saved automatically."
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid x:Name="ColumnFooter" ColumnSpacing="16" RowSpacing="8" Margin="0,4,0,0"
                          SizeChanged="ColumnFooter_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="MandatoryColumnNote"
                                   Grid.ColumnSpan="2"
                                   Text="Name and IP address are always shown so every device remains identifiable."
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="ResetColumnsButton" Grid.Row="1" Grid.ColumnSpan="2"
                                Content="Reset columns" Click="ResetColumnsButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ScheduledScansHeading" Text="Scheduled scans" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ScheduledScansDescription"
                               Text="Scan the selected LAN automatically while FingVibe is open, including when it is minimized. Scheduled scans pause while Windows sleeps and stop when FingVibe closes."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid x:Name="ScheduledScanOptions" ColumnSpacing="16" RowSpacing="8"
                          SizeChanged="ScheduledScanOptions_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleSwitch x:Name="ScheduledScansSwitch" Loaded="DevicePreferenceSwitch_Loaded"
                                      Header="Scheduled scans" AutomationProperties.Name="Scheduled scans"
                                      Toggled="ScheduledScansSwitch_Toggled"
                                      ToolTipService.ToolTip="Scan the selected LAN at the chosen interval while FingVibe is open." />
                        <ComboBox x:Name="ScanIntervalPicker" Grid.Column="1"
                                  Header="Scan every" AutomationProperties.Name="Scheduled scan interval"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                  SelectionChanged="ScanIntervalPicker_SelectionChanged" />
                    </Grid>
                    <TextBlock x:Name="ScheduledScanStatus"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="ScheduledScanEvidenceNote"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
