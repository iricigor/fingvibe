<UserControl
    x:Class="FingVibe.App.Views.SettingsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App"
    xmlns:models="using:FingVibe.Core.Models">
    <ScrollViewer x:Name="SettingsPage">
        <StackPanel Margin="24,0,24,24" Spacing="16">
            <TextBlock Text="Settings" Style="{StaticResource ScannerPageTitleStyle}" Margin="0" />
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ComboBox x:Name="BackdropPicker"
                              Header="Window backdrop"
                              MinWidth="240"
                              SelectionChanged="AppearancePicker_SelectionChanged">
                        <ComboBoxItem Content="Solid" />
                        <ComboBoxItem Content="Mica" />
                        <ComboBoxItem Content="Mica Alt" />
                        <ComboBoxItem Content="Acrylic" />
                    </ComboBox>
                    <TextBlock x:Name="BackdropStatus"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="ThemePicker"
                              Header="Theme"
                              MinWidth="240"
                              SelectionChanged="AppearancePicker_SelectionChanged">
                        <ComboBoxItem Content="Standard Light" />
                        <ComboBoxItem Content="Warm Light" />
                        <ComboBoxItem Content="Standard Dark" />
                        <ComboBoxItem Content="True Black (OLED)" />
                    </ComboBox>
                    <TextBlock x:Name="AppearanceSaveStatus"
                               Text="Appearance saved automatically."
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Devices table columns" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Choose which columns appear on the Devices page. Column choices and widths last until FingVibe closes."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{x:Bind Columns.All}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:DeviceColumn">
                                <CheckBox Content="{x:Bind Header}"
                                          IsChecked="{x:Bind IsVisible, Mode=TwoWay}"
                                          IsEnabled="{x:Bind CanHide}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="IP address is always shown so every device remains identifiable."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Reset columns" Click="ResetColumnsButton_Click" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
