<Window
    x:Class="FingVibe.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FingVibe.App"
    xmlns:views="using:FingVibe.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FingVibe LAN Scanner">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" Background="{ThemeResource ScannerPageBackgroundBrush}">
        <NavigationView x:Name="MainNavigation"
                        PaneDisplayMode="Auto"
                        IsPaneToggleButtonVisible="True"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="280"
                        AutomationProperties.Name="Main menu"
                        ItemInvoked="MainNavigation_ItemInvoked"
                        SelectionChanged="MainNavigation_SelectionChanged">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <Style x:Key="SidebarOverviewIconStyle" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="#C45D16" />
                            </Style>
                            <Style x:Key="SidebarNetworkIconStyle" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="#0078B8" />
                            </Style>
                            <Style x:Key="SidebarDevicesIconStyle" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="#6253C4" />
                            </Style>
                            <Style x:Key="SidebarPeopleIconStyle" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="#008575" />
                            </Style>
                            <Style x:Key="SidebarRoomsIconStyle" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="#B34177" />
                            </Style>
                            <Style x:Key="SidebarToolsIconStyle" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="#9A6700" />
                            </Style>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <Style x:Key="SidebarOverviewIconStyle" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="#FFAB66" />
                            </Style>
                            <Style x:Key="SidebarNetworkIconStyle" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="#60CDFF" />
                            </Style>
                            <Style x:Key="SidebarDevicesIconStyle" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="#B4A0FF" />
                            </Style>
                            <Style x:Key="SidebarPeopleIconStyle" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="#5BD6C3" />
                            </Style>
                            <Style x:Key="SidebarRoomsIconStyle" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="#F093BE" />
                            </Style>
                            <Style x:Key="SidebarToolsIconStyle" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="#F9CF58" />
                            </Style>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <!-- Inherit native selected/hover foregrounds instead of fixing a decorative color. -->
                            <Style x:Key="SidebarOverviewIconStyle" TargetType="FontIcon" />
                            <Style x:Key="SidebarNetworkIconStyle" TargetType="FontIcon" />
                            <Style x:Key="SidebarDevicesIconStyle" TargetType="FontIcon" />
                            <Style x:Key="SidebarPeopleIconStyle" TargetType="FontIcon" />
                            <Style x:Key="SidebarRoomsIconStyle" TargetType="FontIcon" />
                            <Style x:Key="SidebarToolsIconStyle" TargetType="FontIcon" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                    <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                    <Thickness x:Key="NavigationViewItemMargin">4,2</Thickness>
                    <x:Double x:Key="NavigationViewItemOnLeftMinHeight">40</x:Double>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.PaneCustomContent>
                <StackPanel Margin="12,16,12,24" Orientation="Horizontal" Spacing="12"
                            Visibility="{x:Bind MainNavigation.IsPaneOpen, Mode=OneWay}">
                    <Border Width="48"
                            Height="48"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="12">
                        <FontIcon Glyph="&#xE8FE;" FontSize="24" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="FingVibe" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="LAN scanner" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneCustomContent>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewNavItem" Content="Overview" Tag="Overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" Style="{ThemeResource SidebarOverviewIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NetworkNavItem" Content="Network" Tag="Network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" Style="{ThemeResource SidebarNetworkIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DevicesNavItem" Content="Devices" Tag="Devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE772;" Style="{ThemeResource SidebarDevicesIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PeopleNavItem" Content="People" Tag="People">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" Style="{ThemeResource SidebarPeopleIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="RoomsNavItem" Content="Rooms" Tag="Rooms">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE707;" Style="{ThemeResource SidebarRoomsIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="ToolsNavItem" Content="Tools" Tag="Tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" Style="{ThemeResource SidebarToolsIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="BuildHeader" SizeChanged="BuildHeader_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Canvas x:Name="BuildRibbonArea" Grid.Column="1" Width="280" Height="180"
                            Visibility="Collapsed">
                        <Canvas.Clip>
                            <RectangleGeometry Rect="0,0,280,180" />
                        </Canvas.Clip>
                        <Button x:Name="BuildRibbon" Canvas.Left="5" Canvas.Top="55"
                                Width="320" Height="60" CornerRadius="0" Padding="12,6"
                                RenderTransformOrigin="0.5,0.5" Click="BuildRibbon_Click"
                                ToolTipService.ToolTip="Acknowledge this build (hide ribbon until the app closes)">
                            <Button.RenderTransform>
                                <RotateTransform Angle="35" />
                            </Button.RenderTransform>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="BuildRibbonText" FontWeight="SemiBold" FontSize="13"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="BuildRibbonTimestampText" FontSize="12"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Canvas>
                    <Grid x:Name="ScanBar" Margin="24,16,24,16" ColumnSpacing="12" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="NetworkPicker"
                                  MinWidth="150"
                                  MaxWidth="360"
                                  HorizontalAlignment="Left"
                                  Header="Detected network"
                                  SelectionChanged="NetworkPicker_SelectionChanged" />
                        <Button x:Name="ScanButton"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="ScanButton_Click"
                                AutomationProperties.Name="Scan LAN"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" />
                                <TextBlock Text="Scan LAN" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelButton"
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Click="CancelButton_Click"
                                Content="Cancel"
                                Visibility="Collapsed"
                                IsEnabled="False" />
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="4" Margin="0,8,0,0">
                            <TextBlock x:Name="ScanStatusText"
                                       Text="Ready"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressBar x:Name="ScanProgressBar"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="0"
                                         Visibility="Collapsed"
                                         Height="4" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Overview -->
                <views:OverviewPageView x:Name="OverviewPage" Grid.Row="1"
                        NetworkRequested="ViewNetworkButton_Click"
                        OnlineDevicesRequested="OnlineDevicesCard_Click"
                        OpenPortDevicesRequested="OpenPortDevicesCard_Click"
                        AboutRequested="AboutFingVibe_Click" />

                <!-- Network -->
                <views:NetworkPageView x:Name="NetworkPage" Grid.Row="1" Visibility="Collapsed" />

                <!-- Devices -->
                <views:DevicesPageView x:Name="DevicesPage" Grid.Row="1" Visibility="Collapsed"
                        FiltersChanged="DeviceFiltersChanged"
                        SortRequested="DeviceSortRequested"
                        DeviceRequested="DeviceRequested" />

                <!-- Device details -->
                <views:DeviceDetailsPageView x:Name="DevicePage" Grid.Row="1" Visibility="Collapsed"
                        BackRequested="BackToDevicesButton_Click"
                        NameChanged="DeviceNameInput_TextChanged"
                        NameSaveRequested="DeviceNameSaveButton_Click"
                        NameResetRequested="DeviceNameResetButton_Click"
                        PortScanRequested="DevicePortScanButton_Click"
                        ClassificationChanged="ClassificationPicker_SelectionChanged"
                        ClassificationSaveRequested="DeviceClassificationSaveButton_Click"
                        ClassificationResetRequested="DeviceClassificationResetButton_Click"
                        PersonAssignmentRequested="DevicePersonAssignmentRequested"
                        RoomAssignmentRequested="DeviceRoomAssignmentRequested"
                        AddressRequested="DeviceAddressRequested" />

                <!-- People -->
                <views:PeoplePageView x:Name="PeoplePage" Grid.Row="1" Visibility="Collapsed"
                        SearchChanged="PeopleSearchBox_TextChanged"
                        AddRequested="AddPersonButton_Click"
                        PersonRequested="PersonRequested"
                        EditRequested="PersonEditRequested"
                        DeleteRequested="PersonDeleteRequested" />

                <!-- Rooms -->
                <views:RoomsPageView x:Name="RoomsPage" Grid.Row="1" Visibility="Collapsed"
                        SearchChanged="RoomsSearchBox_TextChanged"
                        AddRequested="AddRoomButton_Click"
                        RoomRequested="RoomRequested"
                        EditRequested="RoomEditRequested"
                        DeleteRequested="RoomDeleteRequested" />

                <views:PersonDetailsPageView x:Name="PersonDetailPage" Grid.Row="1" Visibility="Collapsed"
                        BackRequested="BackToPeopleButton_Click"
                        EditRequested="EditPersonButton_Click"
                        DeleteRequested="DeletePersonButton_Click"
                        AssignRequested="AssignPersonDeviceButton_Click"
                        UnassignRequested="PersonUnassignRequested"
                        DeviceRequested="DeviceRequested" />

                <views:RoomDetailsPageView x:Name="RoomDetailPage" Grid.Row="1" Visibility="Collapsed"
                        BackRequested="BackToRoomsButton_Click"
                        EditRequested="EditRoomButton_Click"
                        DeleteRequested="DeleteRoomButton_Click"
                        AssignRequested="AssignRoomDeviceButton_Click"
                        UnassignRequested="RoomUnassignRequested"
                        DeviceRequested="DeviceRequested" />

                <!-- Tools -->
                <local:ToolsPage x:Name="ToolsPage" Grid.Row="1" Visibility="Collapsed" />

                <!-- Settings -->
                <views:SettingsPageView x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed"
                        AppearanceChanged="AppearancePicker_SelectionChanged" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
