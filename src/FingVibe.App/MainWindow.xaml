<Window
    x:Class="FingVibe.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FingVibe.App"
    xmlns:models="using:FingVibe.Core.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FingVibe LAN Scanner">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" Background="{ThemeResource ScannerPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,28,32,18" Orientation="Horizontal" Spacing="14">
            <Border Width="48"
                    Height="48"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="12">
                <FontIcon Glyph="&#xE8FE;" FontSize="24" Foreground="White" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="FingVibe" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Fast, native LAN discovery for Windows 11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="32,0,32,16"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ScannerCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid ColumnSpacing="24" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="2" Text="Detected network" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="NetworkPicker"
                          Grid.Row="1"
                          Grid.ColumnSpan="2"
                          Margin="0,4,0,0"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="NetworkPicker_SelectionChanged" />
                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock Text="Machine IPv4 address"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="MachineAddressText" Text="Detecting..." FontSize="16" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                    <TextBlock Text="LAN address"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="LanAddressText" Text="Detecting..." FontSize="16" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="32,0,32,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ScanButton"
                    Click="ScanButton_Click"
                    Content="Scan LAN"
                    Style="{ThemeResource AccentButtonStyle}" />
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Click="CancelButton_Click"
                    Content="Cancel"
                    IsEnabled="False" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="ScanStatusText"
                           Text="Ready"
                           HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="ScanProgressBar"
                             Minimum="0"
                             Maximum="1"
                             Value="0"
                             Height="4" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Margin="32,0,32,28"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ScannerCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE71C;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Scan results" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="ResultCountText"
                                   Text="0 hosts"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="ResultFilter"
                              Grid.Column="1"
                              MinWidth="150"
                              Header="Show"
                              SelectionChanged="ResultFilter_SelectionChanged">
                        <ComboBoxItem Content="All hosts" />
                        <ComboBoxItem Content="Alive only" />
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="1" Padding="8,4" Background="{ThemeResource ScannerHeaderBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <Button Tag="Address" Click="SortHeader_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="IP address" FontWeight="SemiBold" />
                            <TextBlock x:Name="AddressSortGlyph" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Tag="Status" Click="SortHeader_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Status" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusSortGlyph" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Tag="Response" Click="SortHeader_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Response" FontWeight="SemiBold" />
                            <TextBlock x:Name="ResponseSortGlyph" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Tag="MacAddress" Click="SortHeader_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="MAC address" FontWeight="SemiBold" />
                            <TextBlock x:Name="MacAddressSortGlyph" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ListView x:Name="ResultsList" Grid.Row="2">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ScanResult">
                            <Grid Padding="8,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                   <ColumnDefinition Width="1.5*" />
                               </Grid.ColumnDefinitions>
                               <TextBlock Text="{x:Bind AddressText}" />
                               <TextBlock Grid.Column="1"
                                          Text="{x:Bind StatusText}"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          FontWeight="SemiBold" />
                               <TextBlock Grid.Column="2" Text="{x:Bind RoundtripText}" />
                               <TextBlock Grid.Column="3" Text="{x:Bind MacAddressText}" FontFamily="Consolas" />
                           </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyResultsText"
                           Grid.Row="2"
                           Text="Select Scan LAN to probe every address on the detected subnet."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
