<Window
    x:Class="FingVibe.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FingVibe.App"
    xmlns:views="using:FingVibe.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FingVibe LAN Scanner">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" Background="{ThemeResource ScannerPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" MinHeight="40" Background="{ThemeResource ScannerHeaderBackgroundBrush}"
              LayoutUpdated="AppTitleBar_LayoutUpdated">
            <Grid.Resources>
                <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="{ThemeResource TextFillColorPrimary}" />
                <SolidColorBrush x:Key="TitleBarSecondaryBrush" Color="{ThemeResource TextFillColorSecondary}" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInset" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInset" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBarDragArea" Grid.Column="1" Background="Transparent" Padding="16,4,12,4"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="24" Height="24" Source="ms-appx:///Assets/ConnectedHome-48.png"
                       IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="TitleBarAppName" Grid.Column="1" Text="FingVibe" FontSize="14"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleBarBuildText" Grid.Column="2" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid Grid.Column="2" Margin="0,4,8,4" VerticalAlignment="Center">
                <Button x:Name="TitleBarAppearanceButton" Width="32" Height="32" Padding="0"
                        Background="Transparent" Click="TitleBarAppearanceButton_Click"
                        AutomationProperties.AutomationId="TitleBarAppearanceButton"
                        AutomationProperties.Name="Appearance mode: Dark">
                    <FontIcon x:Name="TitleBarAppearanceIcon" Glyph="&#xE708;" FontSize="16"
                              IsTextScaleFactorEnabled="False" />
                </Button>
                <InfoBadge x:Name="TitleBarAppearanceBadge" Visibility="Collapsed"
                           HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                           Style="{ThemeResource CriticalIconInfoBadgeStyle}"
                           AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </Grid>
        <NavigationView x:Name="MainNavigation" Grid.Row="1"
                        PaneDisplayMode="Auto"
                        IsPaneToggleButtonVisible="True"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="216"
                        AutomationProperties.Name="Main menu"
                        ItemInvoked="MainNavigation_ItemInvoked"
                        SelectionChanged="MainNavigation_SelectionChanged">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <Style x:Key="SidebarOverviewIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                                <Setter Property="Foreground" Value="#C45D16" />
                            </Style>
                            <Style x:Key="SidebarNetworkIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                                <Setter Property="Foreground" Value="#0078B8" />
                            </Style>
                            <Style x:Key="SidebarDevicesIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                                <Setter Property="Foreground" Value="#6253C4" />
                            </Style>
                            <Style x:Key="SidebarPeopleRoomsIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                                <Setter Property="Foreground" Value="#008575" />
                            </Style>
                            <Style x:Key="SidebarToolsIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                                <Setter Property="Foreground" Value="#9A6700" />
                            </Style>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <Style x:Key="SidebarOverviewIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                                <Setter Property="Foreground" Value="#FFAB66" />
                            </Style>
                            <Style x:Key="SidebarNetworkIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                                <Setter Property="Foreground" Value="#60CDFF" />
                            </Style>
                            <Style x:Key="SidebarDevicesIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                                <Setter Property="Foreground" Value="#B4A0FF" />
                            </Style>
                            <Style x:Key="SidebarPeopleRoomsIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                                <Setter Property="Foreground" Value="#5BD6C3" />
                            </Style>
                            <Style x:Key="SidebarToolsIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                                <Setter Property="Foreground" Value="#F9CF58" />
                            </Style>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <!-- Inherit native selected/hover foregrounds instead of fixing a decorative color. -->
                            <Style x:Key="SidebarOverviewIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                            </Style>
                            <Style x:Key="SidebarNetworkIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                            </Style>
                            <Style x:Key="SidebarDevicesIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                            </Style>
                            <Style x:Key="SidebarPeopleRoomsIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                            </Style>
                            <Style x:Key="SidebarToolsIconStyle" TargetType="BitmapIcon">
                                <Setter Property="ShowAsMonochrome" Value="True" />
                            </Style>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                    <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                    <Thickness x:Key="NavigationViewItemMargin">4,2</Thickness>
                    <x:Double x:Key="NavigationViewItemOnLeftMinHeight">40</x:Double>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.PaneCustomContent>
                <Grid Margin="8,16,8,24" ColumnSpacing="8"
                      Visibility="{x:Bind MainNavigation.IsPaneOpen, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="48" Height="48" Source="ms-appx:///Assets/ConnectedHome-48.png" Stretch="Uniform"
                           IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="NavigationBrandName" Text="FingVibe" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="LAN scanner" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneCustomContent>
            <!-- Family icons use a 24-DIP icon box with 48 px masks; BitmapIcon point-samples, so 2x art stays crisp.
                 The override is per item so Settings keeps the native 16-DIP glyph. -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewNavItem" Content="Overview" Tag="Overview">
                    <NavigationViewItem.Resources>
                        <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
                    </NavigationViewItem.Resources>
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/PageIcons/overview-mono-48.png"
                                    Style="{ThemeResource SidebarOverviewIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NetworkNavItem" Content="Network" Tag="Network">
                    <NavigationViewItem.Resources>
                        <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
                    </NavigationViewItem.Resources>
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/PageIcons/network-mono-48.png"
                                    Style="{ThemeResource SidebarNetworkIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DevicesNavItem" Content="Devices" Tag="Devices">
                    <NavigationViewItem.Resources>
                        <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
                    </NavigationViewItem.Resources>
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/PageIcons/devices-mono-48.png"
                                    Style="{ThemeResource SidebarDevicesIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PeopleRoomsNavItem" Content="People &amp; rooms" Tag="PeopleRooms">
                    <NavigationViewItem.Resources>
                        <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
                    </NavigationViewItem.Resources>
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/PageIcons/people-rooms-mono-48.png"
                                    Style="{ThemeResource SidebarPeopleRoomsIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="ToolsNavItem" Content="Tools" Tag="Tools">
                    <NavigationViewItem.Resources>
                        <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
                    </NavigationViewItem.Resources>
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/PageIcons/tools-mono-48.png"
                                    Style="{ThemeResource SidebarToolsIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Quick Light/Dark choice beside Settings; it shares Settings' saved appearance. -->
                <NavigationViewItem x:Name="AppearanceShortcutNavItem" Content="Dark mode" SelectsOnInvoked="False"
                                    AutomationProperties.AutomationId="AppearanceShortcutNavItem">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="AppearanceShortcutIcon" Glyph="&#xE708;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="AppearanceShortcutBadge" Visibility="Collapsed"
                                   Style="{ThemeResource CriticalIconInfoBadgeStyle}"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </NavigationViewItem.InfoBadge>
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="AppearanceShortcutFlyout" Placement="RightEdgeAlignedBottom">
                            <StackPanel Spacing="8" MaxWidth="280">
                                <RadioButtons x:Name="AppearanceShortcutModes" Header="Appearance mode"
                                              AutomationProperties.AutomationId="AppearanceShortcutModes"
                                              SelectionChanged="AppearanceShortcutModes_SelectionChanged">
                                    <RadioButton x:Name="AppearanceShortcutLight" Content="Light"
                                                 AutomationProperties.AutomationId="AppearanceShortcutLight" />
                                    <RadioButton x:Name="AppearanceShortcutDark" Content="Dark"
                                                 AutomationProperties.AutomationId="AppearanceShortcutDark" />
                                </RadioButtons>
                                <TextBlock x:Name="AppearanceShortcutHighContrastNote" Visibility="Collapsed"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="AppearanceShortcutHighContrastNote"
                                           Text="Windows high contrast colors currently apply. Your choice is saved for when high contrast ends." />
                                <TextBlock x:Name="AppearanceShortcutSaveStatus" Visibility="Collapsed"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="AppearanceShortcutSaveStatus"
                                           AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="ScanHeader" Margin="12,16,224,8" SizeChanged="ScanHeader_SizeChanged">
                    <Grid x:Name="ScanBar" ColumnSpacing="12" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="NetworkLabelPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="DetectedNetworkLabel" Text="Network:" VerticalAlignment="Center" />
                            <Button x:Name="NetworkMonitorIndicator" Click="NetworkMonitorIndicator_Click"
                                    Width="28" Height="28" Padding="0" MinWidth="0" MinHeight="0"
                                    Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="NetworkMonitorIndicator"
                                    AutomationProperties.Name="Network monitoring: Monitoring off. Opens Network health.">
                                <Grid Width="18" Height="18" IsHitTestVisible="False">
                                    <Ellipse x:Name="NetworkMonitorPulse" Width="10" Height="10" StrokeThickness="2"
                                             Opacity="0" RenderTransformOrigin="0.5,0.5"
                                             Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                             AutomationProperties.AccessibilityView="Raw">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="NetworkMonitorPulseScale" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="NetworkMonitorDot" Width="10" Height="10" StrokeThickness="1.5"
                                             Style="{StaticResource NetworkMonitorDotOffStyle}"
                                             AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <ComboBox x:Name="NetworkPicker"
                                  Grid.Column="1"
                                  MinWidth="150"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Network"
                                  SelectionChanged="NetworkPicker_SelectionChanged" />
                        <TextBlock x:Name="ScanFreshnessText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid x:Name="ScanActions" Grid.Column="2" MinWidth="120">
                            <Button x:Name="ScanButton"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="False"
                                    Click="ScanButton_Click" AutomationProperties.Name="Scan LAN"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE895;" FontSize="16" VerticalAlignment="Center"
                                              IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Text="Scan LAN" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="CancelButton"
                                    HorizontalAlignment="Stretch"
                                    Click="CancelButton_Click"
                                    AutomationProperties.Name="Cancel scan"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="Collapsed"
                                    IsEnabled="False">
                                <TextBlock Text="Cancel scan" TextWrapping="Wrap" />
                            </Button>
                        </Grid>
                        <StackPanel x:Name="ScanMessages" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4"
                                    Margin="0,4,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ScanStatusText"
                                       Text="Ready"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid x:Name="ScanProgressArea" Visibility="Collapsed" Height="10"
                                  SizeChanged="ScanProgressArea_SizeChanged">
                                <ProgressBar x:Name="ScanProgressBar"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="0"
                                             Height="10" MinHeight="8" VerticalAlignment="Stretch"
                                             AutomationProperties.Name="Scan progress">
                                    <ProgressBar.Resources>
                                        <x:Double x:Key="ProgressBarMinHeight">8</x:Double>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                                <Border x:Name="ScanPulse" Height="8" VerticalAlignment="Center"
                                        HorizontalAlignment="Left" IsHitTestVisible="False"
                                        AutomationProperties.AccessibilityView="Raw">
                                    <Border.Background>
                                        <LinearGradientBrush x:Name="ScanPulseBrush" StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0" />
                                            <GradientStop Color="#B3FFFFFF" Offset="0.5" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Overview -->
                <views:OverviewPageView x:Name="OverviewPage" Grid.Row="1"
                        NetworkRequested="ViewNetworkButton_Click"
                        OnlineDevicesRequested="OnlineDevicesCard_Click"
                        OpenPortDevicesRequested="OpenPortDevicesCard_Click"
                        AboutRequested="AboutFingVibe_Click" />

                <!-- Network -->
                <views:NetworkPageView x:Name="NetworkPage" Grid.Row="1" Visibility="Collapsed"
                        NetworkHealthRequested="NetworkHealthRequested" />

                <!-- Devices -->
                <views:DevicesPageView x:Name="DevicesPage" Grid.Row="1" Visibility="Collapsed"
                        FiltersChanged="DeviceFiltersChanged"
                        SortRequested="DeviceSortRequested"
                        DeviceRequested="DeviceRequested"
                        MatchSuggestionRequested="DeviceMatchSuggestionRequested"
                        ServiceDiscoveryRequested="DeviceServiceDiscoveryRequested" />

                <!-- Device details -->
                <views:DeviceDetailsPageView x:Name="DevicePage" Grid.Row="1" Visibility="Collapsed"
                        BackRequested="BackToDevicesButton_Click"
                        NameChanged="DeviceNameInput_TextChanged"
                        NameSaveRequested="DeviceNameSaveButton_Click"
                        NameResetRequested="DeviceNameResetButton_Click"
                        PortScanRequested="DevicePortScanButton_Click"
                        FullPortScanRequested="DeviceFullPortScanRequested"
                        ClassificationChanged="ClassificationPicker_SelectionChanged"
                        ClassificationSaveRequested="DeviceClassificationSaveButton_Click"
                        ClassificationResetRequested="DeviceClassificationResetButton_Click"
                        PersonAssignmentRequested="DevicePersonAssignmentRequested"
                        RoomAssignmentRequested="DeviceRoomAssignmentRequested"
                        AddressRequested="DeviceAddressRequested"
                        MatchDeclineRequested="DeviceMatchDeclineRequested"
                        LinkRequested="DeviceLinkRequested"
                        UnlinkRequested="DeviceUnlinkRequested" />

                <!-- People and rooms -->
                <views:PeopleRoomsPageView x:Name="PeopleRoomsPage" Grid.Row="1" Visibility="Collapsed"
                        AddRequested="AddPersonButton_Click"
                        RoomMapRequested="ViewRoomMapButton_Click"
                        PersonRequested="PersonRequested"
                        EditRequested="PersonEditRequested"
                        DeleteRequested="PersonDeleteRequested"
                        AddRoomRequested="AddRoomButton_Click"
                        RoomRequested="RoomRequested"
                        EditRoomRequested="RoomEditRequested"
                        DeleteRoomRequested="RoomDeleteRequested" />

                <views:PersonDetailsPageView x:Name="PersonDetailPage" Grid.Row="1" Visibility="Collapsed"
                        BackRequested="BackToPeopleButton_Click"
                        EditRequested="EditPersonButton_Click"
                        DeleteRequested="DeletePersonButton_Click"
                        AssignRequested="AssignPersonDeviceButton_Click"
                        UnassignRequested="PersonUnassignRequested"
                        DeviceRequested="DeviceRequested" />

                <views:RoomDetailsPageView x:Name="RoomDetailPage" Grid.Row="1" Visibility="Collapsed"
                        BackRequested="BackToRoomsButton_Click"
                        EditRequested="EditRoomButton_Click"
                        DeleteRequested="DeleteRoomButton_Click"
                        AssignRequested="AssignRoomDeviceButton_Click"
                        UnassignRequested="RoomUnassignRequested"
                        DeviceRequested="DeviceRequested" />

                <!-- Room map -->
                <views:RoomMapPageView x:Name="RoomMapPage" Grid.Row="1" Visibility="Collapsed"
                        BackToRoomsRequested="BackToRoomsFromMapButton_Click"
                        DeviceRequested="RoomMapDeviceRequested"
                        RoomRequested="RoomMapRoomRequested" />

                <!-- Tools -->
                <local:ToolsPage x:Name="ToolsPage" Grid.Row="1" Visibility="Collapsed"
                        RoomMapRequested="ViewRoomMapFromToolsButton_Click" />

                <!-- Settings -->
                <views:SettingsPageView x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed"
                        AppearanceChanged="AppearancePicker_SelectionChanged" />
            </Grid>
        </NavigationView>
        <local:ColumnResizeGrip x:Name="NavigationResizeGrip"
                               Grid.Row="1"
                               Width="16"
                               HorizontalAlignment="Left"
                               Foreground="{ThemeResource ScannerNavigationDividerBrush}"
                               RevealSeparatorOnInteraction="True"
                               SeparatorVisibility="Collapsed"
                               ResizeRequested="NavigationResizeGrip_ResizeRequested"
                               ResizeCompleted="NavigationResizeGrip_ResizeCompleted"
                               AutomationProperties.Name="Resize navigation"
                               AutomationProperties.HelpText="Drag to resize the menu. Use Left or Right arrow keys; hold Shift for larger steps. Below 160 DIPs, only icons are shown."
                               ToolTipService.ToolTip="Resize navigation" />
        <Canvas x:Name="BuildRibbonArea" Grid.Row="1" Width="200" Height="124"
                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
            <Canvas.Clip>
                <RectangleGeometry Rect="0,0,200,124" />
            </Canvas.Clip>
            <Button x:Name="BuildRibbon" Canvas.Left="-90" Canvas.Top="23"
                    Width="440" Height="44" CornerRadius="0" Padding="12,2"
                    UseSystemFocusVisuals="False" BorderThickness="0"
                    GotFocus="BuildRibbon_FocusChanged" LostFocus="BuildRibbon_FocusChanged"
                    RenderTransformOrigin="0.5,0.5" Click="BuildRibbon_Click">
                <Button.RenderTransform>
                    <RotateTransform Angle="35" />
                </Button.RenderTransform>
                <StackPanel Spacing="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="BuildRibbonText" FontWeight="SemiBold" FontSize="11"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="BuildRibbonTimestampText" FontSize="10"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </Canvas>
    </Grid>
</Window>
