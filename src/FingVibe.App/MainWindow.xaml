<Window
    x:Class="FingVibe.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FingVibe.App"
    xmlns:models="using:FingVibe.Core.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FingVibe LAN Scanner">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,28,32,18" Spacing="6">
            <TextBlock Text="FingVibe" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Fast, native LAN discovery for Windows 11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="32,0,32,16"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid ColumnSpacing="24" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="2" Text="Detected network" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="NetworkPicker"
                          Grid.Row="1"
                          Grid.ColumnSpan="2"
                          Margin="0,4,0,0"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="NetworkPicker_SelectionChanged" />
                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock Text="Machine IPv4 address"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="MachineAddressText" Text="Detecting..." FontSize="16" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                    <TextBlock Text="LAN address"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="LanAddressText" Text="Detecting..." FontSize="16" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="32,0,32,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ScanButton"
                    Click="ScanButton_Click"
                    Content="Scan LAN"
                    Style="{ThemeResource AccentButtonStyle}" />
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Click="CancelButton_Click"
                    Content="Cancel"
                    IsEnabled="False" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="ScanStatusText"
                           Text="Ready"
                           HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="ScanProgressBar"
                             Minimum="0"
                             Maximum="1"
                             Value="0"
                             Height="4" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Margin="32,0,32,28"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="IP address" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Vendor" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Open ports" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Response" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="ResultsList" Grid.Row="1">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ScanResult">
                            <Grid Padding="8,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind NameText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind AddressText}" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind VendorText}"
                                           TextTrimming="CharacterEllipsis" />
                                <ItemsControl Grid.Column="3" ItemsSource="{x:Bind OpenPortItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:OpenPort">
                                            <FontIcon FontFamily="Segoe Fluent Icons"
                                                      FontSize="16"
                                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                      Glyph="{Binding Port, Converter={StaticResource PortIconGlyphConverter}}"
                                                      AutomationProperties.Name="{Binding AccessibleLabel}"
                                                      ToolTipService.ToolTip="{Binding AccessibleLabel}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="4" Text="{x:Bind StatusText}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind RoundtripText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyResultsText"
                           Grid.Row="1"
                           Text="Select Scan LAN to probe every address on the detected subnet."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
