<UserControl
    x:Class="FingVibe.App.DiscoveryPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE968;" FontSize="28" VerticalAlignment="Top" Margin="0,6,0,0" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="TitleText" AutomationProperties.AutomationId="DiscoveryPopup"
                           FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ContextText" TextWrapping="Wrap" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="2" Click="Dismiss_Click" VerticalAlignment="Top"
                    AutomationProperties.Name="Close discoveries" AutomationProperties.AutomationId="DiscoveryPopupClose"
                    Style="{StaticResource SubtleButtonStyle}" Padding="8">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" AutomationProperties.AutomationId="DiscoveryList"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Entries">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DiscoveryPopupItem">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,12"
                                    Background="Transparent" BorderThickness="0" CornerRadius="4"
                                    AutomationProperties.AutomationId="{x:Bind Device.AutomationId}"
                                    AutomationProperties.Name="{x:Bind AccessibleName}"
                                    IsEnabled="{x:Bind DetailsAvailable}" Click="Device_Click" Tag="{x:Bind Device.IdentityKey}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Device.IconGlyph}" FontSize="24" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{x:Bind Device.Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Device.Addresses}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind DetailsStatus}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="2" Padding="0,12,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Saved locally" VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Content="Dismiss" Click="Dismiss_Click" Margin="12,0,0,0"
                    AutomationProperties.AutomationId="CloseDiscoveryPopup" />
        </Grid>
    </Grid>
</UserControl>
