<UserControl
    x:Class="FingVibe.App.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <Grid Margin="{StaticResource ScannerPageContentMargin}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeaderRowStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:PageBackButton x:Name="BackToSettingsButton" Destination="Settings" BackRequested="Back_Click" />
            <local:PageHeaderIcon Grid.Column="1" Icon="about" />
            <TextBlock x:Name="PageHeading" Grid.Column="2" Text="About FingVibe"
                       Style="{StaticResource PageHeaderTitleStyle}" IsTabStop="True" />
        </Grid>
        <ScrollViewer x:Name="UpdatesScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="12">
                <Border Style="{StaticResource CardHeadingBandStyle}">
                    <Grid Style="{StaticResource CardHeadingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" Style="{StaticResource CardHeadingIconStyle}" />
                        <TextBlock Grid.Column="1" Text="FingVibe LAN Scanner" Style="{StaticResource CardHeadingTextStyle}" />
                    </Grid>
                </Border>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="AboutAppIcon" Grid.Column="1" Width="128" Height="128" VerticalAlignment="Top"
                           Source="ms-appx:///Assets/ConnectedHome.png" Stretch="Uniform"
                           IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="VersionText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="BuildKindText" TextWrapping="Wrap" />
                        <TextBlock x:Name="BuildTimestampText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="Open-source network discovery, by Igor." TextWrapping="Wrap" />
                        <TextBlock x:Name="CommitText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <HyperlinkButton x:Name="PullRequestLink"
                                         HorizontalAlignment="Left" Padding="0,4"
                                         AutomationProperties.Name="Pull request (opens in browser)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Pull request" />
                                <FontIcon Style="{StaticResource ExternalLinkIconStyle}" />
                            </StackPanel>
                        </HyperlinkButton>
                        <HyperlinkButton x:Name="BuildLink"
                                         HorizontalAlignment="Left" Padding="0,4"
                                         AutomationProperties.Name="Build run (opens in browser)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Build run" />
                                <FontIcon Style="{StaticResource ExternalLinkIconStyle}" />
                            </StackPanel>
                        </HyperlinkButton>
                        <HyperlinkButton Padding="0,4"
                                         NavigateUri="https://github.com/iricigor/fingvibe"
                                         AutomationProperties.Name="GitHub repository (opens in browser)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="GitHub repository" />
                                <FontIcon Style="{StaticResource ExternalLinkIconStyle}" />
                            </StackPanel>
                        </HyperlinkButton>
                        <HyperlinkButton Padding="0,4"
                                         NavigateUri="https://igor.iric.online"
                                         AutomationProperties.Name="Creator's website (opens in browser)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Creator's website" />
                                <FontIcon Style="{StaticResource ExternalLinkIconStyle}" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="8">
                    <Border Style="{StaticResource CardHeadingBandStyle}">
                        <Grid Style="{StaticResource CardHeadingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE895;" Style="{StaticResource CardHeadingIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Updates" Style="{StaticResource CardHeadingTextStyle}" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="UpdateInstalledVersion" TextWrapping="Wrap" />
                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="UpdateLastChecked" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="UpdateInstallOutcome" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <TextBlock x:Name="UpdateScheduledStatus" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <TextBlock x:Name="UpdateSecurityWarning" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="Windows may still ask for confirmation. SmartScreen, Defender, UAC or organization policy is not bypassed."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click"
                            HorizontalAlignment="Left" />
                    <HyperlinkButton x:Name="UpdateReleaseLink"
                                     NavigateUri="https://github.com/iricigor/fingvibe/releases/latest"
                                     HorizontalAlignment="Left" Padding="0,4"
                                     AutomationProperties.Name="Stable releases (opens in browser)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Stable releases" />
                            <FontIcon Style="{StaticResource ExternalLinkIconStyle}" />
                        </StackPanel>
                    </HyperlinkButton>
                    <Button x:Name="DownloadUpdateButton" Click="DownloadUpdate_Click" Visibility="Collapsed"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Download update" TextWrapping="Wrap" />
                    </Button>
                    <ProgressBar x:Name="UpdateDownloadProgress" Minimum="0" Maximum="100"
                                 Visibility="Collapsed" AutomationProperties.Name="Update download progress" />
                    <TextBlock x:Name="UpdateDownloadStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="CancelUpdateDownloadButton" Content="Cancel download" Click="CancelDownload_Click"
                            Visibility="Collapsed" HorizontalAlignment="Left" />
                    <Button x:Name="InstallUpdateButton" Content="Update now" Click="InstallUpdate_Click"
                            Visibility="Collapsed" HorizontalAlignment="Left" />
                    <Button x:Name="CancelScheduledUpdateButton" Content="Cancel scheduled update"
                            Click="CancelScheduledUpdate_Click" Visibility="Collapsed"
                            AutomationProperties.Name="Cancel scheduled update" HorizontalAlignment="Left" />
                    <!-- Untrusted release text renders only as plain TextBlocks; links open only from explicit GitHub buttons. -->
                    <Expander x:Name="ReleaseNotesExpander" IsExpanded="False" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                        <Expander.Header>
                            <TextBlock x:Name="ReleaseNotesHeader" TextWrapping="Wrap" />
                        </Expander.Header>
                        <StackPanel Spacing="6">
                            <StackPanel x:Name="ReleaseNotesContent" Spacing="6" />
                            <HyperlinkButton x:Name="ReleaseNotesFullLink" Padding="0,4" Visibility="Collapsed"
                                             AutomationProperties.Name="View full notes on GitHub (opens in browser)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="View full notes on GitHub" TextWrapping="Wrap" />
                                    <FontIcon Style="{StaticResource ExternalLinkIconStyle}" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </Expander>
                    <HyperlinkButton x:Name="ReleaseNotesFallbackLink" Padding="0,4" Visibility="Collapsed"
                                     HorizontalAlignment="Left"
                                     AutomationProperties.Name="View release notes on GitHub (opens in browser)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="View release notes on GitHub" TextWrapping="Wrap" />
                            <FontIcon Style="{StaticResource ExternalLinkIconStyle}" />
                        </StackPanel>
                    </HyperlinkButton>
                    <Expander x:Name="UpdateDetailsExpander" Header="Update details"
                              IsExpanded="False" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="UpdateDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="UpdateDeploymentText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
