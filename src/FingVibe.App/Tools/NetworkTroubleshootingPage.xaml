<UserControl
    x:Class="FingVibe.App.NetworkTroubleshootingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="TroubleshootingScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,0,24,24" Spacing="16">
            <Button Content="Back to Tools" Click="BackButton_Click" AutomationProperties.Name="Back to Tools" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE90F;" FontFamily="Segoe Fluent Icons"
                          FontSize="48" Width="48" Height="48"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                          IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Grid.Column="1" Text="Network troubleshooting" Style="{StaticResource ScannerPageTitleStyle}" Margin="0"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Connection and checks" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" MaxWidth="560" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AdapterPicker" Header="LAN adapter context" HorizontalAlignment="Stretch"
                                  SelectionChanged="AdapterPicker_SelectionChanged" AutomationProperties.Name="Troubleshooting LAN adapter" />
                        <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh adapters" Click="RefreshButton_Click" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock x:Name="ContextText" TextWrapping="Wrap" />
                    <TextBlock Text="Windows chooses routes and DNS settings. Selecting an adapter does not bind probes to it; VPNs and multiple adapters can change the path."
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="WanInput" Header="Optional router WAN IPv4 address" MaxWidth="440" HorizontalAlignment="Left"
                             PlaceholderText="Leave blank if unknown" TextChanged="WanInput_TextChanged" AutomationProperties.Name="Router WAN IPv4 address" />
                    <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Expander Header="How to find the router WAN address" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="WanHelp" TextWrapping="Wrap" />
                    </Expander>
                    <Expander Header="What these checks send" HorizontalAlignment="Stretch">
                        <TextBlock Text="On Run, ICMP probes go to local checkpoints and both public IPs, a trace goes toward 1.1.1.1, and DNS queries for example.com use Windows DNS and UDP port 53 on Cloudflare and Google. Providers see your public source IP and query. No router credentials or new public-IP lookup are requested."
                                   TextWrapping="Wrap" FontSize="12" />
                    </Expander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Network path and status" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RunButton" Content="Run checks" Click="RunButton_Click" AutomationProperties.Name="Run network troubleshooting" />
                        <Button x:Name="CancelRunButton" Content="Cancel" IsEnabled="False" Click="CancelButton_Click" AutomationProperties.Name="Cancel network troubleshooting" />
                        <ProgressRing x:Name="RunProgress" IsActive="False" Width="24" Height="24" />
                    </StackPanel>
                    <TextBlock x:Name="ProgressText" Text="Ready. No checks have run." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="Illustrative network diagram - logical checkpoints, not discovered physical topology" TextWrapping="Wrap" />
                    <ScrollViewer x:Name="DiagramScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Canvas Width="1170" Height="270" Margin="8">
                            <Canvas.Resources>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                    <Setter Property="StrokeStartLineCap" Value="Round" />
                                    <Setter Property="StrokeEndLineCap" Value="Round" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </Style>
                            </Canvas.Resources>
                            <Path x:Name="PcRouterConnector" Data="M165,198 H355" />
                            <Path x:Name="RouterHopConnector" Data="M435,198 H625" />
                            <Path x:Name="HopInternetConnector" Data="M687,198 H825" />
                            <Path x:Name="InternetGoogleConnector" Data="M865,198 H985" />
                            <Path Data="M885,198 V138 Q885,130 893,130 H984 Q992,130 992,122 V55" />
                            <Path Data="M330,61 V74 Q330,82 338,82 H387 Q395,82 395,90 V178" Opacity="0.65" />
                            <Path Data="M286,61 V74 Q286,82 294,82 H330" Opacity="0.65" />
                            <Path Data="M374,61 V74 Q374,82 366,82 H330" Opacity="0.65" />
                            <StackPanel Canvas.Left="205" Canvas.Top="8" Width="250" Opacity="0.65">
                                <TextBlock Text="LAN peers: computers / phone / printer" TextAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24" Margin="0,8">
                                    <FontIcon Glyph="&#xE7F4;" /><FontIcon Glyph="&#xE8EA;" /><FontIcon Glyph="&#xE749;" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="PcNode" Canvas.Left="0" Canvas.Top="150" Width="250" />
                            <StackPanel x:Name="RouterNode" Canvas.Left="270" Canvas.Top="150" Width="250" />
                            <StackPanel x:Name="HopNode" Canvas.Left="540" Canvas.Top="150" Width="250" />
                            <StackPanel Canvas.Left="810" Canvas.Top="178" Width="70" Spacing="8">
                                <FontIcon Glyph="&#xE774;" FontSize="40" /><TextBlock Text="Internet" TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel x:Name="CloudflareNode" Canvas.Left="900" Canvas.Top="0" Width="250" />
                            <StackPanel x:Name="GoogleNode" Canvas.Left="900" Canvas.Top="150" Width="250" />
                        </Canvas>
                    </ScrollViewer>
                    <StackPanel Spacing="0" AutomationProperties.Name="Network status summary">
                        <Border x:Name="SummaryBanner" Padding="12" CornerRadius="4,4,0,0">
                            <TextBlock x:Name="SummaryTitle" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12" CornerRadius="0,0,4,4">
                            <TextBlock x:Name="SummaryExplanation" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <Expander Header="How to interpret the network path" HorizontalAlignment="Stretch">
                        <TextBlock Text="Loopback and self-ping do not verify the cable or Wi-Fi. Hop 2 is only an observed responder, not necessarily the router's configured upstream gateway. An unanswered intermediate hop is not evidence of failure if later hops respond. Optional WAN probes can fail while internet access works. Public egress IP is not router WAN IP: double NAT, carrier-grade NAT, or VPN/proxy routing can make them differ."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Expander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Detailed checkpoint diagnostics" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <StackPanel x:Name="DiagnosticsPanel" Spacing="6" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Traceroute" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Expander Header="Traceroute details toward 1.1.1.1" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="TraceStatus" Text="Not run." TextWrapping="Wrap" />
                            <StackPanel x:Name="TracePanel" Spacing="6" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
