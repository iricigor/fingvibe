<UserControl
    x:Class="FingVibe.App.NetworkHealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <ScrollViewer x:Name="NetworkHealthScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource ScannerPageContentMargin}" Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="&#x2190; Tools" Click="BackButton_Click"
                        MinWidth="{Binding ReferenceWidth, Source={StaticResource PageHeaderSizing}}"
                        MinHeight="{Binding ReferenceHeight, Source={StaticResource PageHeaderSizing}}"
                        AutomationProperties.Name="Back to Tools" Style="{StaticResource PageBackButtonStyle}" />
                <local:PageHeaderIcon Grid.Column="1" Icon="troubleshooting" />
                <TextBlock Grid.Column="2" Text="Network health" Style="{StaticResource ScannerPageTitleStyle}" Margin="0"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <Border x:Name="CurrentHealthCard" Style="{StaticResource ScannerSummaryCardStyle}"
                    AutomationProperties.AutomationId="NetworkHealthCurrent" AutomationProperties.Name="Current network health">
                <Grid x:Name="CurrentHealthLayout" ColumnSpacing="24" RowSpacing="12" SizeChanged="CurrentHealthLayout_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="HealthStateDot" Width="10" Height="10" StrokeThickness="1.5" VerticalAlignment="Center"
                                     Style="{StaticResource NetworkMonitorDotOffStyle}"
                                     IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="HealthStateText" Grid.Column="1" Text="Monitoring off" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap" AutomationProperties.AutomationId="NetworkHealthState" />
                        </Grid>
                        <TextBlock x:Name="HealthStateDetailText" Text="Background health checks are not running, so there is no current health result. This is not a healthy state."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.AutomationId="NetworkHealthStateDetail" />
                        <TextBlock x:Name="LastCheckText" Text="No raw check has completed yet." TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="NetworkHealthLastCheck" />
                        <StackPanel x:Name="RawObservationsPanel" Spacing="4" Visibility="Collapsed"
                                    AutomationProperties.AutomationId="NetworkHealthRawObservations"
                                    AutomationProperties.Name="Latest raw monitoring observations">
                            <TextBlock Text="Latest raw observations - not a health verdict" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel x:Name="RawObservationRows" Spacing="2" />
                        </StackPanel>
                        <TextBlock x:Name="ContextText" TextWrapping="Wrap" />
                        <TextBlock Text="Windows chooses routes and DNS settings. Selecting an adapter does not bind probes to it; VPNs and multiple adapters can change the path."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="RunControls" Grid.Column="1" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RunButton" Content="Run diagnostics" Click="RunButton_Click"
                                    Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Run network diagnostics" />
                            <Button x:Name="CancelRunButton" Content="Cancel" IsEnabled="False" Click="CancelButton_Click" AutomationProperties.Name="Cancel network diagnostics" />
                            <ProgressRing x:Name="RunProgress" IsActive="False" Width="24" Height="24" />
                        </StackPanel>
                        <TextBlock Text="Manual run of the checks below, using Connection and checks settings." TextWrapping="Wrap" MaxWidth="320"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="ProgressText" Grid.Row="1" Grid.ColumnSpan="2" Text="Ready. No checks have run."
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </Border>
            <Border x:Name="ServiceStatusEntryCard" Style="{StaticResource ScannerSummaryCardStyle}"
                    AutomationProperties.AutomationId="ServiceStatusEntry">
                <Grid x:Name="ServiceStatusEntryLayout" ColumnSpacing="16" RowSpacing="12" SizeChanged="ServiceStatusEntryLayout_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:PageHeaderIcon Icon="network" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Service status" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="Consumer and infrastructure services from 6 providers" TextWrapping="Wrap" />
                        <TextBlock Text="Provider reports are separate from this network's measured health."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="OpenServiceStatusButton" Grid.Column="2" Content="Open service status" VerticalAlignment="Center"
                            Click="OpenServiceStatusButton_Click" Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="OpenServiceStatusButton" AutomationProperties.Name="Open service status" />
                </Grid>
            </Border>
            <StackPanel Spacing="4">
                <TextBlock Text="Manual diagnostics" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="Results from the latest Run diagnostics on this page. Opening or viewing this page sends no probes."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Network path and status" Style="{ThemeResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="View room map"
                                AutomationProperties.AutomationId="NetworkHealthViewRoomMapButton"
                                AutomationProperties.Name="View room map"
                                Click="RoomMapButton_Click" />
                    </Grid>
                    <TextBlock x:Name="DiagramPlaybackText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Logical checks—not a physical network map." TextWrapping="Wrap"
                               ToolTipService.ToolTip="Motion illustrates diagnostic checks, not actual packets or timing."
                               AutomationProperties.HelpText="Motion illustrates diagnostic checks, not actual packets or timing." />
                    <ScrollViewer x:Name="DiagramScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Canvas x:Name="DiagramCanvas" Width="1170" Height="270" Margin="8">
                            <Canvas.Resources>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                    <Setter Property="StrokeStartLineCap" Value="Round" />
                                    <Setter Property="StrokeEndLineCap" Value="Round" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </Style>
                            </Canvas.Resources>
                            <Path x:Name="PcRouterConnector" Data="M165,198 H355" />
                            <Path x:Name="RouterHopConnector" Data="M435,198 H625" />
                            <Path x:Name="HopInternetConnector" Data="M687,198 H825" />
                            <Path x:Name="InternetGoogleConnector" Data="M865,198 H985" />
                            <Path Data="M885,198 V138 Q885,130 893,130 H984 Q992,130 992,122 V55" />
                            <Path x:Name="RouterPeerConnector" Data="M395,178 V87 M395,73 V68" />
                            <Path x:Name="DecorativePeerConnector" Data="M395,120 H226 Q218,120 218,112 V56" Opacity="0.5" />
                            <Path Data="M250,56 V120 M282,56 V120" Opacity="0.5" />
                            <StackPanel x:Name="LanPeers" Canvas.Left="190" Canvas.Top="12" Width="120" Opacity="0.5"
                                        IsHitTestVisible="False">
                                <TextBlock Text="LAN peers" FontSize="12" TextAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,6">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" /><FontIcon Glyph="&#xE8EA;" FontSize="16" /><FontIcon Glyph="&#xE749;" FontSize="16" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="SelectedPeerNode" Canvas.Left="315" Canvas.Top="12" Width="160" Spacing="8"
                                        SizeChanged="SelectedPeerNode_SizeChanged">
                                <TextBlock Text="Selected peer" FontSize="12" TextAlignment="Center"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <FontIcon x:Name="SelectedPeerIcon" Glyph="&#xE7F4;" FontSize="32"
                                          IsTextScaleFactorEnabled="False" AutomationProperties.AccessibilityView="Raw" />
                            </StackPanel>
                            <StackPanel x:Name="PeerCheckpoint" Canvas.Left="388" Canvas.Top="70"
                                        Orientation="Horizontal" />
                            <StackPanel x:Name="PcNode" Canvas.Left="0" Canvas.Top="150" Width="250" />
                            <StackPanel x:Name="RouterNode" Canvas.Left="270" Canvas.Top="150" Width="250" />
                            <StackPanel x:Name="HopNode" Canvas.Left="540" Canvas.Top="150" Width="250" />
                            <StackPanel Canvas.Left="810" Canvas.Top="178" Width="70" Spacing="8">
                                <FontIcon Glyph="&#xE774;" FontSize="40" /><TextBlock Text="Internet" TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel x:Name="CloudflareNode" Canvas.Left="900" Canvas.Top="0" Width="250" />
                            <StackPanel x:Name="GoogleNode" Canvas.Left="900" Canvas.Top="150" Width="250" />
                            <Ellipse x:Name="DiagramDot" Width="8" Height="8" Visibility="Collapsed"
                                     IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <Ellipse x:Name="DiagramDot2" Width="8" Height="8" Visibility="Collapsed"
                                     IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <Ellipse x:Name="DiagramDot3" Width="8" Height="8" Visibility="Collapsed"
                                     IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <Ellipse x:Name="DiagramPulse" StrokeThickness="2" Visibility="Collapsed"
                                     IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <Ellipse x:Name="DiagramPulse2" StrokeThickness="2" Visibility="Collapsed"
                                     IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <Ellipse x:Name="DiagramPulse3" StrokeThickness="2" Visibility="Collapsed"
                                     IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                        </Canvas>
                    </ScrollViewer>
                    <StackPanel Spacing="0" AutomationProperties.Name="Network status summary">
                        <Border x:Name="SummaryBanner" Padding="12" CornerRadius="4,4,0,0">
                            <TextBlock x:Name="SummaryTitle" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12" CornerRadius="0,0,4,4">
                            <TextBlock x:Name="SummaryExplanation" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <Expander Header="How to interpret the network path" HorizontalAlignment="Stretch">
                        <TextBlock Text="Loopback and self-ping do not verify the cable or Wi-Fi. Hop 2 is only an observed responder, not necessarily the router's configured upstream gateway. An unanswered intermediate hop is not evidence of failure if later hops respond. Optional WAN probes can fail while internet access works. Public egress IP is not router WAN IP: double NAT, carrier-grade NAT, or VPN/proxy routing can make them differ."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Expander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Detailed checkpoint diagnostics" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <StackPanel x:Name="DiagnosticsPanel" Spacing="6" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Traceroute" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Expander Header="Traceroute details toward 1.1.1.1" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="TraceStatus" Text="Not run." TextWrapping="Wrap" />
                            <StackPanel x:Name="TracePanel" Spacing="6" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ScannerSummaryCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Connection and checks" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" MaxWidth="560" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AdapterPicker" Header="LAN adapter context" HorizontalAlignment="Stretch"
                                  SelectionChanged="AdapterPicker_SelectionChanged" AutomationProperties.Name="Diagnostics LAN adapter" />
                        <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh adapters" Click="RefreshButton_Click" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBox x:Name="WanInput" Header="Optional router WAN IPv4 address" MaxWidth="440" HorizontalAlignment="Left"
                             PlaceholderText="Leave blank if unknown" TextChanged="WanInput_TextChanged" AutomationProperties.Name="Router WAN IPv4 address" />
                    <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Expander Header="How to find the router WAN address" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="WanHelp" TextWrapping="Wrap" />
                    </Expander>
                    <Expander Header="What these checks send" HorizontalAlignment="Stretch">
                        <TextBlock Text="On Run diagnostics, ICMP probes go to local checkpoints, one random online LAN peer when available, and both public IPs, a trace goes toward 1.1.1.1, and DNS queries for example.com use Windows DNS and UDP port 53 on Cloudflare and Google. Providers see your public source IP and query. No extra LAN discovery scan, router credentials or new public-IP lookup are requested."
                                   TextWrapping="Wrap" FontSize="12" />
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
