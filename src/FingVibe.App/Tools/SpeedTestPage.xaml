<UserControl
    x:Class="FingVibe.App.SpeedTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,24" Spacing="16">
                <Button Content="Back to Tools"
                        Click="BackButton_Click"
                        AutomationProperties.Name="Back to Tools"
                        HorizontalAlignment="Left" />
                <TextBlock Text="Speed test" Style="{StaticResource ScannerPageTitleStyle}" Margin="0" />
                <TextBlock Text="Measure this PC's internet connection using Cloudflare. Windows chooses the internet route; the LAN scanner's selected adapter is not used."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Style="{StaticResource ScannerSummaryCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Measurement provider" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Cloudflare" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Cloudflare's official speed-test engine measures download, upload, and HTTP latency."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Before each run, FingVibe explains data use and Cloudflare result reporting and asks for your confirmation."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Spacing="8">
                    <TextBlock x:Name="StatusText"
                               Text="Ready. Select Start test when you are ready."
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="TestProgress"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Height="5"
                                 AutomationProperties.Name="Cloudflare speed test progress" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="StartTestButton"
                            Content="Start test"
                            Click="StartTestButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.Name="Start Cloudflare speed test" />
                    <Button x:Name="CancelTestButton"
                            Content="Cancel"
                            Click="CancelTestButton_Click"
                            IsEnabled="False"
                            AutomationProperties.Name="Cancel Cloudflare speed test" />
                </StackPanel>
                <Border x:Name="LiveGaugeCard"
                        Style="{StaticResource ScannerSummaryCardStyle}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock x:Name="GaugePhaseText" Text="Waiting for measurements"
                                   HorizontalAlignment="Center" />
                        <Grid Width="240" Height="140" AutomationProperties.AccessibilityView="Raw">
                            <Path Data="M 20,120 A 100,100 0 0 1 220,120"
                                  Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                  StrokeThickness="8" />
                            <Line X1="120" Y1="120" X2="120" Y2="28"
                                  Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  StrokeThickness="4">
                                <Line.RenderTransform>
                                    <RotateTransform x:Name="GaugeNeedle" CenterX="120" CenterY="120" Angle="-90" />
                                </Line.RenderTransform>
                            </Line>
                            <Ellipse Width="12" Height="12" Margin="0,114,0,0"
                                     HorizontalAlignment="Center" VerticalAlignment="Top"
                                     Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="GaugeValueText" Text="-- Mbps"
                                   FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   AutomationProperties.Name="Provisional Cloudflare speed" />
                        <TextBlock x:Name="GaugeScaleText" Text="Scale: 0-100 Mbps"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Provisional estimate; updates after measurements, not continuously."
                                   TextWrapping="Wrap" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="ResultsCard"
                        Style="{StaticResource ScannerSummaryCardStyle}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Results" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Download" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="DownloadResultText"
                                           Text="—"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="Download speed" />
                                <TextBlock Text="Mbps" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Upload" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="UploadResultText"
                                           Text="—"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="Upload speed" />
                                <TextBlock Text="Mbps" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Text="HTTP latency" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="LatencyResultText"
                                           Text="—"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="HTTP latency" />
                                <TextBlock Text="ms" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LocationResultText"
                                   Text="Serving location: Not provided by the Cloudflare engine."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <WebView2 x:Name="EngineWebView"
                  Width="1"
                  Height="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Opacity="0"
                  IsHitTestVisible="False"
                  AutomationProperties.AccessibilityView="Raw" />
    </Grid>
</UserControl>
