<UserControl
    x:Class="FingVibe.App.SpeedTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,24" Spacing="16">
                <Button Content="Back to Tools"
                        Click="BackButton_Click"
                        AutomationProperties.Name="Back to Tools"
                        HorizontalAlignment="Left" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEC4A;" FontFamily="Segoe Fluent Icons"
                              FontSize="48" Width="48" Height="48"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                              IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Grid.Column="1" Text="Speed test" Style="{StaticResource ScannerPageTitleStyle}" Margin="0"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="Measure this PC's internet connection using Cloudflare. Windows chooses the internet route; the LAN scanner's selected adapter is not used."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Style="{StaticResource ScannerSummaryCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Measurement provider" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Cloudflare" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Cloudflare's official speed-test engine measures download, upload, and HTTP latency."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Before each run, FingVibe explains data use and Cloudflare result reporting and asks for your confirmation."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Spacing="8">
                    <TextBlock x:Name="StatusText"
                               Text="Ready. Select Start test when you are ready."
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="TestProgress"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Height="5"
                                 AutomationProperties.Name="Cloudflare speed test progress" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="StartTestButton"
                            Content="Start test"
                            Click="StartTestButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.Name="Start Cloudflare speed test" />
                    <Button x:Name="CancelTestButton"
                            Content="Cancel"
                            Click="CancelTestButton_Click"
                            IsEnabled="False"
                            AutomationProperties.Name="Cancel Cloudflare speed test" />
                </StackPanel>
                <Grid x:Name="LiveGauges" ColumnSpacing="16" RowSpacing="16" SizeChanged="LiveGauges_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:SpeedGauge x:Name="DownloadGauge" Direction="Download" />
                    <local:SpeedGauge x:Name="UploadGauge" Direction="Upload" Grid.Column="1" />
                </Grid>
                <TextBlock Text="Provisional estimates update after measurements, not continuously. Needles retain the latest estimate between rounds; final results appear separately."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border x:Name="ResultsCard"
                        Style="{StaticResource ScannerSummaryCardStyle}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Results" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Download" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="DownloadResultText"
                                           Text="—"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="Download speed" />
                                <TextBlock Text="Mbps" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Upload" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="UploadResultText"
                                           Text="—"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="Upload speed" />
                                <TextBlock Text="Mbps" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Text="HTTP latency" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="LatencyResultText"
                                           Text="—"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="HTTP latency" />
                                <TextBlock Text="ms" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LocationResultText"
                                   Text="Serving location: Not provided by the Cloudflare engine."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <WebView2 x:Name="EngineWebView"
                  Width="1"
                  Height="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Opacity="0"
                  IsHitTestVisible="False"
                  AutomationProperties.AccessibilityView="Raw" />
    </Grid>
</UserControl>
