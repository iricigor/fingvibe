<UserControl
    x:Class="FingVibe.App.SpeedTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <Grid Margin="{StaticResource ScannerPageContentMargin}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="&#x2190; Tools" Click="BackButton_Click"
                    MinWidth="{Binding ReferenceWidth, Source={StaticResource PageHeaderSizing}}"
                    MinHeight="{Binding ReferenceHeight, Source={StaticResource PageHeaderSizing}}"
                    AutomationProperties.Name="Back to Tools" Style="{StaticResource PageBackButtonStyle}" />
            <local:PageHeaderIcon Grid.Column="1" Icon="speed-test" />
            <TextBlock Grid.Column="2" Text="Speed test" Style="{StaticResource ScannerPageTitleStyle}" Margin="0"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
        <ScrollViewer x:Name="SpeedTestScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <Border x:Name="TestCard" Style="{StaticResource ScannerSummaryCardStyle}">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource CardHeadingBandStyle}">
                            <Grid Style="{StaticResource CardHeadingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE768;" Style="{StaticResource CardHeadingIconStyle}" />
                                <TextBlock Grid.Column="1" Text="Test" Style="{StaticResource CardHeadingTextStyle}" />
                            </Grid>
                        </Border>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Measurement provider" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Cloudflare" FontWeight="SemiBold" />
                            <TextBlock Text="Cloudflare's official speed-test engine measures download, upload, and HTTP latency."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="Measure this PC's internet connection using Cloudflare. Windows chooses the internet route; the LAN scanner's selected adapter is not used."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Before each run, FingVibe explains data use and Cloudflare result reporting and asks for your confirmation."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="StatusText"
                                       Text="Ready. Select Start test when you are ready."
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <ProgressBar x:Name="TestProgress"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed"
                                         Height="5"
                                         AutomationProperties.Name="Cloudflare speed test progress" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartTestButton"
                                    Content="Start test"
                                    Click="StartTestButton_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    AutomationProperties.Name="Start Cloudflare speed test" />
                            <Button x:Name="CancelTestButton"
                                    Content="Cancel"
                                    Click="CancelTestButton_Click"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Cancel Cloudflare speed test" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="LiveMeasurementCard" Style="{StaticResource ScannerSummaryCardStyle}">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource CardHeadingBandStyle}">
                            <Grid Style="{StaticResource CardHeadingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEC4A;" Style="{StaticResource CardHeadingIconStyle}" />
                                <TextBlock Grid.Column="1" Text="Live measurement" Style="{StaticResource CardHeadingTextStyle}" />
                            </Grid>
                        </Border>
                        <Grid x:Name="LiveGauges" ColumnSpacing="16" RowSpacing="24" SizeChanged="LiveGauges_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <local:SpeedGauge x:Name="DownloadGauge" Direction="Download" />
                            <local:SpeedGauge x:Name="UploadGauge" Direction="Upload" Grid.Column="1" />
                        </Grid>
                        <TextBlock Text="Provisional estimates update after measurements, not continuously. Needles retain the latest estimate between rounds; final results appear separately."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="ResultsCard"
                        Style="{StaticResource ScannerSummaryCardStyle}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource CardHeadingBandStyle}">
                            <Grid Style="{StaticResource CardHeadingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE73E;" Style="{StaticResource CardHeadingIconStyle}" />
                                <TextBlock Grid.Column="1" Text="Results" Style="{StaticResource CardHeadingTextStyle}" />
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Download" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="DownloadResultText"
                                               Text="—"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               AutomationProperties.Name="Download speed" />
                                    <TextBlock x:Name="DownloadRatingText"
                                               Visibility="Collapsed"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,3"
                                               AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>
                                <TextBlock Text="Mbps" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Upload" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="UploadResultText"
                                               Text="—"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               AutomationProperties.Name="Upload speed" />
                                    <TextBlock x:Name="UploadRatingText"
                                               Visibility="Collapsed"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,3"
                                               AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>
                                <TextBlock Text="Mbps" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Text="HTTP latency" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="LatencyResultText"
                                           Text="—"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="HTTP latency" />
                                <TextBlock Text="ms" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LocationResultText"
                                   Text="Serving location: Not provided by the Cloudflare engine."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <WebView2 x:Name="EngineWebView"
                  Width="1"
                  Height="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Opacity="0"
                  IsHitTestVisible="False"
                  AutomationProperties.AccessibilityView="Raw" />
    </Grid>
</UserControl>
