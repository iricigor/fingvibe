<UserControl
    x:Class="FingVibe.App.SpeedGauge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <FontIcon x:Name="DirectionIcon" Glyph="&#xE896;" FontSize="18"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="TitleText" Text="Download" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock x:Name="StateText" Text="Waiting for measurements" HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Viewbox MaxWidth="300" Stretch="Uniform">
            <Canvas Width="260" Height="165" AutomationProperties.AccessibilityView="Raw">
                <Path x:Name="ArcPath" Data="M 30,135 A 100,100 0 0 1 230,135"
                      StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Stroke>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="30,0" EndPoint="230,0">
                            <GradientStop Offset="0" Color="{ThemeResource SpeedGaugeSlowColor}" />
                            <GradientStop x:Name="SlowStop" Offset="0.2" Color="{ThemeResource SpeedGaugeSlowColor}" />
                            <GradientStop x:Name="FairStop" Offset="0.4" Color="{ThemeResource SpeedGaugeFairColor}" />
                            <GradientStop x:Name="GoodStop" Offset="0.6" Color="{ThemeResource SpeedGaugeGoodColor}" />
                            <GradientStop Offset="1" Color="{ThemeResource SpeedGaugeGoodColor}" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
                <!-- Major marks at 1 Mbps, 10, 100, 1 Gbps and 10 Gbps; minor marks at 2 and 5 within each x10 step. -->
                <Path Data="M 42.0,135.0 L 56.0,135.0 M 67.8,72.8 L 77.7,82.7 M 130.0,47.0 L 130.0,61.0 M 192.2,72.8 L 182.3,82.7 M 218.0,135.0 L 204.0,135.0"
                      Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
                <Path Data="M 44.4,114.4 L 51.3,116.0 M 54.9,89.1 L 60.9,92.7 M 84.1,59.9 L 87.7,65.9 M 109.4,49.4 L 111.0,56.3 M 150.6,49.4 L 149.0,56.3 M 175.9,59.9 L 172.3,65.9 M 205.1,89.1 L 199.1,92.7 M 215.6,114.4 L 208.7,116.0"
                      Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
                <Line X1="130" Y1="135" X2="130" Y2="58"
                      Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                      StrokeThickness="4" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="Needle" CenterX="130" CenterY="135" Angle="-90" />
                    </Line.RenderTransform>
                </Line>
                <Ellipse Width="18" Height="18" Canvas.Left="121" Canvas.Top="126"
                         Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                <!-- The Viewbox scales the dial as a whole; the scale caption below carries the same labels with text scaling. -->
                <TextBlock Text="1 Mbps" Canvas.Left="0" Canvas.Top="144" Width="60" TextAlignment="Center"
                           FontSize="11" IsTextScaleFactorEnabled="False" />
                <TextBlock Text="10" Canvas.Left="14" Canvas.Top="41" Width="60" TextAlignment="Center"
                           FontSize="11" IsTextScaleFactorEnabled="False" />
                <TextBlock Text="100" Canvas.Left="100" Canvas.Top="6" Width="60" TextAlignment="Center"
                           FontSize="11" IsTextScaleFactorEnabled="False" />
                <TextBlock Text="1 Gbps" Canvas.Left="186" Canvas.Top="41" Width="60" TextAlignment="Center"
                           FontSize="11" IsTextScaleFactorEnabled="False" />
                <TextBlock Text="10 Gbps" Canvas.Left="200" Canvas.Top="144" Width="60" TextAlignment="Center"
                           FontSize="11" IsTextScaleFactorEnabled="False" />
            </Canvas>
        </Viewbox>
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <TextBlock x:Name="ValueText" Text="--" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Mbps" VerticalAlignment="Bottom" Margin="0,0,0,5"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="RatingText" Visibility="Collapsed" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Bottom" Margin="4,0,0,4"
                       AutomationProperties.AccessibilityView="Raw" />
        </StackPanel>
        <TextBlock x:Name="ScaleCaption" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
