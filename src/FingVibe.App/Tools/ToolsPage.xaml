<UserControl
    x:Class="FingVibe.App.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <Grid>
        <ScrollViewer x:Name="ToolsLanding" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ToolsLandingGrid" Margin="{StaticResource ScannerPageContentMargin}"
                  RowSpacing="16" ColumnSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.ColumnSpan="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:PageHeaderIcon Icon="tools" />
                    <TextBlock Grid.Column="1" Text="Tools" Style="{StaticResource ScannerPageTitleStyle}"
                               Margin="0" VerticalAlignment="Center" />
                </Grid>
                <Button x:Name="SqlEditorCard" Click="SqlEditorCard_Click"
                        Style="{StaticResource ScannerSummaryButtonStyle}" AutomationProperties.Name="SQL editor">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:PageHeaderIcon Icon="tools" />
                            <TextBlock Grid.Column="1" Text="SQL editor" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Explore saved inventory and scan history with read-only SQL."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Open SQL editor &#x2192;" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button x:Name="FingImportCard" Click="FingImportCard_Click"
                        Style="{StaticResource ScannerSummaryButtonStyle}" AutomationProperties.Name="Import from Fing">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:PageHeaderIcon Icon="import" />
                            <TextBlock Grid.Column="1" Text="Import from Fing" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Review and import device names, details, and assignments from a Fing Excel export."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Open Import from Fing &#x2192;" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button x:Name="SpeedTestCard"
                        Click="SpeedTestCard_Click"
                        Style="{StaticResource ScannerSummaryButtonStyle}"
                        AutomationProperties.Name="Speed test">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:PageHeaderIcon Icon="speed-test" />
                            <TextBlock Grid.Column="1" Text="Speed test" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Measure this PC's internet connection with Cloudflare."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Open speed test &#x2192;" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button x:Name="RoomMapCard" Click="RoomMapCard_Click"
                        Style="{StaticResource ScannerSummaryButtonStyle}" AutomationProperties.Name="View room map">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:PageHeaderIcon Icon="rooms" />
                            <TextBlock Grid.Column="1" Text="Room map" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="See saved room assignments, device status, and the conceptual gateway layout."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="View room map &#x2192;" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button x:Name="NetworkHealthCard" Click="NetworkHealthCard_Click"
                        Style="{StaticResource ScannerSummaryButtonStyle}" AutomationProperties.Name="Network health">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:PageHeaderIcon Icon="troubleshooting" />
                            <TextBlock Grid.Column="1" Text="Network health" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="See monitoring status and run diagnostics for local addresses, internet IPs, traceroute, and DNS."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Open network health &#x2192;" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button x:Name="DatabaseBackupsCard" Click="DatabaseBackupsCard_Click"
                        Style="{StaticResource ScannerSummaryButtonStyle}" AutomationProperties.Name="Database backups">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:PageHeaderIcon Icon="tools" />
                            <TextBlock Grid.Column="1" Text="Database backups" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="View local backup copies and protect your saved device inventory." TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Open database backups &#x2192;" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </Grid>
        </ScrollViewer>
        <local:SpeedTestPage x:Name="SpeedTestView"
                             Visibility="Collapsed"
                             BackRequested="SpeedTestView_BackRequested" />
        <local:NetworkHealthPage x:Name="NetworkHealthView" Visibility="Collapsed"
                                 BackRequested="NetworkHealthView_BackRequested"
                                 RoomMapRequested="NetworkHealthView_RoomMapRequested"
                                 ServiceStatusRequested="NetworkHealthView_ServiceStatusRequested" />
        <local:ServiceStatusPage x:Name="ServiceStatusView" Visibility="Collapsed"
                                 BackRequested="ServiceStatusView_BackRequested" />
        <local:FingImportPage x:Name="FingImportView" Visibility="Collapsed"
                              BackRequested="FingImportView_BackRequested"
                              ManagementRequested="FingImportView_ManagementRequested" />
        <local:SqlEditorPage x:Name="SqlEditorView" Visibility="Collapsed" BackRequested="SqlEditorView_BackRequested" />
        <local:DatabaseBackupsPage x:Name="DatabaseBackupsView" Visibility="Collapsed" BackRequested="DatabaseBackupsView_BackRequested" />
    </Grid>
</UserControl>
