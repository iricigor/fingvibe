<UserControl
    x:Class="FingVibe.App.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <Grid>
        <ScrollViewer x:Name="ToolsLanding" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,24" Spacing="16">
                <TextBlock Text="Tools" Style="{StaticResource ScannerPageTitleStyle}" Margin="0" />
                <Button x:Name="FingImportCard" Click="FingImportCard_Click"
                        Style="{StaticResource ScannerSummaryButtonStyle}" AutomationProperties.Name="Import from Fing">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B5;" FontFamily="Segoe Fluent Icons"
                                      FontSize="48" Width="48" Height="48"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" Text="Import from Fing" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Review and import device names, details, and assignments from a Fing Excel export."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Open Import from Fing &#x2192;" />
                    </StackPanel>
                </Button>
                <Button x:Name="SpeedTestCard"
                        Click="SpeedTestCard_Click"
                        Style="{StaticResource ScannerSummaryButtonStyle}"
                        AutomationProperties.Name="Speed test">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEC4A;" FontFamily="Segoe Fluent Icons"
                                      FontSize="48" Width="48" Height="48"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" Text="Speed test" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Measure this PC's internet connection with Cloudflare."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Open speed test &#x2192;" />
                    </StackPanel>
                </Button>
                <Button x:Name="TroubleshootingCard" Click="TroubleshootingCard_Click"
                        Style="{StaticResource ScannerSummaryButtonStyle}" AutomationProperties.Name="Network troubleshooting">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE90F;" FontFamily="Segoe Fluent Icons"
                                      FontSize="48" Width="48" Height="48"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" Text="Network troubleshooting" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Check local addresses, internet IPs, traceroute, and DNS on request."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Open network troubleshooting &#x2192;" />
                    </StackPanel>
                </Button>
                <Button x:Name="AboutCard"
                        Click="AboutCard_Click"
                        Style="{StaticResource ScannerSummaryButtonStyle}"
                        AutomationProperties.Name="About FingVibe">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons"
                                      FontSize="48" Width="48" Height="48"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" Text="About FingVibe" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="App version, build details, and creator information."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Open About FingVibe &#x2192;" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
        <local:SpeedTestPage x:Name="SpeedTestView"
                             Visibility="Collapsed"
                             BackRequested="SpeedTestView_BackRequested" />
        <local:AboutPage x:Name="AboutView" Visibility="Collapsed" BackRequested="AboutView_BackRequested" />
        <local:NetworkTroubleshootingPage x:Name="TroubleshootingView" Visibility="Collapsed"
                                          BackRequested="TroubleshootingView_BackRequested" />
        <local:FingImportPage x:Name="FingImportView" Visibility="Collapsed"
                              BackRequested="FingImportView_BackRequested"
                              ManagementRequested="FingImportView_ManagementRequested" />
    </Grid>
</UserControl>
