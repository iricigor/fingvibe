<UserControl
    x:Class="FingVibe.App.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FingVibe.App">
    <Grid>
        <ScrollViewer x:Name="ToolsLanding" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,24" Spacing="16">
                <TextBlock Text="Tools" Style="{StaticResource ScannerPageTitleStyle}" Margin="0" />
                <Button x:Name="SpeedTestCard"
                        Click="SpeedTestCard_Click"
                        Style="{StaticResource ScannerSummaryButtonStyle}"
                        AutomationProperties.Name="Speed test">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" />
                            <TextBlock Text="Speed test" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Text="Measure this PC's internet connection with Cloudflare."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Open speed test &#x2192;" />
                    </StackPanel>
                </Button>
                <Button x:Name="AboutCard"
                        Click="AboutCard_Click"
                        Style="{StaticResource ScannerSummaryButtonStyle}"
                        AutomationProperties.Name="About FingVibe">
                    <StackPanel Spacing="8">
                        <TextBlock Text="About FingVibe" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="App version, build details, and creator information."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Open About FingVibe &#x2192;" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
        <local:SpeedTestPage x:Name="SpeedTestView"
                             Visibility="Collapsed"
                             BackRequested="SpeedTestView_BackRequested" />
        <local:AboutPage x:Name="AboutView" Visibility="Collapsed" BackRequested="AboutView_BackRequested" />
    </Grid>
</UserControl>
